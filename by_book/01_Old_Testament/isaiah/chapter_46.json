  "sections_count": 204,
  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الله حَامل"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أثقالنا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الله الذي سمح لشعبه بالسبي"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "البابلي"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "يرفعه خلال كورش، معلنًا رعايته لأولاده حاملًا أثقالهم وأتعابهم. لا يوجد أثقل من"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "حياتنا بخطاياها وذاتيتها، لكنه هو يحملها عنا خلال عمله الخلاصي بالصليب."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مقارنة تصويرية رائعة يكشف النبي عن الفارق بين الحياة في المسيح والحياة خارجها؛"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "في المسيح نصير محمولين به كما بأجنحة الروح، خارجه نكون كالوثنيين تحتاج آلهتهم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "من يحمل أثقالها ويحرسها!"
    },
    {
      "section_title": "1. الله حامل أثقالنا",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "1 قَدْ جَثَا بِيلُ، انْحَنَى نَبُو. صَارَتْ تَمَاثِيلُهُمَا عَلَى الْحَيَوَانَاتِ وَالْبَهَائِمِ. مَحْمُولاَتُكُمْ مُحَمَّلَةٌ حِمْلًا لِلْمُعْيِي. 2 قَدِ انْحَنَتْ. جَثَتْ مَعًا. لَمْ تَقْدِرْ أَنْ تُنَجِّيَ الْحِمْلَ، وَهِيَ نَفْسُهَا قَدْ مَضَتْ فِي السَّبْيِ. 3 «اِسْمَعُوا لِي يَا بَيْتَ يَعْقُوبَ وَكُلَّ بَقِيَّةِ بَيْتِ إِسْرَائِيلَ، الْمُحَمَّلِينَ عَلَيَّ مِنَ الْبَطْنِ، الْمَحْمُولِينَ مِنَ الرَّحِمِ. 4 وَإِلَى الشَّيْخُوخَةِ أَنَا هُوَ، وَإِلَى الشَّيْبَةِ أَنَا أَحْمِلُ. قَدْ فَعَلْتُ، وَأَنَا أَرْفَعُ، وَأَنَا أَحْمِلُ وَأُنَجِّي. 5 بِمَنْ تُشَبِّهُونَنِي وَتُسَوُّونَنِي وَتُمَثِّلُونَنِي لِنَتَشَابَهَ؟ 6 «اَلَّذِينَ يُفْرِغُونَ الذَّهَبَ مِنَ الْكِيسِ، وَالْفِضَّةَ بِالْمِيزَانِ يَزِنُونَ. يَسْتَأْجِرُونَ صَائِغًا لِيَصْنَعَهَا إِلهًا، يَخُرُّونَ وَيَسْجُدُونَ! 7 يَرْفَعُونَهُ عَلَى الْكَتِفِ. يَحْمِلُونَهُ وَيَضَعُونَهُ فِي مَكَانِهِ لِيَقِفَ. مِنْ مَوْضِعِهِ لاَ يَبْرَحُ. يَزْعَقُ أَحَدٌ إِلَيْهِ فَلاَ يُجِيبُ. مِنْ شِدَّتِهِ لاَ يُخَلِّصُهُ."
    },
    {
      "section_title": "1. الله حامل أثقالنا",
      "content_type": "شرح",
      "father_name": null,
      "text": "يقارن"
    },
    {
      "section_title": "1. الله حامل أثقالنا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله بين آلهة بابل وبينه، الأولى تحتاج إلى من يحملها، أما هو فحامل حياتنا بكل"
    },
    {
      "section_title": "1. الله حامل أثقالنا",
      "content_type": "شرح",
      "father_name": null,
      "text": "متاعبها، إذ يقول:"
    },
    {
      "section_title": "1. الله حامل أثقالنا",
      "content_type": "شرح",
      "father_name": null,
      "text": "جثا بيلُ انحنى نَبو، صارت تماثيلها على الحيوانات والبهائم؛ محمولاتكم محمّلة"
    },
    {
      "section_title": "1. الله حامل أثقالنا",
      "content_type": "شرح",
      "father_name": null,
      "text": "حملًا للمُعيي. قد انحنت جثت معًا لم تقدر أن تُنجّي الحمل وهي نفسها قد مضت في"
    },
    {
      "section_title": "1. الله حامل أثقالنا",
      "content_type": "شرح",
      "father_name": null,
      "text": "السبي\" [1-2]."
    },
    {
      "section_title": "1. الله حامل أثقالنا",
      "content_type": "شرح",
      "father_name": null,
      "text": "اهتز"
    },
    {
      "section_title": "1. الله حامل أثقالنا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الإلهان الرئيسيان لبابل أمام كورش، سجدا له، فصار المعبودان عبدين، حُملا بكل"
    },
    {
      "section_title": "1. الله حامل أثقالنا",
      "content_type": "شرح",
      "father_name": null,
      "text": "تماثيلهما على الحيوانات بلا قوة، إذ الكل عاجز عن المشي بل وعن الحركة، سُلبت كل"
    },
    {
      "section_title": "1. الله حامل أثقالنا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الجواهر التي تزين التماثيل بواسطة وجاء كورش وأُخذ الكل إلى السبي... فهل يستطيع"
    },
    {
      "section_title": "1. الله حامل أثقالنا",
      "content_type": "شرح",
      "father_name": null,
      "text": "هذان المعبودان أن يُنجيا أحدًا ما داما عاجزين حتى عن خلاص نفسيهما؟!"
    },
    {
      "section_title": "1. الله حامل أثقالنا",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"بيل\": اسم"
    },
    {
      "section_title": "1. الله حامل أثقالنا",
      "content_type": "شرح",
      "father_name": null,
      "text": "أكادي يُقابل الاسم العبري \"بعل\" ويعني \"السيد\"؛ ربما هو بعينه الإله مردوخ (إر50: 2؛ 51: 44)؛ هو إله الشمس وإله الربيع. له شكل رجل عظيم على رأسه تاج وله سبعة قرون ثور،"
    },
    {
      "section_title": "1. الله حامل أثقالنا",
      "content_type": "شرح",
      "father_name": null,
      "text": "يُقدَّم له طعام وشراب بكميات كبيرة كل مساء، وكانوا يعتقدون أنه يأكلها ويشربها"
    },
    {
      "section_title": "1. الله حامل أثقالنا",
      "content_type": "شرح",
      "father_name": null,
      "text": "حتى كشف دانيال النبي للملك عن وجود باب سري في الهيكل خلاله يدخل الكهنة"
    },
    {
      "section_title": "1. الله حامل أثقالنا",
      "content_type": "شرح",
      "father_name": null,
      "text": "بعائلاتهم ليلًا ليأكلوا"
    },
    {
      "section_title": "1. الله حامل أثقالنا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الطعام ويشربون خفية، كما ورد في قصة بيل في تتمة دانيال."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "اسم بابلي معناه \"مذيع\"، إله العلم والمعرفة؛ كانت بورسيبا، قرب بابل،"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "مركز عبادته؛ وكان ملوك بابل يتباركون به، ويحملون اسمه مع أسمائهم الأصلية مثل"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "نبوخذ ناصر ونبوخذ راصر ونبوزرادان ونبو شربان."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "انكشف"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "هذا الإلهان وانفضح عجزهما عن الحركة أو عن حماية زينتهما أمام كورش، أما الله"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "الحيّ فهو مخلص شعبه، يحمل أثقالنا ونحن بعد لم نتشكل في رحم أمهاتنا حتى نبلغ"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "الشيخوخة، إذ يؤكد لنا \"أنا هو... أنا أحمل\" [4]. وكأنه يقول: لديَّ ربوات"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "الملائكة والخليقة السماوية وكثير من الأنبياء والكهنة والخدام... لكنني أضع نفسي"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "بين يديْ شعبي لأحمل بنفسي أتعابهم، وأرفع عنهم خطاياهم، وأسندهم في كل"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "مسئولياتهم... أنا أحملهم بنفسي كما على كتفيّ."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "ما يؤكده الله عبر الأجيال قائلًا: \"هأنذا أسأل عن غنمي وافتقدها... أنا أرعى"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "غنمي وأربضها يقول السيد الرب، وأطلب الضال واسترد المطرود وأجبر الكسير وأعصب"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "الجريح وأبيد السمين والقوي وأرعاها بعدل... أخلص غنمي فلا تكون من بعد غنيمة"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "وأحكم بين شاة وشاة \" (حز 34: 11-22). هكذا يؤكد: \"أنا هو... أنا"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "أحمل\"."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "يكف الله مخلصنا عن دعوتنا إليه لكي يحمل أثقالنا، قائلًا: \"تعالوا إليّ يا جميع المتعبين والثقيلي الأحمال وأنا أريحكم\" (مت 11: 28). لذا قيل عنه: \"لكن أحزاننا حملها\" (إش 53: 4)؛ \"حمل خطية كثيرين\" (إش 53: 12)؛ \"يحملنا إله خلاصنا\" (مز 68: 19)."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "ربنا يسوع كمخلص ليس فقط ليحمل أثقالنا وخطايانا مكفرًا عنها، وإنما ليحملنا نحن"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "فيه، يسبينا بحبه ليرفعنا معه إلى مجده. نزل إلينا ليحملنا فيه فنصعد فيه وبه إلى"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "ملكوته."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "نعود"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "إلى حديثه في سفر إشعياء: \"قد فعلت وأنا أرفع وأنا أحمل وأنجي\""
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "فعلت، أي سمحت بالسبي البابلي لفضح ضعفاتكم."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "وأنا"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "أرفع، أنزع عنكم هذا العار وأدبر تحرركم من السبي."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "وأنا"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "أحمل، أقوم بحمل أتعابكم بنفسي... أنا الإله المحتجب."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "وأنا"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "أنجي، أدخل بكم إلى الحرية وأردكم إلى أرض الموعد، وأخلصكم."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "هو عمل الله المخلص: يفعل، ويرفع، ويحمل، ويخلص. إنه يسمح أن يكشف خطايانا لندرك"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "إننا مأسورون لا في"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "سبي بابل وإنما تحت سبي إبليس وأعماله الشريرة، وهو يرفع إذ"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "ينزع هذا العار عنا بتدبيره الإلهي لخلاصنا؛ وهو يحمل إذ رفع الدين بنفسه عنا ولم"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "يأتمن ملاكًا أو رئيس ملائكة أو نبيًا على خلاصنا؛ وأخيرًا يخلص حيث يحملنا إلى"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "سمواته ويهبنا شركة أمجاده الإلهية."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "يقول"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرسول بولس: \"قُدم مرة لكي يحمل خطايا الكثيرين\""
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "(عب 9: 28)."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "لقد أحنى السيد المسيح ظهره ليحمل"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "خطايا العالم كله، إذ مات عن الجميع، لكنه يُحسب مخلصًا للمؤمنين وحدهم، هؤلاء"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "الذين قبلوا أن يرفع عنهم ثقل خطاياهم، فيُحملوا أبرارًا فيه ويدخل بهم إلى حضن"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "أبيه."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "مات من أجل الكل، هذا من جانبه، فإن هذا الموت كان المقابل ضد هلاك كل البشرية،"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "لكنه لم يحمل خطايا كل الناس لأنهم لم يريدوا."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "حمل موسى"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "(الفصح) لم يحمل في الحال خطايا أحد ما، أما هذا الحمل فحمل خطايا العالم كله،"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "فانه إذ كان العالم في خطر الهلاك أسرع فخلّصه من غضب الله."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "لقد سمعوا أنه"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "يحمل خطايا العالم (يو 1: 36)، وللحال"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "جروا إليه، قائلين: إن كان ممكنًا أن ينزع الاتهامات الموجهة ضدنا فلماذا نتأخر؟"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "هنا يوجد ذاك الذي يُخلص دون تعب من جانبنا."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "قول آبائي",
      "father_name": "القديس يوحنا ذهبي الفم",
      "text": "القديس يوحنا الذهبي الفم"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "إنسان في التاريخ بلغ العظمة التي تؤهله أن يرفع خطية العالم كله، لا"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "أخنوخ ولا إبراهيم"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "ولا إسحق، وإن كان قد قدم نفسه للموت، لكنه حُفظ إذ لم يكن قادرًا على إزالة وسخ"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "الخطية."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "هو هذا الرجل العظيم الذي بموته تموت الخطية؟! هذا لا يمكن أن يكون من البشر..."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "لكن الله اختار الابن، ابن الله الذي فوق الكل، وهو الذي يمكن أن يُقدم عن خطايا"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "الجميع!"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "كان يلزم أن يموت، لأن بغلبته على الموت يقدر أن ينقذ الآخرين الذين هم كقتلى"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "مضطجعين في القبور."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "كسر عبودية الشهوات، ولم تقدر قيود الموت أن تمسكه!"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "قول آبائي",
      "father_name": "القديس أمبروسيوس",
      "text": "القديس أمبروسيوس"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "آلامي بآلامك؛ اشِف جراحاتي بجراحاتك؛ طهر دمي بدمك، وامزج في جسدي رائحة الحياة"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "التي لجسدك المقدس!"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "الشيخ الروحاني"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرب خطايانا بكل ثقلها في جسده لكي يهبنا بره فينا، فصرنا نحن أنفسنا محمولين فيه"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "بروحه القدوس كي يرفعنا إلى سمواته. إنه ذاك الذي سبق فحمل شعبه القديم من أرض"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "العبودية بكل ثقلها ومرارتها ليدخل بهم إلى أرض الموعد، بل وليدخل بهم إليه."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"وأنا حملتكم على أجنحة النسور وجئت بكم إليّ\""
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "(خر 19: 4)؛ \"رأيت كيف حملك الرب إلهك كما"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "يحمل الإنسان ابنه في كل الطريق التي سلكتموها حتى جئتم إلى هذا المكان\""
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "(تث 1: 31)."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "أكد الله حبه الفائق لنا، يحملنا ونحن في الأحشاء ويبقى حاملًا إيانا حتى الشيخوخة"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "[3-4]، يفوق حب الأم التي تقدر أن تحمل جنينها في الأحشاء أو الرضيع وإلى حدٍ ما"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "حين يصير طفلًا صغيرًا في السنوات القليلة الأولى من حياته... تحمله جسديًا وتحمل بعض متاعبه لكنها تعجز عن إدراك كل أسراره الخفية لتشاركه متاعبه، أما الله فيحملنا حتى الشيخوخة، يحمل كل أتعابنا الظاهرة والخفية، وكما يقول المرتل: \"أبي وأمي قد تركاني والرب يضمني\" (مز 27: 10)."
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "لله في حبه شبيه لا الوالدين ولا الآلهة الأخرى المحتاجة إلى من يصنعها ويرفعها"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "على الكتف ويقيمها في موضع ويحرسها حتى لا تُسرق، يصرخ إليها عابدوها فلا تُجيبهم"
    },
    {
      "section_title": "\"نَبو\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "وقت الشدة [5-7]."
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "8 «اُذْكُرُوا هذَا وَكُونُوا رِجَالًا. رَدِّدُوهُ فِي قُلُوبِكُمْ أَيُّهَا الْعُصَاةُ. 9 اُذْكُرُوا الأَوَّلِيَّاتِ مُنْذُ الْقَدِيمِ، لأَنِّي أَنَا اللهُ وَلَيْسَ آخَرُ. الإِلهُ وَلَيْسَ مِثْلِي. 10 مُخْبِرٌ مُنْذُ الْبَدْءِ بِالأَخِيرِ، وَمُنْذُ الْقَدِيمِ بِمَا لَمْ يُفْعَلْ، قَائِلًا: رَأْيِي يَقُومُ وَأَفْعَلُ كُلَّ مَسَرَّتِي. 11 دَاعٍ مِنَ الْمَشْرِقِ الْكَاسِرَ، مِنْ أَرْضٍ بَعِيدَةٍ رَجُلَ مَشُورَتِي. قَدْ تَكَلَّمْتُ فَأُجْرِيهِ. قَضَيْتُ فَأَفْعَلُهُ. 12 «اِسْمَعُوا لِي يَا أَشِدَّاءَ الْقُلُوبِ الْبَعِيدِينَ عَنِ الْبِرِّ. 13 قَدْ قَرَّبْتُ بِرِّي، لاَ يَبْعُدُ. وَخَلاَصِي لاَ يَتَأَخَّرُ. وَأَجْعَلُ فِي صِهْيَوْنَ خَلاَصًا، لإِسْرَائِيلَ جَلاَلِي."
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "هي مسرة الله [10]، أنه صنع في القديم ولا زال يعمل ويبقى عاملًا من أجل خلاص شعبه."
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "حمل أثقالهم في أيام موسى عند خروجهم من مصر ويحملها أثناء ردهم من"
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "السبي البابلي"
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "ولا يزال يحملها خلال ذبيحة الصليب القائمة."
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "دُعي"
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "كورش -رمز السيد المسيح- بالطائر الكاسر [11] لأنه سريع الحركة، قوي ينقضّ على"
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "بابل ليخطفها كفريسة، يخطف آلهتها وكنوزها... إنه رمز للسيد المسيح الذي انقضَّ"
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "على عدو الخير وحطم مملكته ليرد للإنسان كرامته وحريته وغناه الروحي."
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "أرض بعيدة رجل مشورتي\" [11]، رمز السيد المسيح القادم من السماء"
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "ليصير \"ابن الإنسان\" (رجل مشورتي) الذي يُحقق إرادة الآب فيه بمسرة."
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "إشعياء النبي المخلص قادمًا من بعيد فيدعو الأمم البعيدين للقرب منه والتمتع ببره"
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "وخلاصه: \"اسمعوا ليّ يا أشداء القلوب، البعيدين عن البر، قد قربت برّي، لا"
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "يبعد وخلاصي لا يتأخر\" [12-13]."
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "ربما"
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "يوجه حديثه هنا إلى البابليين قساة القلوب معلنًا لهم أن مقاومتهم لبرّ الله"
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "ولخلاصه لن تدوم، فقد اقترب وقت الخلاص."
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "ولعله"
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "يتحدث مع الأمم قساة القلوب حتى يقبلوا برّ الرب وخلاصه بلا مقاومة."
    },
    {
      "section_title": "2. دعوة كورش من المشرق",
      "content_type": "شرح",
      "father_name": null,
      "text": "← تفاسير أصحاحات"
