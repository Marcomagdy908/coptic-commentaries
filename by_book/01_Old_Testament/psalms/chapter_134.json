{
  "book_id": "psalms",
  "book_title": "تفسير سفرالمزامير",
  "chapter_number": 134,
  "chapter_title": "المزمور 134",
  "topic": "الأصحاح 134",
  "chapter_outline": [
    {
      "number": 1,
      "title": "مزامير",
      "verses": ""
    },
    {
      "number": 2,
      "title": "الكتاب المقدس",
      "verses": ""
    },
    {
      "number": 3,
      "title": "تقصير الرابط",
      "verses": ""
    }
  ],
  "sections_count": 280,
  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الآن وقد بلغنا قمة السلم، أو"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "المزمور الأخير من مزامير المصاعد، يرتفع قلبنا كما إلى السماء عينها، لندخل"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "إلى حضن الآب، ونشترك مع الطغمات السمائية في التسبيح الدائم بفرحٍ وتهليلٍ. كل"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ما يشغلنا هو التمجيد من أجل بركة الرب الحالة علينا. كأننا نمارس الحياة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "السماوية المتهللة، في بيت الرب الأبدي."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "يمكن القول بأن هذا المزمور هو"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "تسبحة كنسية ليتورجية، يقدمها المؤمنون في السماء عينها، كتسبحة شكر لبلوغهم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "المقادس الإلهية."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "يرى البعض أنه إذ يبلغ القادمون"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "إلى الهيكل للعيد في آخر النهار وتبدأ خدمة المساء، يترنم رئيس الكهنة طالبًا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "من الكهنة واللاويين أن يسبحوا الرب مع جميع الشعب [1-2]."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "إن كان الكهنة واللاويون الذين"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "عليهم حراسة الهيكل حتى لا يحدث أي خلل في النظام، فلا يقترب أحد من موضعٍ غير"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مسموح له بالاقتراب إليه، ومراعاة نار المذبح ألا تنطفئ، وأيضًا سرج المنارة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "إلخ. لكن الكل من كهنة ولاويين وشعب يلزمهم أن يسبحوا الرب ويمجدوه، إذ فتح لهم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "بيته كي يدخلوا إليه ويتمتعوا بالحضرة الإلهية."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "تَرْنِيمَةُ الْمَصَاعِدِ"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "هُوَذَا بَارِكُوا الرَّبَّ يَا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "جَمِيعَ عَبِيدِ الرَّبِّ"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الْوَاقِفِينَ فِي بَيْتِ"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الرَّبِّ بِاللَّيَالِي [1]."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "بهذا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "يختم مزامير الدرجات مقدمًا مقاله النهائي الرائع، تسبحته وبركته. الآن يريد من"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "عبيد الرب ألا يحتفظوا فقط بتعاليمه، وإنما أيضًا بنفس طريقة الحياة. لهذا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "يضيف:\"... الواقفين في بيت الرب، في ديار إلهنا\". إنه ليس من اللائق"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "للشخص الدنس والنجس أن يدخل الأماكن المقدسة. ومن كان مستحقًا للدخول، يكون"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مستحقًا للبركة. بيت الرب مثل السماء، وكما أنه لا يجوز للقوات المقاومة أن"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "تدخل هناك، هكذا أيضًا بالنسبة لبيت الرب..."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الآن كيف يمكنكم أن تظهروا هذه"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "النقاوة؟ إن كنتم تستبعدون كل فكرٍ شريرٍ، إن كنتم تمجدون دخول أعمال الشيطان"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "إلى مواضع في أذهانكم، إن كنتم تستمرون في تزيين أذهانكم كما بالنسبة للهيكل"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "المقدس. فوق هذا كله، إن كان في الهيكل اليهودي لا يفتح كل موضع لكل أحدٍ، إنما"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "توجد أقسام كثيرة متنوعة - مكان للدخلاء وآخر للذين هم يهود منذ البداية، وآخر"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "للكهنة، وآخر لرئيس الكهنة وحده، وهذا ليس في كل الأوقات إنما مرة واحدة في"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "السنة - ضعوا في اعتباركم درجة القداسة المطلوبة من الشخص الذي ينال ما هو أعظم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "من الرمز، وأعظم من قدس الأقداس في ذلك الحين. ليس لكم الشاروبيم بل رب"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الشاروبيم نفسه يسكن في الداخل؛ ليس لكم وعاء المن أو لوحا الحجر، أو"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "عصا هرون،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "بل جسد الرب ودمه، الروح عوض الحرف، والنعمة التي تفوق العقل البشري، وهبة لا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "تُوصف."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الآن أنتم تبدون أكثر استحقاقًا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "من الرموز العظيمة والأسرار المهوبة، يمكنكم بالأكثر أن تثبتوا قداسة أعظم، كما"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "تنالون عقوبة أخطر إن كسرتم الوصايا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "القديس يوحنا"
    },
    {
      "section_title": null,
      "content_type": "قول آبائي",
      "father_name": "القديس يوحنا ذهبي الفم",
      "text": "الذهبي الفم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ارْفَعُوا أَيْدِيَكُمْ نَحْوَ"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الْقُدْسِ"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "وَبَارِكُوا الرَّبَّ [2]."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "رفع الأيادي يشير إلى رفع القلب"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "والفكر إلى الله الساكن في السماء. كما أن الأيادي تشير إلى العمل، وكأنه مع"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "التأمل في محبة الله ونعمته ورعايته يليق بالمؤمنين أن يمارسوا ما يليق بهم،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "فتتناغم حياتهم مع تأملاتهم وصلواتهم وتسابيحهم. وكما يقول الرسول بولس: \"فأريد"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أن يصلي الرجال في كل مكانٍ رافعين أيادي طاهرة بدون غضبٍ ولا جدالٍ\" (1 تي 2: 8)."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "\"بالليالي ارفعوا أيديكم نحو"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "القدس، وباركوا الرب\""
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "[2]. لماذا يقول: \"بالليالي\"؟ ليعلمنا ألا نقضي الليل كله في النوم، بل تظهر أن"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الصلوات أكثر نقاوة في ذلك الوقت، حيث يكون الذهن أكثر نقاوة، ووقت الفراغ أكثر"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "إمكانية. الآن إذ كان من الضروري أن يجد الشخص طريقًا للقدس بالليل، فكروا ما"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "هو العذر الذي يمكن أن يقدم من ذاك الذي لا يمارس واجب الصلاة في ذلك في الوقت"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "في البيت.؟ أقصد إن الكاتب المُوحى له يقوم من سريره ويسلك الطريق إلى الهيكل"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "متجهًا إلى هناك ليقضي الليل، بينما فلا تفعل هذا وأنت مستريح في البيت"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "القديس يوحنا"
    },
    {
      "section_title": null,
      "content_type": "قول آبائي",
      "father_name": "القديس يوحنا ذهبي الفم",
      "text": "الذهبي الفم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ليت العريس (السيد المسيح) يجد كل عروس (النفس البشرية) تجدل خيوط الفضيلة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الَثمينة، ترفع يديها في الليالي (بالصلاة)، وتدبر عملها، وتزين عاداتها،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "وتنتظر مجيء عريسها متعجلة بشوق"
    },
    {
      "section_title": null,
      "content_type": "قول آبائي",
      "father_name": "القديس أمبروسيوس",
      "text": "القديس أمبروسيوس"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "يُبَارِكُكَ الرَّبُّ مِنْ"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "صِهْيَوْنَ،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الصَّانِعُ السَّمَاوَاتِ"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "وَالأَرْضَ [3]."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "يرى البعض أن هذه الآية هي مرد"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الكهنة واللاويين على رئيس الكهنة الذي حثهم على أن يباركوا الرب في الليالي."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ويرى آخرون أنها مرد الكهنة على كل الحاضرين، سائلين بركته على كل الشعب. كما"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "جاء في سفر العدد: \"كلم هرون وبنيه قائلًا هكذا: تباركون بني إسرائيل، قائلين"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "لهم: يباركك الرب ويحرسك، يضيء، الرب بوجهه عليك ويرحمك. يرفع الرب وجهه عليك"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ويمنحك سلامًا\" (عد 6: 23-26)."
    },
    {
      "section_title": null,
      "content_type": "قول آبائي",
      "father_name": "القديس أغسطينوس",
      "text": "القديس أغسطينوس أن"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "بركة الرب الصادرة إلى كثيرين تُقدم بصيغة المفرد، أي تصدر إلى واحدٍ، فإن من"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "يرتبط مع إخوته ليصير معهم واحدًا يتمتع ببركة الرب."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "بعد أن"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "قدم هذه النصيحة كأمرٍ ضروري، يختم كلماته بالصلاة. هذه كما ترون هي علامة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "معلمٍ سامٍ، يقوِّم سامعيه بالنصيحة، وينعشهم بالصلوات. ماذا يريد من إشارته"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "بالقول \"من صهيون\"؟ هذا الاسم كان عزيزًا عليهم، وكل دائرة طقوسهم تتم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "هناك. لهذا يسألهم أن يتبنوا طريقة حياتهم السابقة وأن ينشغلوا بالطقس،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ويتمتعوا بتلك البركة. عندئذ لكي يقودهم إلى فوق نحو التعاليم العلوية، يرشدهم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أن الله وإن كان في كل موضع أعطاهم شرائع لبناء الهيكل لأجل محدودياتهم، كما"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "يلزمهم أن يناشدونه في كل موضع، لهذا أضاف: \"الصانع السماوات والأرض\" مع"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "هذا فإنهم وإن كانوا يناشدونه في ذلك الموضع، فبالنسبة لنا على عكس هذا يلزمنا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أن نفعل هذا في كل موضع، وفي كل مكان: في البيت والسوق وعلى ظهر السفينة وفي"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "البرية وأينما وُجدنا. ممارسة الصلاة لا يمكن بحالٍ من الأحوال يعوقها المكان،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "بشرط أن يكون الوضع لائقًا بالصلاة. بتأكيد هذا لنتوسل إلى الله في كل موضعٍ،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "وهو يستجيب، يقوم بدوره، فيجعل كل ما هو صعب سهلًا وبسيطًا بالنسبة لنا،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ويبهجنا بالخيرات العتيدة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "القديس يوحنا"
    },
    {
      "section_title": null,
      "content_type": "قول آبائي",
      "father_name": "القديس يوحنا ذهبي الفم",
      "text": "الذهبي الفم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "من وحي المزمور 134"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "هب لي عربون السماء!"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "*وعودك"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "صادقة وأمينة."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "نزلت إلى أرضنا لتهبنا عربون"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "سماواتك."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "هب لنا القلب السماوي المملوء"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "حبًا،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "فتسبحك أعماقنا، وتمجد اسمك."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "*لنرفع"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أيادينا إليك نهارًا وليلًا."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "نشكرك في النهار حيث الفرج،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "وبالليل وسط الضيق."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "نسبحك من أجل كل أعمالك معنا."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "فإنك الحب الكلي الحكمة."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "لك المجد يا محب البشر!"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "On Ps. 134."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "On Ps. 134."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "In Luc. 16:16-18."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "On Ps. 134."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "← تفاسير أصحاحات"
