  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "المسيح دائِس الْمِعْصَرَة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ظهرت الكنيسة في"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الأصحاح السابق كعروس"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "تتمتع بانتسابها لله مخلصها وعريسها، الآن يقدم لنا صورة للعريس الذي يبذل حياته"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "من أجل عروسه."
    },
    {
      "section_title": "1. المسيح المصلوب",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "1 مَنْ ذَا الآتِي مِنْ أَدُومَ، بِثِيَابٍ حُمْرٍ مِنْ بُصْرَةَ؟ هذَا الْبَهِيُّ بِمَلاَبِسِهِ، الْمُتَعَظِّمُ بِكَثْرَةِ قُوَّتِهِ. «أَنَا الْمُتَكَلِّمُ بِالْبِرِّ، الْعَظِيمُ لِلْخَلاَصِ». 2 مَا بَالُ لِبَاسِكَ مُحَمَّرٌ، وَثِيَابُكَ كَدَائِسِ الْمِعْصَرَةِ؟ 3 «قَدْ دُسْتُ الْمِعْصَرَةَ وَحْدِي، وَمِنَ الشُّعُوبِ لَمْ يَكُنْ مَعِي أَحَدٌ. فَدُسْتُهُمْ بِغَضَبِي، وَوَطِئْتُهُمْ بِغَيْظِي. فَرُشَّ عَصِيرُهُمْ عَلَى ثِيَابِي، فَلَطَخْتُ كُلَّ مَلاَبِسِي. 4 لأَنَّ يَوْمَ النَّقْمَةِ فِي قَلْبِي، وَسَنَةَ مَفْدِيِّيَّ قَدْ أَتَتْ. 5 فَنَظَرْتُ وَلَمْ يَكُنْ مُعِينٌ، وَتَحَيَّرْتُ إِذْ لَمْ يَكُنْ عَاضِدٌ، فَخَلَّصَتْ لِي ذِرَاعِي، وَغَيْظِي عَضَدَنِي. 6 فَدُسْتُ شُعُوبًا بِغَضَبِي وَأَسْكَرْتُهُمْ بِغَيْظِي، وَأَجْرَيْتُ عَلَى الأَرْضِ عَصِيرَهُمْ»."
    },
    {
      "section_title": "1. المسيح المصلوب",
      "content_type": "شرح",
      "father_name": null,
      "text": "يوم خراب أورشليم على يديْ بابل وقف بنو آدوم شامتين بل وقاموا بدور إيجابي ضد"
    },
    {
      "section_title": "1. المسيح المصلوب",
      "content_type": "شرح",
      "father_name": null,
      "text": "أورشليم بإلقاء القبض على الهاربين لتسليمهم أسرى، ودخولهم بغنائمهم للرعي في"
    },
    {
      "section_title": "1. المسيح المصلوب",
      "content_type": "شرح",
      "father_name": null,
      "text": "أورشليم إلخ... لهذا يصرخ المرتل قائلًا: \"أذكر يا رب لبني آدوم يوم أورشليم"
    },
    {
      "section_title": "1. المسيح المصلوب",
      "content_type": "شرح",
      "father_name": null,
      "text": "القائلين: هُدّوا هُدّوا حتى إلى أساسها\" (مز 137: 7)؛ كما يقول عوبديا"
    },
    {
      "section_title": "1. المسيح المصلوب",
      "content_type": "شرح",
      "father_name": null,
      "text": "النبي: \"من أجل ظُلمك لأخيك يعقوب يغشاك الخزي وتنقرض إلى الأبد، يوم وقفت"
    },
    {
      "section_title": "1. المسيح المصلوب",
      "content_type": "شرح",
      "father_name": null,
      "text": "مقابله، يوم سَبَتِ الأعاجم قدرته ودخلت الغرباء أبوابه وألقوا قرعة على أورشليم كنت أنت أيضًا كواحد منهم\" (عو 1: 11)."
    },
    {
      "section_title": "1. المسيح المصلوب",
      "content_type": "شرح",
      "father_name": null,
      "text": "يشير"
    },
    {
      "section_title": "1. المسيح المصلوب",
      "content_type": "شرح",
      "father_name": null,
      "text": "آدوم (تعني ترابًا ومحبًا لسفك الدماء) إلى عدو الخير إبليس لهذا يظهر المخلص"
    },
    {
      "section_title": "1. المسيح المصلوب",
      "content_type": "شرح",
      "father_name": null,
      "text": "كقادم من آدوم بثياب حمر في جلاله وعظمته؛ غلب العدو وداسه كما في معصرة ليهب شعبه"
    },
    {
      "section_title": "1. المسيح المصلوب",
      "content_type": "شرح",
      "father_name": null,
      "text": "نصرة وخلاصًا."
    },
    {
      "section_title": "1. المسيح المصلوب",
      "content_type": "شرح",
      "father_name": null,
      "text": "ذا الآتي من آدوم بثياب حمر من بصرة؟! هذا البهي بملابسه، المتعظم بكثرة قوته؟!"
    },
    {
      "section_title": "1. المسيح المصلوب",
      "content_type": "شرح",
      "father_name": null,
      "text": "أنا المتكلم بالبر العظيم للخلاص\" [1]."
    },
    {
      "section_title": "1. المسيح المصلوب",
      "content_type": "شرح",
      "father_name": null,
      "text": "تطلع"
    },
    {
      "section_title": "1. المسيح المصلوب",
      "content_type": "شرح",
      "father_name": null,
      "text": "النبي إلى المخلص وقد ارتفع على الصليب محطمًا آدوم الحقيقي وواهبًا نصرة وبهاء"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أنت؟"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أين أنت قادم؟"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "هو حالك؟"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "هو عملك؟ وما هو هدفك؟"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "جهة شخصه يقول: \"أنا المتكلم بالبر العظيم الخلاص\" [1]."
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "كثيرون يتكلمون بالبر ويجيدون الحديث عنه، حتى بعض القادة الدينيين في ذلك الحين"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "كانوا قادرين على التعليم بخصوص البر. أما المخلص -ربنا يسوع- فهو الوحيد القادر"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أن يتحدث بالبر \"العظيم الخلاص\"، أي البر العملي الذي يهب خلاصًا"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "من الأعداء وتمتعًا بالأبدية. هو وحده البار الذي لم يعرف خطية (2 كو 5: 21)، حمل"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "خطايانا في جسده ليكفر عنها بدمه المبذول، مقدمًا لنا بره برًا لنا. إنه فريد في"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "بره، فمن جانب: هو وحده الذي بلا عيب مطلقًا، ومن الجانب الآخر قادر أن يبرر"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الآخرين. أنه البار الذي يُسر الآب به، يحملنا فيه لنحسب نحن أيضًا موضع سروره."
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "يتكلم"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "السيد المسيح عن برّ لا بفمه فقط وإنما بكل كيانه وحياته التي بذلها بإرادته"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "المقدسة خلال حبه الإلهي لأجل تبريرنا، ليُصلح من حال طبيعتنا الفاسدة ويهبها شركة"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الطبيعة الإلهية (2 بط 1: 4)."
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "جهة الموقع رآه قادمًا من \"آدوم\" التي تعني \"ترابًا\" أو"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"دمًا\". وكأن الرب جاء إلى حيث سقطنا، إلى آدوم، حيث عدنا إلى ترابنا"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "لكي يحول ترابنا إلى سماء. لقد قيل لنا \"لأنك تراب وإلى تراب تعود\" (تك 3: 19)، الآن إذ نزل مخلصنا السماوي إلى أرضنا لنتحد معه نسمع الصوت الإلهي:"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"لأنك سماء وإلى سماء تعود\". هذا هو برّ المسيح الذي يرفعنا كما من"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "المزبلة ليُقيمنا في سمواته."
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "جانب آخر فإننا إذ صرنا \"أدوم\" (= دم) محبين للقتال أو مبغضين للغير، فإن"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "مسيحنا جاء إلى أرض المعركة ليغتصبنا من عدو الخير المحب لسفك الدماء لكي يتسع"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "قلبنا بالحب والبذل!"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "جهة عمله يقول: \"قد دستُ المعصرة وحدي ومن الشعوب لم يكن معي أحد\" [3]."
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "دخل المعركة -معركة الصليب- وحده، وكما قال لتلاميذه: \"وتتركونني وحدي وأنا"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "لست وحدي لأن الآب معي\" (يو 16: 32)."
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "لباسه محمر وثيابه كدائس المعصرة [2]، إذ ألبسوه ثوبًا قرمزيًا (مر 15: 17) ليسخروا به. كما تُشير إلى أن جسده كله قد أفاض دمًا من الجراحات الواهبة الشفاء (إش 53: 5). هذا البذل هو سرّ جمال فائق يدركه من اختبر"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الصليب كقوة الله للخلاص، لهذا قيل \"البهي"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "بملابسه\" [1]."
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "قول آبائي",
      "father_name": "القديس غريغوريوس النزينزي",
      "text": "القديس غريغوريوس النزينزي"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "فعله إنما بوحي حبه العظيم وغيرته نحو عروسه إذ أراد أن يُحررها من العدو إبليس"
    },
    {
      "section_title": "لمؤمنيه، فصار يسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "ويهبها التمتع بسنة اليوبيل الدائمة أو التحرر غير المنقطع [4]."
    },
    {
      "section_title": "2. تسبحة عن إحسانات الرب",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "7 إِحْسَانَاتِ الرَّبِّ أَذْكُرُ، تَسَابِيحَ الرَّبِّ، حَسَبَ كُلِّ مَا كَافَأَنَا بِهِ الرَّبُّ، وَالْخَيْرَ الْعَظِيمَ لِبَيْتِ إِسْرَائِيلَ الَّذِي كَافَأَهُمْ بِهِ حَسَبَ مَرَاحِمِهِ، وَحَسَبَ كَثْرَةِ إِحْسَانَاتِهِ. 8 وَقَدْ قَالَ حَقًّا: «إِنَّهُمْ شَعْبِي، بَنُونَ لاَ يَخُونُونَ». فَصَارَ لَهُمْ مُخَلِّصًا. 9 فِي كُلِّ ضِيقِهِمْ تَضَايَقَ، وَمَلاَكُ حَضْرَتِهِ خَلَّصَهُمْ. بِمَحَبَّتِهِ وَرَأْفَتِهِ هُوَ فَكَّهُمْ وَرَفَعَهُمْ وَحَمَلَهُمْ كُلَّ الأَيَّامِ الْقَدِيمَةِ."
    },
    {
      "section_title": "2. تسبحة عن إحسانات الرب",
      "content_type": "شرح",
      "father_name": null,
      "text": "يجد النبي ما يمكن للكنيسة العروس المفدية بالدم أن تقدمه مقابل إحسانات الله"
    },
    {
      "section_title": "2. تسبحة عن إحسانات الرب",
      "content_type": "شرح",
      "father_name": null,
      "text": "الدائمة والتي تجلت في أعمق صورها على الصليب سوى التسبيح له."
    },
    {
      "section_title": "2. تسبحة عن إحسانات الرب",
      "content_type": "شرح",
      "father_name": null,
      "text": "يقدم الله إحساناته من أجل مقابل ما، إنما من أجل مراحمه وكثرة إحساناته، متطلعًا"
    },
    {
      "section_title": "2. تسبحة عن إحسانات الرب",
      "content_type": "شرح",
      "father_name": null,
      "text": "إلينا إننا شعبه وبنوه؛ يُشاركنا ضيقنا وآلامنا."
    },
    {
      "section_title": "2. تسبحة عن إحسانات الرب",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"في كل ضيقهم تضايق وملاك"
    },
    {
      "section_title": "2. تسبحة عن إحسانات الرب",
      "content_type": "شرح",
      "father_name": null,
      "text": "حضرته (المخلص) خلصهم\" [9]. إنه حب عجيب!"
    },
    {
      "section_title": "3. تذكير الله لأعماله القديمة",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "10 وَلكِنَّهُمْ تَمَرَّدُوا وَأَحْزَنُوا رُوحَ قُدْسِهِ، فَتَحَوَّلَ لَهُمْ عَدُوًّا، وَهُوَ حَارَبَهُمْ. 11 ثُمَّ ذَكَرَ الأَيَّامَ الْقَدِيمَةَ، مُوسَى وَشَعْبَهُ: «أَيْنَ الَّذِي أَصْعَدَهُمْ مِنَ الْبَحْرِ مَعَ رَاعِي غَنَمِهِ؟ أَيْنَ الَّذِي جَعَلَ فِي وَسَطِهِمْ رُوحَ قُدْسِهِ، 12 الَّذِي سَيَّرَ لِيَمِينِ مُوسَى ذِرَاعَ مَجْدِهِ، الَّذِي شَقَّ الْمِيَاهَ قُدَّامَهُمْ لِيَصْنَعَ لِنَفْسِهِ اسْمًا أَبَدِيًّا، 13 الَّذِي سَيَّرَهُمْ فِي اللُّجَجِ، كَفَرَسٍ فِي الْبَرِّيَّةِ فَلَمْ يَعْثُرُوا؟ 14 كَبَهَائِمَ تَنْزِلُ إِلَى وَطَاءٍ، رُوحُ الرَّبِّ أَرَاحَهُمْ». هكَذَا قُدْتَ شَعْبَكَ لِتَصْنَعَ لِنَفْسِكَ اسْمَ مَجْدٍ."
    },
    {
      "section_title": "3. تذكير الله لأعماله القديمة",
      "content_type": "شرح",
      "father_name": null,
      "text": "كان الإنسان في غباوته يأخذ موقفًا مضادًا من خالقه وفاديه، فإن الله في محبته"
    },
    {
      "section_title": "3. تذكير الله لأعماله القديمة",
      "content_type": "شرح",
      "father_name": null,
      "text": "يذكر أعماله القديمة معهم كيف راعاهم خلال موسى، وكيف حل في وسطهم بروحه القدوس."
    },
    {
      "section_title": "3. تذكير الله لأعماله القديمة",
      "content_type": "شرح",
      "father_name": null,
      "text": "شق أمامهم المياه ليتمجد اسمه فيهم... لا يزال الله هو هو في حب يود أن يقود شعبه"
    },
    {
      "section_title": "3. تذكير الله لأعماله القديمة",
      "content_type": "شرح",
      "father_name": null,
      "text": "بنفسه!"
    },
    {
      "section_title": "3. تذكير الله لأعماله القديمة",
      "content_type": "شرح",
      "father_name": null,
      "text": "حقًا"
    },
    {
      "section_title": "3. تذكير الله لأعماله القديمة",
      "content_type": "شرح",
      "father_name": null,
      "text": "إنه يؤدبهم على موقفهم العدائي لكنه يبقى منتظرًا عودتهم، هذا ما عناه بقوله:"
    },
    {
      "section_title": "3. تذكير الله لأعماله القديمة",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"ولكنهم تمردوا وأحزنوا روح قدسه فتحول لهم عدوًا وهو حاربهم، ثم ذكر"
    },
    {
      "section_title": "3. تذكير الله لأعماله القديمة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأيام القديمة إلخ...\" [10-11]."
    },
    {
      "section_title": "3. تذكير الله لأعماله القديمة",
      "content_type": "شرح",
      "father_name": null,
      "text": "إن كنا نصلي"
    },
    {
      "section_title": "3. تذكير الله لأعماله القديمة",
      "content_type": "شرح",
      "father_name": null,
      "text": "ونردد المزامير قدامه في كبرياء بطريقة نقدية، في زهو، إن كنا نتمم الخدمة بتشتيت"
    },
    {
      "section_title": "3. تذكير الله لأعماله القديمة",
      "content_type": "شرح",
      "father_name": null,
      "text": "فكر ليس فقط لا يصغي إلينا بل ويسلمنا للشرير... يرتد ليصير خصمًا يُحاربنا؛ بمعنى"
    },
    {
      "section_title": "3. تذكير الله لأعماله القديمة",
      "content_type": "شرح",
      "father_name": null,
      "text": "آخر يسحبنا من حضرته ويسلمنا للشيطان لتأديبنا حتى نتوقف عن"
    },
    {
      "section_title": "3. تذكير الله لأعماله القديمة",
      "content_type": "شرح",
      "father_name": null,
      "text": "التجديف (1 تي 1: 20)."
    },
    {
      "section_title": "3. تذكير الله لأعماله القديمة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأب مارتيروس السرياني"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "15 تَطَلَّعْ مِنَ السَّمَاوَاتِ وَانْظُرْ مِنْ مَسْكَنِ قُدْسِكَ وَمَجْدِكَ: أَيْنَ غَيْرَتُكَ وَجَبَرُوتُكَ؟ زَفِيرُ أَحْشَائِكَ وَمَرَاحِمُكَ نَحْوِي امْتَنَعَتْ. 16 فَإِنَّكَ أَنْتَ أَبُونَا وَإِنْ لَمْ يَعْرِفْنَا إِبْرَاهِيمُ، وَإِنْ لَمْ يَدْرِنَا إِسْرَائِيلُ. أَنْتَ يَا رَبُّ أَبُونَا، وَلِيُّنَا مُنْذُ الأَبَدِ اسْمُكَ. 17 لِمَاذَا أَضْلَلْتَنَا يَا رَبُّ عَنْ طُرُقِكَ، قَسَّيْتَ قُلُوبَنَا عَنْ مَخَافَتِكَ؟ ارْجعْ مِنْ أَجْلِ عَبِيدِكَ، أَسْبَاطِ مِيرَاثِكَ. 18 إِلَى قَلِيل امْتَلَكَ شَعْبُ قُدْسِكَ. مُضَايِقُونَا دَاسُوا مَقْدِسَكَ. 19 قَدْ كُنَّا مُنْذُ زَمَانٍ كَالَّذِينَ لَمْ تَحْكُمْ عَلَيْهِمْ، وَلَمْ يُدْعَ عَلَيْهِمْ بِاسْمِكَ."
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "نسقط في الشر ونقف كمعادين لله، يبقى الله منتظرًا توبتنا. فلا نبرر أخطاءنا إنما"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "نستدر حبه وغيرته نحونا بكونه أبانا الذي يعرفنا أكثر من إبراهيم أب المؤمنين"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "وإسرائيل نفسه [16]."
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"تطلع"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "من السموات وانظر من مسكن قدسك ومجدك\" [15]. هكذا يشعر الخاطئ"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "كأنه قد دنّس الأرض بخطيته ورجاسته، وكأن الله قد فارق الأرض ليبقى في السماء حيث"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "مقدسه ومجده، لهذا يستدر مراحم الله، طالبًا منه أن يتطلع من سمواته الطاهرة نحو"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "النفس الساقطة والمشتاقة إلى الرجوع إليه والتمتع بحضرته."
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "ربما"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "جاء هذا الشعور كوليد لما حل بهيكل الرب من خراب، فقد رأى حزقيال النبي مجد الرب يُفارق"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الهيكل والمدينة \"أورشليم\" بل والأرض كلها، إذ يقول: \"وخرج مجد"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرب من على عتبة البيت ووقف على الكروبيم، فرفعت الكروبيم أجنحتها وصعدت عن الأرض"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "قدَّام عيني\" (حز 10: 18-19)."
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"أين"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "غيرتك...؟ ومراحمك نحوي قد امتنعت\" [15]. تقوم التوبة على أساس اكتشاف"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "غيرة الرب نحو أولاده وحبه الفائق العميق \"زفير أحشائك\" ومراحمه"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "نحو الإنسان مهما كانت ضعفاته. كما تقوم على إدراكه بنوته له (تث 32: 6؛ إش 63: 16)."
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"لماذا"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "أضللتنا يا رب عن طرقك؟! قسَّيتَ قلوبنا عن مخافتك؟! ارجع من أجل عبيدك أسباط"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "ميراثك\" [17]. واضح هنا أن التائب لا يعني إلقاء اللوم على الله،"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "إنما بعدما اكتشف أبوة الله في الحال يُعاتبه، بأنه كان ينتظر أن نعمته تسنده. حقًا"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "لقد أخطأ وتمادَى في الخطأ فأسلمه الله لذهنه المرفوض، وتركه لقساوة قلبه (رو 1: 28)، الآن يطلب نعمته حتى لا يضل عن طريق الرب ولا يبقى في قساوة القلب. هذا ما"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "عناه المرتل بقوله: \"بكل قلبي طلبتك، لا تضلني عن وصاياك\" (مز 119: 10)."
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "يدخل الإنسان تحت التأديب يشعر بالمرارة لذلك يقف معاتبًا الله بكل وسيلة، تارة"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "يسأله ألا يسمح بعد أن يتركه في فساد ذهنه وقساوة قلبه، وأخرى يسترحمه من أجل"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "قديسيه المباركين الذين يطلبون عن البشرية [17]، وأخيرًا يسأله أن يسرع بالنجدة إذ"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "طالت مدة التأديب. هذا ما عبّر عنه النبي بالقول: \"إلى قليل امتلك شعب"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "قدسك، مضايقونا داسوا مقدسك، قد كنا منذ زمان كالذين لم تحكم عليهم ولم يُدع عليهم"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "باسمك\" [18-19]. لقد حسبوا المدة التي امتلك فيها الشعب الهيكل"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"قدس الرب\" قليلة مع أنها تبلغ حوالي 400 عام من بناء الهيكل حتى السبي،"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "أما مدة السبي (70 سنة) فحسبوها طويلة للغاية بسبب مرارتها، إذ يقولون \"كنا"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "منذ زمان...\". صاروا تحت السبي مثلهم كسائر الأمم كأن الله ليس حاكما"
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "عليهم ينقذهم من هذا المُرّ، وكأن اسمه لم يدع عليهم..."
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "ذاقوا مرارة السبي اشتاقوا أن يملك الرب عليهم ويدعو اسمه عليهم حتى يخلصهم."
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "Orat. On Easter 35."
    },
    {
      "section_title": "4. صلاة وتوبة",
      "content_type": "شرح",
      "father_name": null,
      "text": "Book of Perfection 77."
    },
