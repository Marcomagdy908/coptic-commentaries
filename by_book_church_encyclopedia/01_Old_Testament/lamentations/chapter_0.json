    },
    {
      "section_title": "ثانيًا: لمن كتبت",
      "content_type": "شرح",
      "father_name": null,
      "text": "لليهود سواء في أورشليم واليهودية أو المسبيين."
    },
    {
      "section_title": "ثالثًا: زمن كتابتها",
      "content_type": "شرح",
      "father_name": null,
      "text": "بعد سبى أورشليم مباشرة أي عام 587 ق.م."
    },
    {
      "section_title": "رابعًا: مكان كتابتها",
      "content_type": "شرح",
      "father_name": null,
      "text": "أورشليم."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "تظهر فيها أبوة إرميا الخادم الذي يشعر بشعبه وبآلامهم."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "عدل الله الذي لابد أن يأخذ مجراه كعقاب للخطية كما أنذر على فم أنبيائه."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "دعوة للتوبة والرجوع إلى الله بسبب الضيق الحادِث وتأديب الله."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "رجاء في رحمة الله ليرفع غضبه عن شعبه التائب."
    },
    {
      "section_title": "سادسًا: أقسامه",
      "content_type": "شرح",
      "father_name": null,
      "text": "كتب بالشعر في خمسة قصائد مرتبة كل منها على الحروف الأبجدية العبرية وعددها 22 ما عدا الأصحاح الثالث الذي يتكون من 66 آية تبدأ كل ثلاثة آيات منها بأحد حروف الأبجدية العبرية الـ22."
    },
    {
      "section_title": "سادسًا: أقسامه",
      "content_type": "شرح",
      "father_name": null,
      "text": "ويمكن تقسيم السفر إلى خمسة أقسام هي:"
    },
    {
      "section_title": "سادسًا: أقسامه",
      "content_type": "شرح",
      "father_name": null,
      "text": "مرا 1 أورشليم الأرملة الباكية."
    },
    {
      "section_title": "سادسًا: أقسامه",
      "content_type": "شرح",
      "father_name": null,
      "text": "مرا 1 أورشليم الأرملة الباكية."
    },
    {
      "section_title": "سادسًا: أقسامه",
      "content_type": "شرح",
      "father_name": null,
      "text": "مرا 2 غضب الله على أورشليم."
    },
    {
      "section_title": "سادسًا: أقسامه",
      "content_type": "شرح",
      "father_name": null,
      "text": "مرا 2 غضب الله على أورشليم."
    },
    {
      "section_title": "سادسًا: أقسامه",
      "content_type": "شرح",
      "father_name": null,
      "text": "مرا 3 بكاء النبي على تأديب الله لشعبه."
    },
    {
      "section_title": "سادسًا: أقسامه",
      "content_type": "شرح",
      "father_name": null,
      "text": "مرا 3 بكاء النبي على تأديب الله لشعبه."
