      "content_type": "شرح",
      "father_name": null,
      "text": "أَشْدُودِيَّاتٍ وَعَمُّونِيَّاتٍ وَمُوآبِيَّاتٍ. [23]"
    },
    {
      "section_title": "4. طرد الزوجات الوثنيات",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَنِصْفُ كَلاَمِ بَنِيهِمْ بِاللِّسَانِ الأَشْدُودِيِّ ،"
    },
    {
      "section_title": "4. طرد الزوجات الوثنيات",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَلَمْ يَكُونُوا يُحْسِنُونَ التَّكَلُّمَ بِاللِّسَانِ الْيَهُودِيِّ"
    },
    {
      "section_title": "4. طرد الزوجات الوثنيات",
      "content_type": "شرح",
      "father_name": null,
      "text": "بَلْ بِلِسَانِ شَعْبٍ وَشَعْبٍ. [24]"
    },
    {
      "section_title": "4. طرد الزوجات الوثنيات",
      "content_type": "شرح",
      "father_name": null,
      "text": "بلا شك أن للأم دورها الرئيسي في تربية الأولاد، وقد ظهر هذا في لهجة الأبناء، إذ لم يكونوا يحسنون اللسان اليهودي بل الأشدودي . هذا بالنسبة للكلام المسموع الذي ينطقون به، كم بالأكثر يكون لسانهم الداخلي، أو أفكارهم، فقد تأثروا بالأمهات الأشدوديات والعمونيات والموآبيات والخدم والجواري الذين جاءوا مع الأمهات."
    },
    {
      "section_title": "4. طرد الزوجات الوثنيات",
      "content_type": "شرح",
      "father_name": null,
      "text": "فَخَاصَمْتُهُمْ وَلَعَنْتُهُمْ،"
    },
    {
      "section_title": "4. طرد الزوجات الوثنيات",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَضَرَبْتُ مِنْهُمْ أُنَاسًا،"
    },
    {
      "section_title": "4. طرد الزوجات الوثنيات",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَنَتَفْتُ شُعُورَهُمْ،"
    },
    {
      "section_title": "وَاسْتَحْلَفْتُهُمْ بِاللَّهِ قَائِلًا",
      "content_type": "شرح",
      "father_name": null,
      "text": "لاَ تُعْطُوا بَنَاتِكُمْ لِبَنِيهِمْ،"
    },
    {
      "section_title": "وَاسْتَحْلَفْتُهُمْ بِاللَّهِ قَائِلًا",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَلاَ تَأْخُذُوا مِنْ بَنَاتِهِمْ لِبَنِيكُمْ وَلاَ لأَنْفُسِكُمْ. [25]"
    },
    {
      "section_title": "وَاسْتَحْلَفْتُهُمْ بِاللَّهِ قَائِلًا",
      "content_type": "شرح",
      "father_name": null,
      "text": "نتف الشعر أي اقتلاعه من جذوره، كعلامة على شدة الحزن، أو كنوع من القسوة في اضطهاد شخصِ ما، أو كنوعٍ من العقوبة، كما جاء في هذا النص. يُقال إن الأثينيين كانوا يعاقبون الزناة بنتف الشعر من فروة الرأس وتغطية الرأس برمادٍ ساخنٍ [4] ."
    },
    {
      "section_title": "وَاسْتَحْلَفْتُهُمْ بِاللَّهِ قَائِلًا",
      "content_type": "شرح",
      "father_name": null,
      "text": "أَلَيْسَ مِنْ أَجْلِ هَؤُلاَءِ أَخْطَأَ سُلَيْمَانُ مَلِكُ إِسْرَائِيلَ،"
    },
    {
      "section_title": "وَاسْتَحْلَفْتُهُمْ بِاللَّهِ قَائِلًا",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَلَمْ يَكُنْ فِي الأُمَمِ الْكَثِيرَةِ مَلِكٌ مِثْلُهُ،"
    },
    {
      "section_title": "وَاسْتَحْلَفْتُهُمْ بِاللَّهِ قَائِلًا",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَكَانَ مَحْبُوبًا إِلَى إِلَهِهِ،"
    },
    {
      "section_title": "وَاسْتَحْلَفْتُهُمْ بِاللَّهِ قَائِلًا",
      "content_type": "شرح",
      "father_name": null,
      "text": "فَجَعَلَهُ اللَّهُ مَلِكًا علَى كُلِّ إِسْرَائِيلَ. [26]"
    },
    {
      "section_title": "وَاسْتَحْلَفْتُهُمْ بِاللَّهِ قَائِلًا",
      "content_type": "شرح",
      "father_name": null,
      "text": "هُوَ أَيْضًا جَعَلَتْهُ النِّسَاءُ الأَجْنَبِيَّاتُ يُخْطِئُ. [27]"
    },
    {
      "section_title": "وَاسْتَحْلَفْتُهُمْ بِاللَّهِ قَائِلًا",
      "content_type": "شرح",
      "father_name": null,
      "text": "استخدم نحميا الملك سليمان الحكيم أحد عظماء ملوك إسرائيل مثلًا خطيرًا للانحراف إلى العبادة الوثنية بسبب زواجه من أمميات وثنيات، مما جلب على المملكة كلها كارثة خطيرة."
    },
    {
      "section_title": "وَاسْتَحْلَفْتُهُمْ بِاللَّهِ قَائِلًا",
      "content_type": "شرح",
      "father_name": null,
      "text": "فَهَلْ نَسْكُتُ لَكُمْ أَنْ تَعْمَلُوا كُلَّ هَذَا الشَّرِّ الْعَظِيمِ"
    },
    {
      "section_title": "وَاسْتَحْلَفْتُهُمْ بِاللَّهِ قَائِلًا",
      "content_type": "شرح",
      "father_name": null,
      "text": "بِالْخِيَانَةِ ضِدَّ إِلَهِنَا"
    },
    {
      "section_title": "وَاسْتَحْلَفْتُهُمْ بِاللَّهِ قَائِلًا",
      "content_type": "شرح",
      "father_name": null,
      "text": "بِمُسَاكَنَةِ نِسَاءٍ أَجْنَبِيَّاتٍ؟"
    },
    {
      "section_title": "وَاسْتَحْلَفْتُهُمْ بِاللَّهِ قَائِلًا",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَكَانَ وَاحِدٌ مِنْ بَنِي يُويَادَاعَ بْنِ أَلْيَاشِيبَ الْكَاهِنِ الْعَظِيمِ صِهْرًا لِسَنْبَلَّطَ الْحُورُونِيِّ،"
    },
    {
      "section_title": "وَاسْتَحْلَفْتُهُمْ بِاللَّهِ قَائِلًا",
      "content_type": "شرح",
      "father_name": null,
      "text": "فَطَرَدْتُهُ مِنْ عِنْدِي. [28]"
    },
    {
      "section_title": "وَاسْتَحْلَفْتُهُمْ بِاللَّهِ قَائِلًا",
      "content_type": "شرح",
      "father_name": null,
      "text": "اذْكُرْهُمْ يَا إِلَهِي لأَنَّهُمْ نَجَّسُوا الْكَهَنُوتَ وَعَهْدَ الْكَهَنُوتِ وَاللاَّوِيِّينَ. [29]"
    },
    {
      "section_title": "وَاسْتَحْلَفْتُهُمْ بِاللَّهِ قَائِلًا",
      "content_type": "شرح",
