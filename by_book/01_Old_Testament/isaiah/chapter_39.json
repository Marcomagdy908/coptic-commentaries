    }
  ],
  "sections_count": 155,
  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "حزقيا يكشف"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ذخائره"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أُختتم الجزء الأول من سفر"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "إشعياء بهذا الأمر الصعب: سقوط حزقيا الملك في الكبرياء وكشف كل ذخائره وذخائر"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "آبائه لسفراء ملك بابل من باب الاستعراض لغناه ومجده، لذا صدر الأمر بسحبها جميعًا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "إلى بابل."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "لقد ارتفع نجم أورشليم بعد هزيمة ملك آشور"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الذي أرعب جميع الأمم وابتدأ الغرور يتسلل إلى قلب حزقيا ليدفع به إلى الهاوية."
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "1 فِي ذلِكَ الزَّمَانِ أَرْسَلَ مَرُودَخُ بَلاَدَانَ بْنُ بَلاَدَانَ مَلِكُ بَابِلَ رَسَائِلَ وَهَدِيَّةً إِلَى حَزَقِيَّا، لأَنَّهُ سَمِعَ أَنَّهُ مَرِضَ ثُمَّ صَحَّ. 2 فَفَرِحَ بِهِمْ حَزَقِيَّا وَأَرَاهُمْ بَيْتَ ذَخَائِرِهِ: الْفِضَّةَ وَالذَّهَبَ وَالأَطْيَابَ وَالزَّيْتَ الطَّيِّبَ، وَكُلَّ بَيْتِ أَسْلِحَتِهِ وَكُلَّ مَا وُجِدَ فِي خَزَائِنِهِ. لَمْ يَكُنْ شَيْءٌ لَمْ يُرِهِمْ إِيَّاهُ حَزَقِيَّا فِي بَيْتِهِ وَفِي كُلِّ مُلْكِهِ."
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "ارتفع نجم حزقيا بسبب هزيمة سنحاريب ملك آشور،"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "وقدم حزقيا مزمور شكر لله خاصة بعد ما وهبه الله 15 عامًا على عمره، لكنه لم يمارس"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "الشكر بحياته إذ ارتفع قلبه وتشامخ (2 أي 32: 26)، وصار له \"غنى وكرامة كثيرة"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "جدًا وعمل لنفسه خزائن للفضة والذهب والحجارة الكريمة والأطياب والأتراس وكل آنية"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "ثمينة... وعمل لنفسه أبراجًا ومواشي غنم وبقر بكثرة لأن الله أعطاه أموالًا كثيرة"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "جدًا\" (2 أي 32: 27-29)."
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "تركه الله في وسط هذا الغنى والمجد إلى"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "حين وأراد أن يكتشف قلبه (2 أي 32: 31) فسمح أن يرسل مردوخ بلادان ملك بابل رسائل"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "وهدية بعد شفائه. كان يليق بحزقيا أن يُمجد الله ويعرض نعمة الله لا أن يكشف عن"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "خزائنه. لقد سقط في الاعتداد بذاته والإعلان عن مجده كما سبق أن سقط شمشون الذي"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "أعلن عن سرّ قوته للزانية فانهار."
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"مردوخ\" لقب حمله أشخاص"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "كثيرون، وهم اسم ملك الآلهة مذكور مع بيل (إر 50: 2)، ويرمز إليه بالسيار المريخ،"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "كثيرًا ما يكون اسمه جزءًا من اسم ملك من ملوك بابل، أما \"بلادان\""
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "فمعناها: \"قد أُعطى ابناُ\"."
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "يقول"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "قول آبائي",
      "father_name": "القديس هيبوليتس",
      "text": "القديس هيبوليتس: [دُهش"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "مردوخ الكلداني ملك بابل في ذلك الحين إذ درس الفلك وقاس هذه الأجرام وعرف السبب"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "فارسل خطابًا وهدايا كما فعل المجوس الذين من المشرق مع المسيح]."
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "اندفع حزقيا بكبرياء قلبه وحبه للمجد"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "الزمني الباطل ليكشف كل ما لديه لرسل مردوخ بلادان: \"لم يكن شيء لم يرهم"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "إياه حزقيا في بيته وفي كل ملكه\" [2]. لم يختبر حزقيا كلمات داود"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "أبيه\" مجد ابنه الملك من الداخل\" (مز 45)."
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "يُستعبدون بغيرة لمجد هذا العالم الحاضر لا يقدرون أن ينالوا المجد الذي من عند الله."
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "لهذا يوبخهم السيد: \"كيف تقدرون أن تؤمنوا وأنتم تقبلون مجدًا من الناس"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "والمجد الذي من الإله (الواحد) لستم تطلبونه؟\" (راجع يو 5: 44)."
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "هذا الألم هو نوع من السكر الشديد، من"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "يخضع له يصعُب علاجه. يفصل نفوس أسراه عن السمويات، ويُسمِرّها في الأرض، ولا"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "يدعها تتطلع إلى النور الحقيقي بل يحثها على التمرغ في الوحل؛ يُقيم عليها سادة"
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "عنفاء يسيطرون عليها حاجة إلى إصدار أوامر."
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "من يُصاب بهذا المرض يعمل حسب هواه..."
    },
    {
      "section_title": "1. استعراض الذخائر",
      "content_type": "قول آبائي",
      "father_name": "القديس يوحنا ذهبي الفم",
      "text": "القديس يوحنا الذهبي الفم"
    },
    {
      "section_title": "الذخائر",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "3 فَجَاءَ إِشَعْيَاءُ النَّبِيُّ إِلَى الْمَلِكِ حَزَقِيَّا وَقَالَ لَهُ: «مَاذَا قَالَ هؤُلاَءِ الرِّجَالُ، وَمِنْ أَيْنَ جَاءُوا إِلَيْكَ؟» فَقَالَ حَزَقِيَّا: «جَاءُوا إِلَيَّ مِنْ أَرْضٍ بَعِيدَةٍ، مِنْ بَابِلَ». 4 فَقَالَ: «مَاذَا رَأَوْا فِي بَيْتِكَ؟» فَقَالَ حَزَقِيَّا: «رَأَوْا كُلَّ مَا فِي بَيْتِي. لَيْسَ فِي خَزَائِنِي شَيْءٌ لَمْ أُرِهِمْ إِيَّاهُ». 5 فَقَالَ إِشَعْيَاءُ لِحَزَقِيَّا: «اسْمَعْ قَوْلَ رَبِّ الْجُنُودِ: 6 هُوَذَا تَأْتِي أَيَّامٌ يُحْمَلُ فِيهَا كُلُّ مَا فِي بَيْتِكَ، وَمَا خَزَنَهُ آبَاؤُكَ إِلَى هذَا الْيَوْمِ، إِلَى بَابِلَ. لاَ يُتْرَكُ شَيْءٌ، يَقُولُ الرَّبُّ. 7 وَمِنْ بَنِيكَ الَّذِينَ يَخْرُجُونَ مِنْكَ الَّذِينَ تَلِدُهُمْ، يَأْخُذُونَ، فَيَكُونُونَ خِصْيَانًا فِي قَصْرِ مَلِكِ بَابِلَ»."
    },
    {
      "section_title": "الذخائر",
      "content_type": "شرح",
      "father_name": null,
      "text": "أرسل الله نبيه إشعياء إلى حزقيا"
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "ماذا"
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "قال هؤلاء الرجال؟"
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أين جاءوا إليك؟"
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "ماذا"
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "رأوا في بيتك؟"
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "لم يجب على أهم سؤال: \"ماذا قال"
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "هؤلاء الرجال؟\"."
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "ظن أنهم جاءوا من أرض بعيدة من بابل [3]"
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "فلا خطر عليه منهم، لذلك صدر الحكم الإلهي بالعقاب خلال بابل."
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "جاءت العقوبة قاسية لأن الكبرياء داء"
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "خطير للغاية، يعني شركة في طبيعة الشيطان. لم يفقد حزقيا الخزائن التي كشفها فحسب"
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "وإنما يفقد حرية أولاده إذ يصيرون خصيانًا في بيت ملك بابل [7]."
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "العلامة"
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "قول آبائي",
      "father_name": "العلامة أوريجانوس",
      "text": "أوريجانوس أن"
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الكبرياء هي خطية الشيطان الرئيسية.يقول"
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "قول آبائي",
      "father_name": "القديس يوحنا ذهبي الفم",
      "text": "القديس يوحنا الذهبي الفم: [ما كان للشيطان أن ينحدر ويصير شيطانًا لو لم يُصب بهذا المرض."
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "لقد طرحه خارج الثقة (بالله)، وأتى به إلى هُوّة النار، وهو علة كل الويلات. أنه"
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "كفيل بتحطيم كل صلاح للنفس، سواء وجد عطاء (تقديم صدقة) أو صلاة أو صومًا أو أي"
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "شيء آخر... ليس أَغْبَى من الإنسان المتكبر، حتى وإن أحاط به الغِنى أو نال الكثير من"
    },
    {
      "section_title": "لتأديبه، فسأله",
      "content_type": "شرح",
      "father_name": null,
      "text": "حكمة هذا العالم، أو وُجد في قصر ملوكي...]."
    },
    {
      "section_title": "3. اعتراف حزقيا بالخطأ",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"فَقَالَ حَزَقِيَّا لإِشَعْيَاءَ: «جَيِّدٌ هُوَ قَوْلُ الرَّبِّ الَّذِي تَكَلَّمْتَ بِهِ». وَقَالَ: «فَإِنَّهُ يَكُونُ سَلاَمٌ وَأَمَانٌ فِي أَيَّامِي».\" [8]."
    },
    {
      "section_title": "3. اعتراف حزقيا بالخطأ",
      "content_type": "شرح",
      "father_name": null,
      "text": "في الظاهر نطق الملك بكلمات تحمل تسليمًا،"
    },
    {
      "section_title": "3. اعتراف حزقيا بالخطأ",
      "content_type": "شرح",
      "father_name": null,
      "text": "لكننا لا نعرف ما هي اتجاهاته ودوافعه، ربما يكون استسلامًا دون توبة وثقة في الله"
    },
    {
      "section_title": "3. اعتراف حزقيا بالخطأ",
      "content_type": "شرح",
      "father_name": null,
      "text": "القادر على غفران الخطايا."
    },
    {
      "section_title": "3. اعتراف حزقيا بالخطأ",
      "content_type": "شرح",
      "father_name": null,
      "text": "لقد اعترف أنه أخطأ لكنه لم يقدم توبة،"
    },
    {
      "section_title": "3. اعتراف حزقيا بالخطأ",
      "content_type": "شرح",
      "father_name": null,
      "text": "دليل ذلك أنه عوض الصراخ إلى الله بدموع من أجل الرجوع إليه شعر بطمأنينة أن"
    },
    {
      "section_title": "3. اعتراف حزقيا بالخطأ",
      "content_type": "شرح",
      "father_name": null,
      "text": "التأديب سيحل بعد موته في أيام أولاده. لقد حمل نوعًا من الأنانية، فقد أهتم أن"
    },
    {
      "section_title": "3. اعتراف حزقيا بالخطأ",
      "content_type": "شرح",
      "father_name": null,
      "text": "يقضي أيامه في طمأنينة دون المبالاة بما سيحل بالشعب وبنسله فيما بعد."
    },
    {
      "section_title": "3. اعتراف حزقيا بالخطأ",
      "content_type": "شرح",
      "father_name": null,
      "text": "Fragments from Comm. On the prophet Isaiah, 1."
    },
    {
      "section_title": "3. اعتراف حزقيا بالخطأ",
      "content_type": "شرح",
      "father_name": null,
      "text": "In John hom. 3,5."
    },
    {
      "section_title": "3. اعتراف حزقيا بالخطأ",
      "content_type": "شرح",
      "father_name": null,
      "text": "In Ezech. 9:2 PG. 13:734 CD."
    },
    {
      "section_title": "3. اعتراف حزقيا بالخطأ",
      "content_type": "شرح",
      "father_name": null,
      "text": "In John hom 16:4."
    },
