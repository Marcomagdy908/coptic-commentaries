{
  "book_id": "chronicles1",
  "book_title": "تفسير سفر أخبار الأيام الأول",
  "chapter_number": 20,
  "chapter_title": "الأصحاح 20",
  "topic": "الأصحاح 20",
  "chapter_outline": [
    {
      "number": 1,
      "title": "اعتمد شاول على قامته الجسدية وقدرته العسكرية، ولم يجد من ينقذه سوى الصبي داود",
      "verses": ""
    },
    {
      "number": 2,
      "title": "أخذ تاج ملك بني عمون الذهبي فوجده ثقيلاً، حتى يدرك أن التَمَتُّع بالنصرة",
      "verses": ""
    },
    {
      "number": 3,
      "title": "لم يوجد لدى داود عمالقة مثل الفلسطينيين، غير أن ارتفاع قامتهم الروحية أفضل من",
      "verses": ""
    }
  ],
  "sections_count": 194,
  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "اَلأَصْحَاحُ الْعِشْرُونَ"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "رأينا في الأصحاح السابق كيف أن جيش بني عمون وحلفاءهم قد هُزِموا في الحرب أمام"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "داود، وهنا نرى رَبَّة عاصمة مملكتهم قد خربت [1]. ووَضَعَ داود تاج ملكهم على رأسه"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "[2]، والشدة العظيمة التي حلَّت بشعبها ومدنها [3]، وقد رأينا أكثر تفصيًلا عن هذه"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الأحداث في (2 صم 11-12)."
    },
    {
      "section_title": "انطلق داود إلى أرض المعركة حتى يُتَمِّم النصرة النهائية",
      "content_type": "شرح",
      "father_name": null,
      "text": "ضخامة الجسم. هكذا يليق بنا أن نهتم بنمو قامتنا الروحية وخَلاصَنا الأبدي أكثر من"
    },
    {
      "section_title": "انطلق داود إلى أرض المعركة حتى يُتَمِّم النصرة النهائية",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأمور الزمنية الزائلة والبنيان الجسدي وضخامته."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "من وحي 1 أي 20: بك أخرج إلى أرض المعركة"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَكَانَ عِنْدَ تَمَامِ السَّنَةِ فِي وَقْتِ خُرُوجِ الْمُلُوكِ،"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "اقْتَادَ يُوآبُ قُوَّةَ الْجَيْشِ،"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَأَخْرَبَ أَرْضَ بَنِي عَمُّونَ،"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَأَتَى وَحَاصَرَ رَبَّةَ."
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَكَانَ دَاوُدُ مُقِيمًا فِي أُورُشَلِيمَ."
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "فَضَرَبَ يُوآبُ رَبَّةَ وَهَدَمَهَا. [1]"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "يُقصَد بتمام السنة هنا دخول فصل الربيع، ففيه كان الملوك ينطلقون ليمارسوا"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "خططهم لفتوحات المستقبل عندما يكون الطقس معتدلاً."
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "قد يظهر هنا أن يوآب هو المعتدي، وربما كان كذلك، ولكن يجب أن نتذكَّر أن داود كان"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "قد قدَّم صداقة لملك بني عمون الشاب، ولكنه أهان داود وقام ذلك الملك الجديد في"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الحال بحرب ضده، فما حدث الآن هو استمرار لتلك الحرب."
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "أرسل داود يوآب ضد رَبَّة (عمان حاليًا) بينما بقي داود في أورشليم (2 صم 12: 1)."
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "استمر الحصار سنتين. وفي هذه الفترة تمَّت الحادثة المُحزِنة بينما كان يوآب"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "مُحاصِرًا رَبَّة، وقع داود في الخطية الكبرى الخاصة بتدبيره أمر موت"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "أوريّا الحثِّي وزواجه ببثشبع (2 صم 11-12). لم تُذكَرْ هذه الخطية هنا، وقد رأينا قبلاً"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "لماذا لم يُشِرْ السفر إليها. فإنه إذ قدَّم توبة صادقة بدموع، لم يعد الله يذكرها،"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "وإن كان قد سمح بتأديبه كي يشعر هو ونحن بمرارة الخطية."
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "مع ما بلغناه من الشر يبقى الله مُنتَّظِرًا توبتنا، واعترافنا بخطايانا، لكي"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "يغفرها لنا من أجل اسمه القدوس ومحبته الفائقة، مؤكدًا لنا: \"أنا أنا هو الماحي"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "ذنوبك لأجل نفسي وخطاياك لا أذكرها؛ ذكِّرني فنتحاكم معًا، حدِّث لكي تتبرر\" (إش 43: 25-26)."
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "يلزمهم أن يحترزوا وأن لا يتوقَّفوا عن تَذَكُّر خطاياهم، وأن يكون ذلك دأبهم في"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الحياة، حتى ينسى الديان العادل آثامهم. لذلك يقول داود ملتمسا: \"استر وجهك عن"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "خطاياي، وامح كل آثامي\" (مز 51: 9). وقبل ذلك بآيات قليلة يقول: \"خطيتي"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "أمامي دائمًا\" (مز 51: 3). وكأنه يقول: \"أتوسل أن لا تنظر إلى آثامي، لأنها"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "أمام نظري دائمًا. لذلك يقول الرب بلسان النبي: \"أنا أنا هو الماحي ذنوبك لأجل"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "نفسي، وخطاياكِ لا أذكرها\" (إش 43: 25)[1]."
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأب غريغوريوس (الكبير)"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "حين تنشغل بخطيةٍ ما، كن متَّهمًا لنفسك ( أم 18: 17)، ولا تنتظر الآخرين"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "ليُقَدِّموا الاتهام. بهذا تصير أشبه بإنسان بارٍ يتَّهم نفسه في أول حديث له في"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "المحكمة، أو تكون كأيوب الذي لم يعقه جمهور الشعب في المدينة عن الإعلان عن جريمته"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "أمام الكل[2]."
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "قول آبائي",
      "father_name": "القديس باسيليوس الكبير",
      "text": "القديس باسيليوس الكبير"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "بحق وحسنًا تسأل الله أن ينصرف عن خطيتك، إن كنتَ أنت نفسك لم تصرف وجهك عنها. أما"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "إذ وضعت خطيتك وراء ظهرك، فإن الله يُثَبِّت وجهه عليها."
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "حوِّل خطيتك لتكون أمام وجهك، إن أردتَ أن يصرف إلهك وجهه عنها، عندئذ في أمان تسأل"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "وهو يسمع لك."
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "لقد انشغلت بالدفاع عن خطاياك، فانهزمت... دفاعك ليس مفيدًا لك. لأن من أنت يا من"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "تدافع عن نفسك؟ كان يليق بك أن تتهم نفسك. لا تقل: \"إنني لم أفعل شيئًا\"، أو \"أي"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "أمر خطير أنا فعلت؟\" أو \"آخرون أيضًا فعلوا هكذا\"."
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "إن فعلتَ خطية وقُلتَ إنك لم تفعل شيئًا تصير أنت نفسك لا شيء، ولا تنال من الله"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "شيئًا!"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله مستعد أن يهب غفرانًا، لكنك أنت تغلق الباب على نفسك!"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله مستعد أن يُعطِي، فلا تقاوم بمزلاج الباب، بل افتح حضن الاعتراف: \"تسمعني"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "سرورًا وفرحًا\"."
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "كشف الله هذه الغوامض لعبده داود؛ فإنه إذ قال أمام النبي مُقتنِعًا: \"أخطأت\"،"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "للحال سمع من النبي، أي من روح الله الذي في النبي: \"قد نقل عنك خطيتك\" (2 صم 12: 13)."
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "قول آبائي",
      "father_name": "القديس أغسطينوس",
      "text": "القديس أغسطينوس"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "من يَتَذَكَّر خطيته على الدوام يخجل، وبخجله يندم، وبندمه يحترس من السقوط مرة"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "أخرى، وباحتراسه يأخذ مغفرة."
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "كل من يتهم نفسه، مُقِرًا بذنبه، تُمحَى خطيته، إذ يقول الله: \"أنا أنا هو الماحي"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "ذنوبك لأجل نفسي، وخطاياك لا أذكرها؛ ذكِّرني فنتحاكم معًا حدِّث لكي تتبرر\" (إش 43: 25-26)."
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأب أنثيموس أسقف أورشليم"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "وجدير بالذكر أن كاتب السفر هنا لمَّح لها فقط بين السطور: \"وكان داود مُقِيمًا"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "في أورشليم\"، ويا ليته كان في الحرب مع جيشه، لكان بعيدًا عن التجربة. ولكن في"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "تَنَعُّمه بالراحة وقع في الخطية، إن سرد خطية داود في الكتاب المقدس هو مثل لأمانة"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "وعدم انحياز كاتبي الأسفار. وتجنب إعادة تفاصيلها هنا بينما كانت الفرصة سانحة"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "لإعادة الكلام عنها فهو لتعليمنا أنه حتى وإن كانت الفرصة مُحِقّة للكلام عن هفوات"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "وأخطاء الآخرين فإننا لا يجب أن نُسَر في تكرار الكلام عنها، فمن الأفضل عدم الكلام"
    },
    {
      "section_title": "1. إقامة داود في أورشليم",
      "content_type": "شرح",
      "father_name": null,
      "text": "عن الأشخاص أو الأعمال إن لم يكن هناك شيء حسن الذكر."
    },
    {
      "section_title": "2. نصرته على بني عمون",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "2 وَأَخَذَ دَاوُدُ تَاجَ مَلِكِهِمْ عَنْ رَأْسِهِ، فَوُجِدَ وَزْنُهُ وَزْنَةً مِنَ الذَّهَبِ، وَفِيهِ حَجَرٌ كَرِيمٌ. فَكَانَ عَلَى رَأْسِ دَاوُدَ. وَأَخْرَجَ غَنِيمَةَ الْمَدِينَةِ وَكَانَتْ كَثِيرَةً جِدًّا. 3 وَأَخْرَجَ الشَّعْبَ الَّذِينَ بِهَا وَنَشَرَهُمْ بِمَنَاشِيرِ وَنَوَارِجِ حَدِيدٍ وَفُؤُوسٍ. وَهكَذَا صَنَعَ دَاوُدُ لِكُلِّ مُدُنِ بَنِي عَمُّونَ. ثُمَّ رَجَعَ دَاوُدُ وَكُلُّ الشَّعْبِ إِلَى أُورُشَلِيمَ."
    },
    {
      "section_title": "2. نصرته على بني عمون",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَأَخَذَ دَاوُدُ تَاجَ مَلِكِهِمْ عَنْ رَأْسِهِ،"
    },
    {
      "section_title": "2. نصرته على بني عمون",
      "content_type": "شرح",
      "father_name": null,
      "text": "فَوُجِدَ وَزْنُهُ وَزْنَةً مِنَ الذَّهَبِ، وَفِيهِ حَجَرٌ كَرِيمٌ."
    },
    {
      "section_title": "2. نصرته على بني عمون",
      "content_type": "شرح",
      "father_name": null,
      "text": "فَكَانَ عَلَى رَأْسِ دَاوُدَ."
    },
    {
      "section_title": "2. نصرته على بني عمون",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَأَخْرَجَ غَنِيمَةَ الْمَدِينَةِ وَكَانَتْ كَثِيرَةً جِدّاً. [2]"
    },
    {
      "section_title": "2. نصرته على بني عمون",
      "content_type": "شرح",
      "father_name": null,
      "text": "نجح يوآب في ضرب بني عمون، وإذ دخل داود إلى أرض المعركة ليُحَقِّق النصرة"
    },
    {
      "section_title": "2. نصرته على بني عمون",
      "content_type": "شرح",
      "father_name": null,
      "text": "النهائية، أخذ تاج ملكها فوجد وزنه وزنة من الذهب، أي حوالي خمسة وسبعون رطلاً"
    },
    {
      "section_title": "2. نصرته على بني عمون",
      "content_type": "شرح",
      "father_name": null,
      "text": "ونصف، وهو ثقيل. حقًا كل التيجان ثقيلة، فإن مسئوليات القائد لأيّة دولة ليست"
    },
    {
      "section_title": "2. نصرته على بني عمون",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالأمر الهَيِّن."
    },
    {
      "section_title": "2. نصرته على بني عمون",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَأَخْرَجَ الشَّعْبَ الَّذِينَ بِهَا،"
    },
    {
      "section_title": "2. نصرته على بني عمون",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَنَشَرَهُمْ بِمَنَاشِيرَ وَنَوَارِجِ حَدِيدٍ وَفُؤُوسٍ."
    },
    {
      "section_title": "2. نصرته على بني عمون",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَهَكَذَا صَنَعَ دَاوُدُ لِكُلِّ مُدُنِ بَنِي عَمُّونَ."
    },
    {
      "section_title": "2. نصرته على بني عمون",
      "content_type": "شرح",
      "father_name": null,
      "text": "ثُمَّ رَجَعَ دَاوُدُ وَكُلُّ الشَّعْبِ إِلَى أُورُشَلِيمَ. [3]"
    },
    {
      "section_title": "2. نصرته على بني عمون",
      "content_type": "شرح",
      "father_name": null,
      "text": "ربما تُشِير العبارة هنا إلى رجال الحرب وحدهم. يرى البعض أن الشعب كان تحت تكليف"
    },
    {
      "section_title": "2. نصرته على بني عمون",
      "content_type": "شرح",
      "father_name": null,
      "text": "لعمل جبري."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "4 ثُمَّ بَعْدَ ذلِكَ قَامَتْ حَرْبٌ فِي جَازِرَ مَعَ الْفِلِسْطِينِيِّينَ. حِينَئِذٍ سَبْكَايُ الْحُوشِيُّ قَتَلَ سَفَّايَ مِنْ أَوْلاَدِ رَافَا فَذَلُّوا. 5 وَكَانَتْ أَيْضًا حَرْبٌ مَعَ الْفِلِسْطِينِيِّينَ، فَقَتَلَ أَلْحَانَانُ بْنُ يَاعُورَ لَحْمِيَ أَخَا جُلْيَاتَ الْجَتِّيِّ. وَكَانَتْ قَنَاةُ رُمْحِهِ كَنَوْلِ النَّسَّاجِينَ. 6 ثُمَّ كَانَتْ أَيْضًا حَرْبٌ فِي جَتَّ، وَكَانَ رَجُلٌ طَوِيلُ الْقَامَةِ أَعْنَشُ، أَصَابِعُهُ أَرْبَعٌ وَعِشْرُونَ، وَهُوَ أَيْضًا وُلِدَ لِرَافَا. 7 وَلَمَّا عَيَّرَ إِسْرَائِيلَ ضَرَبَهُ يَهُونَاثَانُ بْنُ شِمْعَا أَخِي دَاوُدَ. 8 هؤُلاَءِ وُلِدُوا لِرَافَا فِي جَتَّ وَسَقَطُوا بِيَدِ دَاوُدَ وَبِيَدِ عَبِيدِهِ."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "ثُمَّ بَعْدَ ذَلِكَ قَامَتْ حَرْبٌ فِي جَازِرَ مَعَ الْفِلِسْطِينِيِّينَ."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "حِينَئِذٍ سَبْكَايُ الْحُوشِيُّ قَتَلَ سَفَّايَ مِنْ أَوْلاَدِ رَافَا فَذَلُّوا."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "قتل ثلاثة من جبابرة داود بواسطة الأعداء."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "جاءت قصة أمنون وأبشالوم ما بين [3-4]، وتمرُّد أبشالوم على أبيه ورد ذلك (2 صم 13: 1-21: 7)، والتي احتلت حوالي ثلث سفر صموئيل الثاني، والتي لم ترد في سفر أخبار"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأيام الأول. فإن ما يهدف إليه سفرا أخبار الأيام ليس عرض أحداث التاريخ كاملة، بل"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "الربط بين التاريخ والعبادة."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "لقد قُرِضَ الفلسطينيون الوثنيون تقريبًا (1 أي 18: 1) ولكن كما حدث في تحطيم الكنعانيين على يدي يشوع حيث بنو عناق قُرِضوا أخيرًا (يش 11: 21). فهنا كذلك في"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "الانتصار على الفلسطينيين قُهِر عمالقة جت في النهاية. كذلك في الاشتباك بين النعمة"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "والفساد، توجد بعض الخطايا المتأصلة مثل هؤلاء العمالقة ولا يمكن التغلُّب عليها"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "إلاَّ بعد كفاح طويل، ولكن أخيرًا الحكم يأتي بالنصر."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَكَانَتْ أَيْضًا حَرْبٌ مَعَ الْفِلِسْطِينِيِّينَ،"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "فَقَتَلَ أَلْحَانَانُ بْنُ يَاعُورَ لَحْمِيَ أَخَا جُلْيَاتَ الْجَتِّيِّ."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَكَانَتْ قَنَاةُ"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "رُمْحِهِ كَنَوْلِ النَّسَّاجِينَ. [5]"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "لم نسمع قط عن عمالقة بين الإسرائيليين مثل عمالقة الفلسطينيين، فهناك عمالقة في"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "جت، ولكن ليس من عمالقة في أورشليم، فالنمو في أبناء الله هو في القامة الروحية"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "وليس في القامة الجسمية، فهؤلاء الذين يشتهون زيادة أشبار على قامتهم، لا يدركون"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "أنها ستجعلهم أكثر ضخامة بلا فائدة، ففي ميزان القداسة زاد داود على جليات."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "ثُمَّ كَانَتْ أَيْضًا حَرْبٌ فِي جَتَّ،"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَكَانَ رَجُلٌ طَوِيلُ الْقَامَةِ"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "أَعْنَشُ،"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "أَصَابِعُهُ أَرْبَعٌ وَعِشْرُونَ،"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَهُوَ أَيْضًا وُلِدَ لِرَافَا. [6]"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "مع أن"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "رجال داود كانوا ذوي قامة عادية إلاَّ أنهم بمعونة الله التي ساندتهم، كانوا"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "أكثر صلابة في كل مقاومتهم لعمالقة جت. فالله يُسَرُّ في خفض النظرات المتعالية"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "وإماتة العمالقة الذين على الأرض، كما غطَّى قديمًا بالفيضان المُعتدِّين بأنفسهم،"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "فلا يجب أن يجزع أحباء الكنيسة من قوة وتشامخ الأعداء، فإن كان الله معنا فمن"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "علينا، فماذا يصنع بضخامة أو زيادة أصبع في كل يد أو في كل رجل بالمقارنة بالقدرة"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "الكلية؟"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَلَمَّا عَيَّرَ إِسْرَائِيلَ ضَرَبَهُ يَهُونَاثَانُ بْنُ شَمْعِي أَخِي دَاوُدَ."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "هؤلاء العمالقة عيَّروا إسرائيل [7] ولذلك دفعوا ثمن عجرفتهم، فالذين يُعَيِّرون"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله وإسرائيل الله يرون خرابهم أكثر عيانًا، فالله يعمل أعمالاً عظيمة ولا يسمح"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "للعدو أن يقول إن يده ارتفعت (تث 32: 27)."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "انتصارات ابن داود تدريجية كالتي لداود نفسه، [فنحن لا نرى بعد كل شيء مُخضَعُ له](*)،"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "ولكن سنراه قريبًا [فالموت نفسه العدو الأخير سيُقْهر](**)"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "كهؤلاء العمالقة تمامًا."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "هَؤُلاَءِ وُلِدُوا لِرَافَا فِي جَتَّ،"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَسَقَطُوا بِيَدِ دَاوُدَ وَبِيَدِ عَبِيدِهِ. [8]"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "من وحي 1 أي 20"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "بك أخرج إلى أرض المعركة"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "خرج داود في موسم الحروب ليُحَقِّق بك النصرة الكاملة."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "انطلق للمعركة مُتسلِّحًا بك،"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "وليس بأبطاله وخططه وإمكانياته العسكرية."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "إن كان العدو لا يكف عن مقاومتي،"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "فأنت هو سلاحي، وقائدي، وواهب النصرة لي."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "خطاياي تفسد حياتي،"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "لكنني، إذ أعترف لك بها طالبًا أن تشفيني،"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "تغفرها بدمك الثمين وحُبِّك، ولا تعود تذكرها."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "مع كل نصرةٍ، أُقَدِّم لك ذبيحة الشكر والتسبيح."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "وأطلب عونًا إضافيًّا،"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "لأن العدو لن يتوقَّف ولا ييأس."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "ومع كل نصرة، يشعل الحرب عليَّ بأكثر عنفٍ."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "لكن ماذا يستطيع هذا الشرير أن يفعل،"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "ما دُمتُ مختفيًا فيك، ومُتمتِّعًا بحضورك الإلهي؟"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "ما أكثر حيل إبليس وخداعاته،"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "وما أكثر قواته الشريرة التي تتهلل لسقوطنا!"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "لكنه في غباوة يحارب المؤمنين."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "إنه يحاربك شخصيًا، فيُحَطِّم نفسه."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "كلما أعدَّ لي شبكة، يسقط هو فيها."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "وكلما ظن أنه يمحو اسمك من قلبي وفكري،"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "تتجلَّى أنت بالأكثر في داخلي،"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "وتُعلِن بهاء ملكوتك وعظمته."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "لك المجد يا أيها العجيب في قيادتك ورعايتك وحُبِّك!"
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "Pastoral Care, 3:29."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "On Humility."
    },
    {
      "section_title": "3. نصرته على الفلسطينيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "(*)(**) إضافة من الموقع: عن الآيات (عب 2: 8، 14)."
    },
    {
