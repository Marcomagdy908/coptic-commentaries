      "verses": ""
    },
    {
      "number": 4,
      "title": "سرّ قوته ونجاحه",
      "verses": ""
    },
    {
      "number": 5,
      "title": "مُدَّة حكمه وموته",
      "verses": "7- 9"
    }
  ],
  "sections_count": 276,
  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "اَلأَصْحَاحُ السَّابِعُ وَالْعِشْرُونَ"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "يُعتبَر هذا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الأصحاح أصغر الأصحاحات الواردة في سفريّ أخبار اليوم. مع مدحه لشخصية يوثام التقي،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "غير أن الشعب كانوا يُفسِدون في بيت الرب، ولم يُقَدِّم لنا الكتاب تعليلاً لعدم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "قدرة يوثام على قيادة الشعب في طريق التقوى."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "لا يوجد الكثير"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "في حياة هذا الملك، فقد اكتفى السفر بما ورد عنه في (2 مل 15: 32)."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "إذ أفسد الشعب"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "نفسه في أيام يوثام، وسقطوا تحت التأديب بالرغم من تقوى الملك، صارت الحاجة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مُلِحَّة لإعادة تأسيس العبادة في يهوذا بعد أن تركوها."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "من وحي 2 أي 27: لتحمل الكل"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "على ذراعيك يا مُخَلِّص العالم!"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "المستقيم في عينيّ الرب"
    },
    {
      "section_title": "1. عمل",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "1 كَانَ يُوثَامُ ابْنَ خَمْسٍ وَعِشْرِينَ سَنَةً حِينَ مَلَكَ، وَمَلَكَ سِتَّ عَشَرَةَ سَنَةً فِي أُورُشَلِيمَ، وَاسْمُ أُمِّهِ يَرُوشَةُ بِنْتُ صَادُوقَ. 2 وَعَمِلَ الْمُسْتَقِيمَ فِي عَيْنَيِ الرَّبِّ حَسَبَ كُلِّ مَا عَمِلَ عُزِّيَّا أَبُوهُ، إِلاَّ أَنَّهُ لَمْ يَدْخُلْ هَيْكَلَ الرَّبِّ. وَكَانَ الشَّعْبُ يُفْسِدُونَ بَعْدُ."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "كَانَ يُوثَامُ"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "ابْنَ خَمْسٍ وَعِشْرِينَ سَنَةً حِينَ مَلَكَ،"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَمَلَكَ سِتَّ"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "عَشَرَةَ سَنَةً فِي أُورُشَلِيمَ،"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَاسْمُ"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "أُمِّهِ يَرُوشَةُ بِنْتُ صَادُوقَ. [1]"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "في (2 مل 15: 32-38) نجد حديثًا مختصرًا عن مُلْكِ يوثام. نحن نعلم أنه شارك والده في الحُكْمِ"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "لمدة حوالي تسع سنوات (750-742 ق.م)، وملك منفردًا (742-735 ق.م.)، فالست عشرة"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "سنة تضم المُدَّتين معًا."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَعَمِلَ"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "الْمُسْتَقِيمَ فِي عَيْنَيِ الرَّبِّ حَسَبَ كُلِّ مَا عَمِلَ عُزِّيَّا أَبُوهُ،"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "(إِلاَّ"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "أَنَّهُ لَمْ يَدْخُلْ هَيْكَلَ الرَّبِّ)."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَكَانَ"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "الشَّعْبُ يُفْسِدُونَ بَعْدُ. [2]"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "يشهد الكتاب"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "المقدس عن يوثام أنه تَمَثَّل بأبيه في كل عملٍ صالحٍ قام به، وفي نفس الوقت بحكمةٍ"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "وتدبيرٍ حسنٍ، فلم يسقط فيما سقط فيه أبوه، إذ لم يقتحم القدس، ولا اغتصب لنفسه ما"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "هو خاص بالكهنة. كان حذرًا جدًا"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "من السقوط مثل أبيه."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "لعل سنده في"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "ذلك ما قَدَّمه زكريا من معرفة لأبيه، كما انتفع من ميخا النبي الذي بدأ نبوّته"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "أثناء حكمه (مي 2: 7)."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "بلا شك كانت معرفته للأسرار الإلهية أقل مما كان لأبيه، غير أنه حَوَّل المعرفة إلى"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "عمل بالنعمة الإلهية."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "فالمعرفة"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "ضرورية للغاية، لكنها لا تقف عند العقل وحده. فمع كونها عطية الله العظيمة، لكن"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "بدون الله باطلة، وبنعمة الله يتقدس العقل، فيدرك وصايا الله ويمارسها، بلا فصل"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "بين العقل والقلب والحياة، إذ كلها متداخلة مترابطة ببعضها. فالمعرفة الحقيقية"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "ليست نظرية بحتة، بل راسخة في القلب، ومتجسدة في الحياة[1]."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "غير أن نقطة"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "الضعف في حياة يوثام الملك هي عدم تَمَتُّعِه بالروح القيادية الرعوية اللائقة به"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "كملكٍ تقيٍ، بل وكمؤمنٍ. فإن من يلتصق بالله مُحِب البشرية يشتهي خلاص الكل، ويطلب"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "من أجل مجد الكل."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "يريد البعض أن يضعوا حدودًا للحب بأفريقيا! إن أَردتَ أن تُحِبَّ المسيح، فابسط يدك"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالحب على كل العالم، لأن أعضاء المسيح منتشرة في العالم كله[2]."
    },
    {
      "section_title": "1. عمل",
      "content_type": "قول آبائي",
      "father_name": "القديس أغسطينوس",
      "text": "القديس أغسطينوس"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "حيث أن الحُبَّ الحقيقي هو أن نحب الكل، فإن عرف أحد أنه يبغض ولو شخصًا واحدًا"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "يلزمه أن يسرع ويتقيأ هذه اللقمة المُرَّة، حتى يتهيأ لقبول عذوبة الحب نفسه[3]."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأب قيصريوس أسقف آرل"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "انظر، فإنه يُقَال إننا نحب بعضنا بعضًا. ولكن إن"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "كان أحد له صديقان وآخر له ثلاثة، فإن هذا ليس حبًا من أجل الإله، بل من أجل"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "المحبوبين."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "الحُبُّ الذي"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "من أجل الإله لا يحمل هذا كأساسٍ للحب، بل كإنسانٍ يميل نحو كل البشرية، يحب من لهم"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "إيمانه بكونهم إخوة حقيقيين، ويحب الهراطقة والوثنيين واليهود[4]،"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "بكونهم إخوة بالطبيعة متأسفًا عليهم عاملاً بتعبٍ وباكيًا من أجلهم."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "بهذا نكون على"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "مثال الله لا بصنع أعمال عجيبة، بل إن أحببنا كل البشر حتى أعداءنا."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "إننا ندهش من"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله إذ يظهر عجائب، وبالأكثر جدًا عندما يُظهِر حبًا للإنسان، عندما يظهر طول"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "أناته علينا."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "إن كان هذا"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "يستحق الإعجاب في الله، فكم بالأولى يستحق البشر الإعجاب (بحبهم للجميع)[5]."
    },
    {
      "section_title": "1. عمل",
      "content_type": "قول آبائي",
      "father_name": "القديس يوحنا ذهبي الفم",
      "text": "القديس يوحنا الذهبي الفم"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "مع سلوك الملك"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "فيما هو مستقيم في عينيّ الرب، وتحاشيه ما سقط فيه والده، كان ملومًا، إذ لم"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "يهتم بإصلاح أخطاء الشعب، إذ قيل: \"وكان الشعب يفسدون بعد\". لقد قَدَّم"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "تعاليم صالحة، بالقدوة لهم، لكنه لم يتحرَّك بقوة لإصلاح أخطائهم. ولعله كان عاجزًا"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "عن العمل في أمةٍ كانت غير أمينة؛ هذا ما نلمسه من سفريّ إشعياء وميخا."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "عندما سُئِل"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "يوحنا المعمدان: \"من أنت؟\" كنا نظنه يقول:"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"أنا الذي جاء جبرائيل الواقف أمام عرش الله مبشرًا أبي بمولدي\"، أو \"أنا هو الملاك"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "الذي يُهيِّئ الطريق قدَّام المسيَّا المنتظر\". لكنَّه ما قال هذا ولا ذاك، بل قال:"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"أنا صوت صارخ في البرية، أَعدُّوا طريق الرب...\" هذه هي رسالة القائد أن"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "يكون قادرًا على التعليم، يُعلِن صوت الرب عاليًا، ويكشف شريعة الرب لأولاده أو"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "لشعب الله، وأن يُعلِّم إخوته كيف يحيُّون!"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "فالله الحكمة"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "ذاته ومُعلِّم المسكونة، يريد من القادة أن يتعلَّموا ويُعَلِّموا حتى لا يهلكوا،"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "ولا يُهلِكوا الآخرين."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "هذا هو المميز"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "بين الراعي والرعيَّة، أن الراعي قادر أن يُعَلِّمَ الآخرين طريق الرب."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "لم تكن له شركة"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "مع المرتفعات، غير أنه لم ينزعها. كان الشعب يفسدون، لذلك كان ميخا يتحدَّث عن"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "القضاء بخصوص الشعب وقادته دون ذكر للملك الذي لم يشترك معهم في شرورهم."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "فيما يلي صورة"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "لأحاديث ميخا النبي عن القضاء بخصوص خطايا يهوذا، تكشف عن فساد الشعب والرؤساء"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "والقضاة والأنبياء الكذبة دون ذكر الملك: \"أنوح وأولول، أمشي حافيًا وعريانًا،"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "أصنع نحيبًا كبنات آوى ونوحًا كرعال النعام. لأن جراحاتها عديمة الشفاء، لأنها قد"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "أتت إلى يهوذا، وصلت إلى باب شعبي إلى أورشليم\" (مي 1: 8-9)."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"فإنهم يشتهون"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "الحقول ويغتصبونها، والبيوت ويأخذونها، ويظلمون الرجل وبيته، والإنسان وميراثه..."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "ولكن بالأمس قام شعبي كعدوٍ تنزعون الرداء عن الثوب من المجتازين"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالطمأنينة، ومن الراجعين من القتال. تطردون نساء شعبي من بيت تنعمهن، تأخذون عن"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "أطفالهن زينتي إلى الأبد. قوموا واذهبوا، لأنه ليست هذه هي الراحة. من أجل نجاسة"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "تهلك والهلاك شديد\" (مي 2: 2، 8-10)."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"وَقُلْتُ: «اسْمَعُوا يَا رُؤَسَاءَ يَعْقُوبَ، وَقُضَاةَ بَيْتِ إِسْرَائِيلَ. أَلَيْسَ لَكُمْ أَنْ تَعْرِفُوا الْحَقَّ؟ الْمُبْغِضِينَ الْخَيْرَ وَالْمُحِبِّينَ الشَّرَّ، النَّازِعِينَ جُلُودَهُمْ عَنْهُمْ، وَلَحْمَهُمْ عَنْ عِظَامِهِمْ. وَالَّذِينَ يَأْكُلُونَ لَحْمَ شَعْبِي، وَيَكْشُطُونَ جِلْدَهُمْ عَنْهُمْ، وَيُهَشِّمُونَ عِظَامَهُمْ، وَيُشَقِّقُونَ كَمَا فِي الْقِدْرِ، وَكَاللَّحْمِ فِي وَسَطِ الْمِقْلَى». هكَذَا قَالَ الرَّبُّ عَلَى الأَنْبِيَاءِ الَّذِينَ يُضِلُّونَ شَعْبِي، الَّذِينَ يَنْهَشُونَ بِأَسْنَانِهِمْ، وَيُنَادُونَ: «سَلاَمٌ»! وَالَّذِي لاَ يَجْعَلُ فِي أَفْوَاهِهِمْ شَيْئًا، يَفْتَحُونَ عَلَيْهِ حَرْبًا: «لِذلِكَ تَكُونُ لَكُمْ لَيْلَةٌ بِلاَ رُؤْيَا. ظَلاَمٌ لَكُمْ بِدُونِ عِرَافَةٍ. وَتَغِيبُ الشَّمْسُ عَنِ الأَنْبِيَاءِ، وَيُظْلِمُ عَلَيْهِمِ النَّهَارُ. (مي 3: 1-3، 5-6)"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"اسمعي خصومة"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرب أيتها الجبال ويا أسس الأرض الدائمة، فان للرب خصومة مع شعبه، وهو"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "يحاكم إسرائيل (مي 6: 2)."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "قد باد التقي"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "من الأرض وليس مستقيم بين الناس، جميعهم يكمنون للدماء، يصطادون بعضهم بعضا بشبكة."
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "اليدان إلى الشر مجتهدتان، الرئيس طالب، والقاضي بالهدية، والكبير"
    },
    {
      "section_title": "1. عمل",
      "content_type": "شرح",
      "father_name": null,
      "text": "متكلم بهوى نفسه فيعكشونها (مي 7: 2-3)."
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "3 هُوَ بَنَى الْبَابَ الأَعْلَى لِبَيْتِ الرَّبِّ، وَبَنَى كَثِيرًا عَلَى سُورِ الأَكَمَةِ. 4 وَبَنَى مُدُنًا فِي جَبَلِ يَهُوذَا، وَبَنَى فِي الْغَابَاتِ قِلَعًا وَأَبْرَاجًا."
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "هُوَ بَنَى"
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "الْبَابَ الأَعْلَى لِبَيْتِ الرَّبِّ،"
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَبَنَى"
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "كَثِيرًا عَلَى سُورِ الأَكَمَةِ. [3]"
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "إن كان أبوه"
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "عُزِّيا قد بني أبراجًا لحماية المدينة (2 أي 26: 9)، فإن يوثام ابنه أكمل"
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "التحصينات التي أهملها أبوه، فقام بتحصين بيت الرب."
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "أشار في"
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "(2 مل 15)"
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "إلى بنائه الباب الأعلى لبيت الرب، وقام بتزيينه، وهنا قَدَّم شيئًا من التفصيل عن"
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "مشروعاته في البناء، وبنى الكثير على سور الأكمة."
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَبَنَى"
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "مُدُنًا فِي جَبَلِ يَهُوذَا،"
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَبَنَى فِي"
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "الْغَابَاتِ قِلَعًا وَأَبْرَاجًا. [4]"
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "اهتم"
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالإنشاءات، فبنى مدنًا على جبل يهوذا. اهتم بتحصين بلاده وتجديدها."
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "لم تكن له شركة"
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "مع المرتفعات، غير أنه لم ينزعها. كان الشعب يفسدون [2]، لذلك كان ميخا يتحدَّث عن"
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "القضاء بخصوص الشعب وقادته، دون ذكر للملك الذي لم يشترك معهم في شرورهم."
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "وستجد"
    },
    {
      "section_title": "2. إنشاءاته",
      "content_type": "شرح",
      "father_name": null,
      "text": "تفاسير أخرى"
    },
    {
      "section_title": "3. نصرته على",
      "content_type": "شرح",
      "father_name": null,
      "text": "بني عمون"
    },
    {
      "section_title": "3. نصرته على",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَهُوَ حَارَبَ"
    },
    {
      "section_title": "3. نصرته على",
      "content_type": "شرح",
      "father_name": null,
      "text": "مَلِكَ بَنِي عَمُّونَ وَقَوِيَ عَلَيْهِمْ،"
    },
    {
      "section_title": "3. نصرته على",
      "content_type": "شرح",
      "father_name": null,
      "text": "فَأَعْطَاهُ"
    },
    {
      "section_title": "3. نصرته على",
      "content_type": "شرح",
      "father_name": null,
      "text": "بَنُو عَمُّونَ فِي تِلْكَ السَّنَةِ،"
    },
    {
      "section_title": "3. نصرته على",
      "content_type": "شرح",
      "father_name": null,
      "text": "مِئَةَ"
    },
    {
      "section_title": "3. نصرته على",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَزْنَةٍ مِنَ الْفِضَّةِ وَعَشَرَةَ آلاَفِ كُرِّ قَمْحٍ وَعَشَرَةَ آلاَفٍ مِنَ"
    },
    {
      "section_title": "3. نصرته على",
      "content_type": "شرح",
      "father_name": null,
      "text": "الشَّعِيرِ."
    },
    {
      "section_title": "3. نصرته على",
      "content_type": "شرح",
      "father_name": null,
      "text": "هَذَا مَا"
    },
    {
      "section_title": "3. نصرته على",
      "content_type": "شرح",
      "father_name": null,
      "text": "أَدَّاهُ لَهُ بَنُو عَمُّونَ، وَكَذَلِكَ فِي السَّنَةِ الثَّانِيَةِ"
    },
    {
      "section_title": "3. نصرته على",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَالثَّالِثَةِ. [5]"
    },
    {
      "section_title": "4. سرُّ قوته",
      "content_type": "شرح",
      "father_name": null,
      "text": "ونجاحه"
    },
    {
      "section_title": "4. سرُّ قوته",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَتَشَدَّدَ"
    },
    {
      "section_title": "4. سرُّ قوته",
      "content_type": "شرح",
      "father_name": null,
      "text": "يُوثَامُ،"
    },
    {
      "section_title": "4. سرُّ قوته",
      "content_type": "شرح",
      "father_name": null,
      "text": "لأَنَّهُ"
    },
    {
      "section_title": "4. سرُّ قوته",
      "content_type": "شرح",
      "father_name": null,
      "text": "هَيَّأَ طُرُقَهُ أَمَامَ الرَّبِّ إِلَهِهِ. [6]"
    },
    {
      "section_title": "4. سرُّ قوته",
      "content_type": "شرح",
      "father_name": null,
      "text": "يُمتدَح يوثام"
    },
    {
      "section_title": "4. سرُّ قوته",
      "content_type": "شرح",
      "father_name": null,
      "text": "على الأقل من أجل عدم اقتدائه بأبيه الذي اغتصب حقوق خاصة بالهيكل [2]. كما قيل عنه"
    },
    {
      "section_title": "4. سرُّ قوته",
      "content_type": "شرح",
      "father_name": null,
      "text": "إنه تشدَّد، لأنه هيَّأ طرقه أمام الرب إلهه [6]، الأمر الذي يندر أن يُقَال عن"
    },
    {
      "section_title": "4. سرُّ قوته",
      "content_type": "شرح",
      "father_name": null,
      "text": "الملوك المذكورين في الكتاب المقدس."
    },
    {
      "section_title": "4. سرُّ قوته",
      "content_type": "شرح",
      "father_name": null,
      "text": "برزت تقوى"
    },
    {
      "section_title": "4. سرُّ قوته",
      "content_type": "شرح",
      "father_name": null,
      "text": "يوثام في حمايته لبيت الرب، فإن كان عُزِّيا فد بَنَى أبراجًا لحماية المدينة (2 أخ 26: 9)، فإن يوثام بنى أبراجًا لحماية الهيكل."
    },
    {
      "section_title": "4. سرُّ قوته",
      "content_type": "شرح",
      "father_name": null,
      "text": "أكمل يوثام"
    },
    {
      "section_title": "4. سرُّ قوته",
      "content_type": "شرح",
      "father_name": null,
      "text": "أعمال التحصينات التي أهملها أبوه [3-4]. وكانت تقواه هي مصدر قوته."
    },
    {
      "section_title": "4. سرُّ قوته",
      "content_type": "شرح",
      "father_name": null,
      "text": "لم يذكر أخبار"
    },
    {
      "section_title": "4. سرُّ قوته",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأيام ما ورد في (2 مل 15: 26)، عن إرسال الله رصين ملك أرام وفقح بن رمليا على"
    },
    {
      "section_title": "4. سرُّ قوته",
      "content_type": "شرح",
      "father_name": null,
      "text": "يهوذا، لأن إرسال هؤلاء الأعداء ليس من أجل الملك التقي، بل من أجل الشعب."
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "وموته"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَبَقِيَّةُ"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "أُمُورِ يُوثَامَ وَكُلُّ حُرُوبِهِ وَطُرُقِهِ،"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "مَكْتُوبَةٌ"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "فِي سِفْرِ مُلُوكِ إِسْرَائِيلَ وَيَهُوذَا. [7]"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "كَانَ ابْنَ"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "خَمْسٍ وَعِشْرِينَ سَنَةً حِينَ مَلَكَ،"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَمَلَكَ سِتَّ"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "عَشَرَةَ سَنَةً فِي أُورُشَلِيمَ. [8]"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "ثُمَّ"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "اضْطَجَعَ يُوثَامُ مَعَ آبَائِهِ،"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "فَدَفَنُوهُ"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "فِي مَدِينَةِ دَاوُدَ،"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَمَلَكَ"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "آحَازُ ابْنُهُ عِوَضًا عَنْهُ. [9]"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "انتهى حُكْمَه"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "في وقتٍ قصيرٍ، لكنه أنهاه بكرامةٍ. مع أنه مات في منتصف عمره، حسب تعبير العامة،"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "غير أنه عاش سعيدًا ومات مُكَرَّمًا."
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "من وحي 2 أي 27"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "لتحمل الكل"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "على ذراعيك يا مُخَلِّص العالم!"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "لك المجد يا من أنقذت يوثام من خطأ أبيه عُزِّيا."
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "وهبتَه نعمتك،"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "من أجل التصاقه بك،"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "فسلك بروح"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "الاستقامة أمام عينيك."
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "لم ينحرف كأبيه"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "ليغتصب كرامة ليست له!"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "هَبْ لي روح الاستقامة، فإني ضعيف وعاجز!"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَسِّعْ تخوم"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "قلبي، فأشتهي خلاص العالم كله!"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "من يقدر أن"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "يحمل البشرية، ويصعد بها سواك؟!"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "في ضعفي أصرخ"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "إليك، لأن نفسي مُرَّة من أجل التائهين عن الطريق."
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "اقبل كل صلاةٍ"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "وصومٍ وسجودٍ أمامك من أجل إخوتي."
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "إني آخر الكل، وأضعف الجميع."
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "لكن نفسي تئن"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "من أجل إخوتي في البشرية."
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "أنت وحدك تعمل"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "بروحك القدوس فيهم وفيَّ."
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "إني محتاج إلى"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "خلاصك ونعمتك."
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "هَبْ لإخوتي"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "كما لضعفي النصرة بك، فأتهلل بأكاليلهم!"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "لأبسط يدي معك على الصليب،"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "فأحتضن كل نفسٍ"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "ساقطة وأُقَدِّمها إليك!"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "مع كل نفس تقوم"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "بنعمتك، تقوم أيضًا نفسي معها."
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "اجذبني وراءك"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "فنجري كلنا إليك."
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "كم تشتهي نفسي"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "ألا يهلك أحد من البشر؟!"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "متى تأتي يا مخلصي على السحاب،"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "وتنضم كنيستك"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "التي من آدم إلى آخر الدهور؟"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "يفرح بها"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "خُدَّامك السمائيون،"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "ويشترك"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأرضيون معهم في التسبيح لك."
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "قول آبائي",
      "father_name": "القديس باسيليوس الكبير",
      "text": "د. جورج عوض إبراهيم: القديس باسيليوس الكبير، المركز الأرثوذكسي للدراسات"
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "الآبائية بالقاهرة."
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "Tr., on 1 John 10:8."
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "Sermons 23:4."
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "تُمَيِّز الكنيسة بين محبة الإنسان لعدوه الشخصي وبين أمانته لوطنه."
    },
    {
      "section_title": "5. مدة حكمه",
      "content_type": "شرح",
      "father_name": null,
      "text": "In Hebr. 3: 11."
    },
