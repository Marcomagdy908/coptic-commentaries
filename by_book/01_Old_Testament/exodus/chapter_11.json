      "father_name": null,
      "text": "الحادي عشر والثاني عشر"
    },
    {
      "section_title": null,
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "1 ثُمَّ قَالَ الرَّبُّ لِمُوسَى: «ضَرْبَةً وَاحِدَةً أَيْضًا أَجْلِبُ عَلَى فِرْعَوْنَ وَعَلَى مِصْرَ. بَعْدَ ذلِكَ يُطْلِقُكُمْ مِنْ هُنَا. وَعِنْدَمَا يُطْلِقُكُمْ يَطْرُدُكُمْ طَرْدًا مِنْ هُنَا بِالتَّمَامِ. 2 تَكَلَّمْ فِي مَسَامِعِ الشَّعْبِ أَنْ يَطْلُبَ كُلُّ رَجُل مِنْ صَاحِبِهِ، وَكُلُّ امْرَأَةٍ مِنْ صَاحِبَتِهَا أَمْتِعَةَ فِضَّةٍ وَأَمْتِعَةَ ذَهَبٍ». 3 وَأَعْطَى الرَّبُّ نِعْمَةً لِلشَّعْبِ فِي عُيُونِ الْمِصْرِيِّينَ. وَأَيْضًا الرَّجُلُ مُوسَى كَانَ عَظِيمًا جِدًّا فِي أَرْضِ مِصْرَ فِي عِيُونِ عَبِيدِ فِرْعَوْنَ وَعُيُونِ الشَّعْبِ. 4 وَقَالَ مُوسَى: «هكَذَا يَقُولُ الرَّبُّ: إِنِّي نَحْوَ نِصْفِ اللَّيْلِ أَخْرُجُ فِي وَسَطِ مِصْرَ، 5 فَيَمُوتُ كُلُّ بِكْرٍ فِي أَرْضِ مِصْرَ، مِنْ بِكْرِ فِرْعَوْنَ الْجَالِسِ عَلَى كُرْسِيِّهِ إِلَى بِكْرِ الْجَارِيَةِ الَّتِي خَلْفَ الرَّحَى، وَكُلُّ بِكْرِ بَهِيمَةٍ. 6 وَيَكُونُ صُرَاخٌ عَظِيمٌ فِي كُلِّ أَرْضِ مِصْرَ لَمْ يَكُنْ مِثْلُهُ وَلاَ يَكُونُ مِثْلُهُ أَيْضًا. 7 وَلكِنْ جَمِيعُ بَنِي إِسْرَائِيلَ لاَ يُسَنِّنُ كَلْبٌ لِسَانَهُ إِلَيْهِمْ، لاَ إِلَى النَّاسِ وَلاَ إِلَى الْبَهَائِمِ. لِكَيْ تَعْلَمُوا أَنَّ الرَّبَّ يُمَيِّزُ بَيْنَ الْمِصْرِيِّينَ وَإِسْرَائِيلَ. 8 فَيَنْزِلُ إِلَيَّ جَمِيعُ عَبِيدِكَ هؤُلاَءِ، وَيَسْجُدُونَ لِي قَائِلِينَ: اخْرُجْ أَنْتَ وَجَمِيعُ الشَّعْبِ الَّذِينَ فِي أَثَرِكَ. وَبَعْدَ ذلِكَ أَخْرُجُ». ثُمَّ خَرَجَ مِنْ لَدُنْ فِرْعَوْنَ فِي حُمُوِّ الْغَضَبِ. 9 وَقَالَ الرَّبُّ لِمُوسَى: «لاَ يَسْمَعُ لَكُمَا فِرْعَوْنُ لِكَيْ تَكْثُرَ عَجَائِبِي فِي أَرْضِ مِصْرَ». 10 وَكَانَ مُوسَى وَهَارُونُ يَفْعَلاَنِ كُلَّ هذِهِ الْعَجَائِبِ أَمَامَ فِرْعَوْنَ، وَلكِنْ شَدَّدَ الرَّبُّ قَلْبَ فِرْعَوْنَ، فَلَمْ يُطْلِقْ بَنِي إِسْرَائِيلَ مِنْ أَرْضِهِ."
    },
    {
      "section_title": "أ. يرى",
      "content_type": "قول آبائي",
      "father_name": "العلامة ترتليان",
      "text": "العلامة ترتليان أن"
    },
    {
      "section_title": "أ. يرى",
      "content_type": "شرح",
      "father_name": null,
      "text": "المصريين قد دفعوا ثمن ما فعلوه بقتلهم أولاد العبرانيين وإلقائهم في النهر،"
    },
    {
      "section_title": "أ. يرى",
      "content_type": "شرح",
      "father_name": null,
      "text": "فأدبهم الرب بذات فعلهم."
    },
    {
      "section_title": "أ. يرى",
      "content_type": "شرح",
      "father_name": null,
      "text": "ب. سمح الله بقتل جميع الأبكار، ولا تترك"
    },
    {
      "section_title": "أ. يرى",
      "content_type": "شرح",
      "father_name": null,
      "text": "ماشية واحدة في مصر، هذه صورة رمزية لعمل الله الذي سيُبيد الشر، أما أولاده فحتى"
    },
    {
      "section_title": "أ. يرى",
      "content_type": "شرح",
      "father_name": null,
      "text": "شعور رؤوسهم محصاة وتحت رعايته."
    },
    {
      "section_title": "ج. يرى",
      "content_type": "قول آبائي",
      "father_name": "القديس غريغوريوس النيسي",
      "text": "القديس غريغوريوس أسقف نيصص"
    },
    {
      "section_title": "ج. يرى",
      "content_type": "شرح",
      "father_name": null,
      "text": "في هذا الأمر إشارة رمزية لإبادة كل علَّة للخطية، إذ يقول: [يليق بمن يمسك بشر"
    },
    {
      "section_title": "ج. يرى",
      "content_type": "شرح",
      "father_name": null,
      "text": "خلال الفضيلة أن يقتله منذ بدايته، بهذا يُحطم ما يأتي وراءه. هذا ما يعلمنا به"
    },
    {
      "section_title": "ج. يرى",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرب في الإنجيل فيدعونا بكل وضوح أن نقتل أبكار الشر... إذ أمرنا بإبادة الشهوة"
    },
    {
      "section_title": "ج. يرى",
      "content_type": "شرح",
      "father_name": null,
      "text": "والغضب فلا نخاف من وصمة الزنا وجريمة القتل (مت 5: 22، 28). فإن هذين لا يأتيان"
    },
    {
      "section_title": "ج. يرى",
      "content_type": "شرح",
      "father_name": null,
      "text": "فجأة، إنما الغضب يُنتج قتلًا، والشهوة تولِّد زنا... فبتحطيم الأبكار (الشهوة"
    },
    {
      "section_title": "ج. يرى",
      "content_type": "شرح",
      "father_name": null,
      "text": "والغضب) نقتل بلا شك ما ينجم وراءهما. فلو أخذنا الحيّة مثالًا، فإنه يسحق رأسها"
    },
    {
      "section_title": "ج. يرى",
      "content_type": "شرح",
      "father_name": null,
      "text": "يكون جسدها قد قتل في نفس الوقت]."
    },
    {
      "section_title": "ج. يرى",
      "content_type": "شرح",
      "father_name": null,
      "text": "Tertullian: Adv."
    },
    {
      "section_title": "ج. يرى",
      "content_type": "شرح",
      "father_name": null,
      "text": "Marc. 2: 20."
    },
    {
      "section_title": "ج. يرى",
      "content_type": "شرح",
      "father_name": null,
      "text": "Vita Mos. 2: 92-94."
