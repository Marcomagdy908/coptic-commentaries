{
  "book_id": "chronicles1",
  "book_title": "تفسير سفر أخبار الأيام الأول",
  "chapter_number": 14,
  "chapter_title": "الأصحاح 14",
  "topic": "الأصحاح 14",
  "chapter_outline": [
    {
      "number": 1,
      "title": "ملك حيرام يرسل عُمَّالاً ومواد بناء",
      "verses": "1- 2"
    },
    {
      "number": 2,
      "title": "داود وتعدُّد الزوجات",
      "verses": "3- 7"
    },
    {
      "number": 3,
      "title": "هجوم الفلسطينيين عليه",
      "verses": "8- 17"
    }
  ],
  "sections_count": 294,
  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "اَلأَصْحَاحُ الرَّابِعُ عَشَرَ"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "إن كان"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الأصحاح السابق"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "يكشف لنا عن قلب داود النقي، فإنه إذ أقام أورشليم عاصمة لمملكته، أراد أن يُعْلِنَ"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أن الملك الحقيقي هو الله، وأن كل نجاحٍ يبلغ إليه، إنما هو عطية من الله. لهذا وضع"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "في قلبه أن ينقل تابوت العهد بكونه يُمَثِّل الحضور الإلهي إلى العاصمة."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أخطأ داود كما رأينا،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "لأنه لم يسلك حسب تدبير الشريعة فيما يخص بحمل تابوت العهد، وعوض الاحتفال"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "المُبهِج، أقيمت جنازة لعُزَّا الذي لمس التابوت فمات."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "تطلَّع الرب إلى قلب"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "داود النقي، فثبَّت مملكته، ووهبه نجاحًا ونموًّا ونصرة ومجدًا."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "هذا النجاح ولَّد ثورة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "وحقدًا لدى الأعداء، فثاروا ضده. استشار داود الرب، فحاربهم وغلب."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أعطاه الرب هيبة من"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "عنده على كل الأمم المحيطة به."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "من وحي 1 أي 14: لتُثبِّتْ"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مملكتك في أعماقي يا ابن داود"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "ومواد بناء"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "1 وَأَرْسَلَ حِيرَامُ مَلِكُ صُورَ رُسُلًا إِلَى دَاوُدَ وَخَشَبَ أَرْزٍ وَبَنَّائِينَ وَنَجَّارِينَ لِيَبْنُوا لَهُ بَيْتًا. 2 وَعَلِمَ دَاوُدُ أَنَّ الرَّبَّ قَدْ أَثْبَتَهُ مَلِكًا عَلَى إِسْرَائِيلَ، لأَنَّ مَمْلَكَتَهُ ارْتَفَعَتْ مُتَصَاعِدَةً مِنْ أَجْلِ شَعْبِهِ إِسْرَائِيلَ."
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَأَرْسَلَ حِيرَامُ مَلِكُ صُورَ رُسُلاً إِلَى دَاوُدَ،"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَخَشَبَ أَرْزٍ وَبَنَّائِينَ وَنَجَّارِينَ لِيَبْنُوا لَهُ بَيْتًا. [1]"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "يبرز هنا استقرار داود"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "في أورشليم، مع فيضٍ من العطايا يُقَدِّمها له ملك غريب من الأمم. أظهر الله لداود"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "نعمته، وأعطاه نعمة في عينيّ حيرام ملك صور، فأرسل إليه رسلاً يطلب وِدَّ داود. كما"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "أرسل له خشب أرز وبنَّائين مهرة، ونَجَّارين ليبنوا له بيتًا. هذه بداية صداقة قوية"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "ومُمْتَدَّة لفترة طويلة بين داود وحيرام ملك صور، استمرت حتى أيام سليمان."
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "صار لداود مملكة عظيمة"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "وممتدة، بينما كانت مملكة حيرام صغيرة لا تُقارَن بمملكة داود، لكن الله الذي كان"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "يسند داود في كل أعماله أراد أن يقوده إلى الحُبِّ مع التواضع. فمع كل إمكانيات"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "داود ما كان يمكنه أن يبني لنفسه قصرًا بدون مساندة حيرام ملك صور."
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "إنه يطالبنا ألا نحتقر"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "من هم أقل منَّا في الإمكانيات والسلطان. فالإنسان مهما بلغ نجاحه، ومهما نال من"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "إمكانيات، في حاجة إلى أخيه. يطلب منه أن يسنده، ويشكره على خدماته ومساعداته حتى"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "وإن كانت بأجرٍ."
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "لا يستطيع أن يعيش"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "الإنسان في معزلٍ عن أخيه، إنما كلما أُتيحَتْ له الفرصة، يكشف لأخيه أنه محتاج إلى"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "مساندته والتعاون معه، فلا يعاني الأخ بصِغَرِ نفسٍ."
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَعَلِمَ دَاوُدُ أَنَّ"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرَّبَّ قَدْ أَثْبَتَهُ مَلِكًا عَلَى إِسْرَائِيلَ،"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "لأَنَّ مَمْلَكَتَهُ ارْتَفَعَتْ مُتَصَاعِدَةً مِنْ أَجْلِ شَعْبِهِ إِسْرَائِيلَ."
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "إنه إذ يقودهم ويهتم"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "برعايتهم وإشباع احتياجاتهم وحمايتهم، لا يشعر أن له فضلاً في ذلك، فإن هذا ما يلزم"
    },
    {
      "section_title": "1. ملك حيرام يرسل عُمَّالاً",
      "content_type": "شرح",
      "father_name": null,
      "text": "أن يفعله كراعٍ صالحٍ ومُحِبٍ لشعب الله."
    },
    {
      "section_title": "العامل الأول",
      "content_type": "شرح",
      "father_name": null,
      "text": "كانت عينا داود مُرَكِّزتين على الله، فكل نجاحٍ وازدهارٍ وكرامةٍ تَحِلُّ به،"
    },
    {
      "section_title": "العامل الأول",
      "content_type": "شرح",
      "father_name": null,
      "text": "يُحسب هذا كله عطايا إلهية، ليس لأنه أكثر ذكاءً أو قدرة أو حكمة، من غيره، إنما"
    },
    {
      "section_title": "العامل الأول",
      "content_type": "شرح",
      "father_name": null,
      "text": "لأن الله معه."
    },
    {
      "section_title": "العامل الثاني",
      "content_type": "شرح",
      "father_name": null,
      "text": "أن ما يناله من نجاحٍ ومجدٍ وعظمةٍ وُهِبَ له، لا ليتنعَّم به شخصيًا، وإنما لكي"
    },
    {
      "section_title": "العامل الثاني",
      "content_type": "شرح",
      "father_name": null,
      "text": "يخدم شعب الله. هكذا يليق بالمؤمن ألا يتمركز حول ذاته"
    },
    {
      "section_title": "العامل الثاني",
      "content_type": "شرح",
      "father_name": null,
      "text": "his ego"
    },
    {
      "section_title": "العامل الثاني",
      "content_type": "شرح",
      "father_name": null,
      "text": "وإنما يحسب نفسه"
    },
    {
      "section_title": "العامل الثاني",
      "content_type": "شرح",
      "father_name": null,
      "text": "مدعوًّا من الله لسعادة الآخرين وراحتهم ومجدهم وخلاصهم الأبدي. فإنه ما استحق أن"
    },
    {
      "section_title": "العامل الثاني",
      "content_type": "شرح",
      "father_name": null,
      "text": "يولد من عاش لأجل نفسه، ولا يبالي بأخيه."
    },
    {
      "section_title": "العامل الثاني",
      "content_type": "شرح",
      "father_name": null,
      "text": "ما تتمتع به مملكة داود"
    },
    {
      "section_title": "العامل الثاني",
      "content_type": "شرح",
      "father_name": null,
      "text": "من استقرار ليس مُحَصِّلة جاذبية شخصيته، حيث تجمَّعت حوله كل"
    },
    {
      "section_title": "العامل الثاني",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأسباط،"
    },
    {
      "section_title": "العامل الثاني",
      "content_type": "شرح",
      "father_name": null,
      "text": "ولا محصلة محبة الناس وإخلاصهم وغيرتهم على بناء الشعب ونموّه، إنما سرّ عظمة مملكة"
    },
    {
      "section_title": "1. ما تمتع به من نمو",
      "content_type": "شرح",
      "father_name": null,
      "text": "روحي وسمو ومجد وفرح، إنما هو عطية الله له."
    },
    {
      "section_title": "2. مع محبة الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الفائقة لعبده داود، قَدَّم له من امتيازات فريدة، حتى وعده أن نسله يملك إلى"
    },
    {
      "section_title": "2. مع محبة الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأبد، هذا كله \"من أجل شعبه إسرائيل\". لقد أدرك داود هذا."
    },
    {
      "section_title": "2. داود وتعدُّد الزوجات",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "3 وَأَخَذَ دَاوُدُ نِسَاءً أَيْضًا فِي أُورُشَلِيمَ، وَوَلَدَ أَيْضًا دَاوُدُ بَنِينَ وَبَنَاتٍ. 4 وَهذِهِ أَسْمَاءُ الأَوْلاَدِ الَّذِينَ كَانُوا لَهُ فِي أُورُشَلِيمَ: شَمُّوعُ وَشُوبَابُ وَنَاثَانُ وَسُلَيْمَانُ 5 وَيِبْحَارُ وَأَلِيشُوعُ وَأَلِفَالَطُ 6 وَنُوجَهُ وَنَافَجُ وَيَافِيعُ 7 وَأَلِيشَمَعُ وَبَعَلْيَادَاعُ وَأَلِيفَلَطُ."
    },
    {
      "section_title": "2. داود وتعدُّد الزوجات",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَأَخَذَ دَاوُدُ نِسَاءً أَيْضاً فِي أُورُشَلِيمَ،"
    },
    {
      "section_title": "2. داود وتعدُّد الزوجات",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَوَلَدَ أَيْضاً دَاوُدُ بَنِينَ وَبَنَاتٍ. [3]"
    },
    {
      "section_title": "2. داود وتعدُّد الزوجات",
      "content_type": "شرح",
      "father_name": null,
      "text": "كان تعدُّد الزوجات"
    },
    {
      "section_title": "2. داود وتعدُّد الزوجات",
      "content_type": "شرح",
      "father_name": null,
      "text": "والسراري عادة شائعة في ذلك العصر عند العائلات المالكة في الشرق الأوسط، ولم يكن"
    },
    {
      "section_title": "2. داود وتعدُّد الزوجات",
      "content_type": "شرح",
      "father_name": null,
      "text": "ذلك يتفق مع الوصية الإلهية وفكر الله (تك 2: 24)."
    },
    {
      "section_title": "2. داود وتعدُّد الزوجات",
      "content_type": "شرح",
      "father_name": null,
      "text": "كان لداود ضعفاته، فقد"
    },
    {
      "section_title": "2. داود وتعدُّد الزوجات",
      "content_type": "شرح",
      "father_name": null,
      "text": "تمثَّل بالعادات التي كانت سائدة بين عائلات الملوك في الشرق الأوسط في ذلك الحين،"
    },
    {
      "section_title": "2. داود وتعدُّد الزوجات",
      "content_type": "شرح",
      "father_name": null,
      "text": "وعدم التزامه بالزوجة الواحدة. كان بعض الملوك يستغلون هذه العادة للدخول في علاقة"
    },
    {
      "section_title": "2. داود وتعدُّد الزوجات",
      "content_type": "شرح",
      "father_name": null,
      "text": "نسب مع الملوك المُجاورِين، فيُعطِي نوعًا من السلام السياسي."
    },
    {
      "section_title": "2. داود وتعدُّد الزوجات",
      "content_type": "شرح",
      "father_name": null,
      "text": "هذه العادة كثيرًا ما"
    },
    {
      "section_title": "2. داود وتعدُّد الزوجات",
      "content_type": "شرح",
      "father_name": null,
      "text": "تُسَبِّب حسدًا وغيره في القصر الملكي بين النساء، وأيضًا بين الأبناء. بسببها دخل"
    },
    {
      "section_title": "2. داود وتعدُّد الزوجات",
      "content_type": "شرح",
      "father_name": null,
      "text": "داود في مشاكل أسرية كثيرة ونزاعات بين أولاده، ولم يكن لديه الوقت الكافي لتربية"
    },
    {
