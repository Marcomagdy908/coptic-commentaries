      "text": "يُحَطِّموه، غير أن داود كان يستشير الرب قبل دخوله في المعارك."
    },
    {
      "section_title": "3. هجوم الفلسطينيين عليه",
      "content_type": "شرح",
      "father_name": null,
      "text": "فَسَأَلَ دَاوُدُ مِنَ"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"أَأَصْعَدُ عَلَى"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الْفِلِسْطِينِيِّينَ، فَتَدْفَعُهُمْ لِيَدِي؟\""
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "فَقَالَ لَهُ الرَّبُّ: \"اصْعَدْ فَأَدْفَعَهُمْ لِيَدِكَ.\" [10]"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أراد الكاتب بطريق غير"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "مباشر أن يُقَدِّم لنا مقارنة بين تصرف شاول وتصرف داود. الأول استشار الجان (1 أخ 10: 13)، ولم يسأل الرب (1 أخ 10: 14) في معركته ضد الفلسطينيين في"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "جبل جلبوع،"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أما داود فسأل الرب في معركته ضدهم في بعل فراصيم."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "اعتاد داود قبل أن يخرج"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "للحرب يطلب مرافقة الله له، كما يطلب مشورته. يقول"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "يوسيفوس: \"لم يسمح داود لنفسه أن يفعل شيئًا بدون نبوة وأمر الله، وبدون"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الاعتماد عليه كوقاية له في المستقبل[1].\""
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "كثيرًا ما نلجأ إلى"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله بعد أن تحلَّ بنا الضيقات والمتاعب، أما داود فسأل الرب المشورة قبل أن"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "يتحرَّك. ليت استشارتنا لله لا تأتي في المؤخرة، بل في المقدمة، فنتحاشى الكثير من"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "المتاعب الخطيرة."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "بعد (قتله جليات) لم يدخل قط في حربٍ دون أن يستشير الرب. بهذا كان منتصرًا في كل"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "معاركه، وحتى في أواخر حياته كان مستعدًا أن يحارب."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "عندما قامت حرب مع"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الفلسطينيين دخل المعركة معهم بفرقهم الشرسة..."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "إننا نحسب ثبات"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "(المؤمنين) مجيدًا، هؤلاء الذين بعظمة فكرهم \"بالإيمان... سدُّوا أفواه أسود،"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أطفأوا قوة النار، نجوا من حدِّ السيف، تقوُّوا من ضعف\" (عب 11: 33-34). إنهم لم"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "يقتنوا نصرة عامة مع كثيرين، محاطين بمحاربين وتسندهم فرق، إنما ينالون نصرتهم"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "وحدهم على أعدائهم المخادعين، وذلك بمجرد شجاعة نفوسهم[2]."
    },
    {
      "section_title": "الله",
      "content_type": "قول آبائي",
      "father_name": "القديس أمبروسيوس",
      "text": "القديس أمبروسيوس"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "فَصَعِدُوا إِلَى"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "بَعْلِ فَرَاصِيمَ وَضَرَبَهُمْ دَاوُدُ هُنَاكَ."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَقَالَ دَاوُدُ: \"قَدِ اقْتَحَمَ الله أَعْدَائِي بِيَدِي كَاقْتِحَامِ"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الْمِيَاهِ\"."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "لِذَلِكَ دَعُوا اسْمَ ذَلِكَ الْمَوْضِعِ \"بَعْلَ فَرَاصِيمَ\". [11]"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَتَرَكُوا هُنَاكَ"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "آلِهَتَهُمْ، فَأَمَرَ دَاوُدُ فَأُحْرِقَتْ بِالنَّارِ. [12]"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "لجأ داود إلى الله"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الحيّ، فنال نصرة عظيمة على الوثنيين، فحرق أصنامهم ومتعلقاتها. كان تصرف داود"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "حازمًا وجادًا أن يُحَطِّم الأوثان ويحرقها بالنار مع متعلقاتها. إذ لم يرد أن يترك"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أي أثرٍ للشر في حياته وفي حياة إخوته والمجتمع الذي يعيش فيه. يليق بنا ألا نترك"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "شيئًا يحتل مركز الله في قلوبنا أو أفكارنا. لعل داود فعل هذا خشية أن يعجب بعض"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الجنود ببعض الأصنام، خاصة المصنوعة من الذهب أو الفضة، فلم يترك لهم فرصة أن"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "يُفَكِّروا في الاحتفاظ ببعض الأصنام الصغيرة الحجم."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "تمَّم الوصية بكل قوة"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "(تث 7: 5)، على عكس الكثير من الملوك من نسل داود الذين تهاونوا في إبادة الأصنام."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "ثُمَّ عَادَ"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الْفِلِسْطِينِيُّونَ أَيْضًا، وَانْتَشَرُوا فِي الْوَادِي. [13]"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "فَسَأَلَ أَيْضًا"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "دَاوُدُ مِنَ الله،"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "فَقَالَ لَهُ الله: \"لاَ تَصْعَدْ وَرَاءَهُمْ،"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "تَحَوَّلْ عَنْهُمْ، وَهَلُمَّ عَلَيْهِمْ مُقَابِلَ أَشْجَارِ الْبُكَا. [14]"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "سرُّ نجاح داود وعظمته"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أنه في كل موقفٍ لا يتكل على خبرته القديمة أو إمكانياته، إنما يطلب مشورة الله. مع"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "كل موقف جديد كان داود يستشير الله، حتى يتجنَّب أية مخاطر تحلُّ به."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "يليق بنا مع كل موقف،"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "نتطلَّع إليه كفرصة جديدة للقاء مع الله وطلب مشورته، فهو يريدنا أن نكون في لقاءٍ"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "دائمٍ معه."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "فلتكن حادثة هجوم"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الفلسطينيين ثانية على داود وسؤاله مرة ثانية من الله درسًا لنا لنعترَّف بالرب:"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "نهرب إليه في وقت المحنة، نلتجئ إليه عندما نُظلَم، وعندما لا نعرف ماذا نعمل."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "نسأله المشورة ونضع مشيئتنا تحت إرادته وتدبيره، ونلح في الطلب ليهدينا الطريق."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَعِنْدَمَا تَسْمَعُ"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "صَوْتَ خَطَوَاتٍ فِي رُؤُوسِ أَشْجَارِ الْبُكَا،"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "فَاخْرُجْ حِينَئِذٍ لِلْحَرْبِ،"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "لأَنَّ اللهَ يَخْرُجُ أَمَامَكَ لِضَرْبِ مَحَلَّةِ الْفِلِسْطِينِيِّينَ\". [15]"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "ليكن سماع الصوت في"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أعلى شجر البُكا دليًلا لنا لنسمع حركة الله في إلهامه الإلهي وتأثيرات روحه"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "القدوس."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "فَفَعَلَ دَاوُدُ كَمَا"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أَمَرَهُ الله،"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَضَرَبُوا مَحَلَّةَ الْفِلِسْطِينِيِّينَ مِنْ جِبْعُونَ إِلَى جَازَرَ. [16]"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "قام الفلسطينيون بهجومٍ"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "ثانٍ، ونال داود النصرة بطريق آخر بمعونة الله."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَخَرَجَ اسْمُ دَاوُدَ"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "إِلَى جَمِيعِ الأَرَاضِي،"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَجَعَلَ الرَّبُّ هَيْبَتَهُ عَلَى جَمِيعِ الأُمَمِ. [17]"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "جعل الرب هيبة داود على"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "كل الأمم، إذ ارتعبت الأمم المحيطة، ونال داود شهرة في الأرض كلها [16-17]. فقد جاء"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الوعد الإلهي: \"يقول الرب: حاشا لي، فإني أُكرم الذين يكرمونني، والذين يحتقرونني"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "يصغرون\" (1 صم 2: 30)."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "من وحي 1 أي 14"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "لتُثبِّتْ مملكتك في أعماقي يا"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "ابن داود"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أَقمتَ داود من رعاية الغنمات،"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "ليرعى شعبك الذي اخترته"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أعطيتَه نعمة في أعين"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأسباط،"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "وهبتَه نجاحًا ونصرةً"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "في كل عملٍ تمتد إليه يداه."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أتيت يا ابن داود في عالمنا،"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "لكي تُقِيمَ ملكوتك في"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أعماق قلوبنا."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "تجعل من قلوبنا أورشليم"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "المتلألئة ببهائك."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "وتحوِّل ترابنا إلى"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أشبه بسماءٍ جديدة."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أعطيته نعمة في عينيّ حيرام ملك صور،"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "فبعث برُسُلٍ إليه"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "لإقامة علاقة ودٍّ وصداقة."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "وأرسل له بنَّائين"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "ونجَّارين ليبنوا له قصرًا."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "نزلتَ بنفسك إليَّ يا"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "ملك الملوك."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "وأرسلتَ لي روحك القدوس"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "القدير."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "لا ليبني لي قصرًا، بل"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "يُقِيم مني هيكلاً لك."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "تعالَ أيها الابن"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الوحيد مع أبيك وروحك القدوس."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "ولتقم في داخلي، وتعلن"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "ملكوتك فيَّ."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "وهبتَ داود أبناءَ في حبرون كما في أورشليم."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "وها أنت تهبنا روح"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "البنوة للآب القدوس."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "لا تعود تدعونا عبيدًا"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "بل أحبَّاء وأبناء."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "نحن لسنا أهلاً أن"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "نُحسَب عبيدًا لك."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "حُبُّك أقام منَّا ورثة"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله ووارثين معك."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "ما هو ميراثنا سوى"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "حُبِّك وحنانك؟!"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "ليهج العدو علينا، فنحن مستترون فيك!"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أنت ملجأ لنا، وحصن"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "حياتنا!"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أنت قائد الموكب وواهب"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "النصرة!"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "تُحَطِّم إبليس، وتطرحه"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "تحت الأقدام."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "مع كل صباح تتلألأ صورتك في حياتنا."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "ترد لنا جمالنا الروحي،"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "وتنزع عنَّا فسادنا!"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "تُعطِينا روح القوة"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "والسلطة."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "فنمتلئ من انعكاس"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "بهائك."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "وتتهلل نفوسنا بنُصرتك"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "العجيبة!"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "Antiquities of the Jews, 7:4:1 ."
    },
    {
      "section_title": "الله",
