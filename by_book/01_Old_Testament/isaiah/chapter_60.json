  "sections_count": 259,
  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "المدينة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "المنيرة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "بعدما تعرض للعقبات التي تحول عن تمتع"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الإنسان بالخلاص (إش 57-59) يُقدم لنا في نهاية السفر صورة مبهجة ورائعة عن بناء"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مدينة الرب الجديدة (60-66)."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "(إش 60) يُقدم لنا صورة رائعة لكنيسة العهد الجديد كمدينة الرب صهيون المنيرة،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أيقونة السماء."
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "1 «قُومِي اسْتَنِيرِي لأَنَّهُ قَدْ جَاءَ نُورُكِ، وَمَجْدُ الرَّبِّ أَشْرَقَ عَلَيْكِ. 2 لأَنَّهُ هَا هِيَ الظُّلْمَةُ تُغَطِّي الأَرْضَ وَالظَّلاَمُ الدَّامِسُ الأُمَمَ. أَمَّا عَلَيْكِ فَيُشْرِقُ الرَّبُّ، وَمَجْدُهُ عَلَيْكِ يُرَى."
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "أن أكّد الرب أنه يقوم بنفسه بالخلاص ويفدي صهيون، مقيمًا عهده الجديد معها (إش 59: 15-21). الآن إذ قدم السيد المسيح خلاصه على الصليب، وأعلن الآب قبوله بالقيامة"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "التي هي ليست عطية خارجية عن السيد المسيح إذ هو نفسه القيامة (يو 11: 25)، له"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "سلطان أن يضع نفسه وله سلطان أن يأخذها (يو 10: 18)، يطلب من كنيسة العهد الجديد"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "أن تتمتع بحياة فاديها كحياة مقامة لا موضع للظلام فيها."
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"قومي استنيري لأنه قد جاء نورك ومجد الرب أشرق"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "عليكِ، لأنه ها هي الظلمة تغطي الأرض والظلام"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الدامس الأمم، أما عليكِ فيشرق الرب،"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "ومجده عليكِ يُرى\" [2]."
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "عندما"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "عاد اليهود من السبي حسبوا أنفسهم كمن قاموا من الموت، وتمتعوا بنور الحياة"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "والحرية بعد سبعين عامًا من المذلة كما في ظلمة القبر. أما كنيسة العهد الجديد فقد"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "تمتعت بما هو أعظم، اتحادها بالنور الحقيقي كعريس أبدي يُقيم منها عروسًا تحمل"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "نوره وبهاءه ومجده. وكما قال الرب عن نفسه \"أنا هو نور العالم\" (يو 8: 12)، دَعَى تلاميذه نور العالم (مت 5: 14)، إذ يحملونه فيهم."
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "هو سرّ استنارة الكنيسة؟"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "قيامة"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرب التي قدمت لنا الحياة الجديدة التي لن يغلبها الموت، ولا تقدر الظلمة أن"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "تقتنصها ولا القبر أن يُحطمها. لذلك يقول الرسول: \"استيقظ أيها النائم وقم من"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأموات"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "فيضيء"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "لك المسيح\" (أف 5: 14)."
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "كان العماد هو تمتع بقيامة المسيح فينا لذا دُعي هذا السر \"استنارة\"."
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "يُدعى"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "هذا الفعل بأسماء كثيرة اعني نعمة واستنارة وكمالًا وحميمًا... فهو استنارة إذ به"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "نرى النور القدوس الخلاصي، أعني أننا به نشخص إلى الله بوضوح."
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "قول آبائي",
      "father_name": "القديس إكليمنضس الإسكندري",
      "text": "القديس إكليمنضس الإسكندري"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الاستنارة وهي"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "المعمودية... هي معينة الضعفاء ... مساهمة النور... انتفاض الظلمة."
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الاستنارة"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "مركب يسير تجاه الله؛ مسايرة المسيح، أُس الدين، تمام العقل!"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الاستنارة"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "مفتاح الملكوت واستعادة الحياة."
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "قول آبائي",
      "father_name": "القديس غريغوريوس النزينزي",
      "text": "القديس غريغوريوس النزينزي"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "المعمودية هي"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "ابنة النهار، فتحت أبوابها فهرب الليل الذي دخلت إليه الخليقة كلها!"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "قول آبائي",
      "father_name": "القديس مار يعقوب السروجي",
      "text": "مار يعقوب السروجي"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "هكذا"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "إذ نقبل الاتحاد مع ربنا يسوع المسيح المصلوب ندفن معه في المعمودية ونقوم حاملين"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "إمكانية الحياة الجديدة، لنحيا كما يليق كأبناء للنور، وأعضاء جسد المسيح القدوس."
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "لا يليق بنا أن ننزل بعد إلى ظلمة الخطية، ولا أن نعتذر بضعفنا البشري لأننا نحمل"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "فينا نور الرب ويشرق علينا مجده. لا نصير بعد أرضًا مظلمة بل سماء تحتضن مجد الله"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "وبهاءه."
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "هي سمة الكنيسة كحياة جديدة في المسيح، الساكن فيها، يشرق عليها ببره الإلهي،"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "فيقال عنا: \"فليضئ نوركم قدام الناس لكي يروا أعمالكم الحسنة ويمجدوا أباكم"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الذي في السموات\" (مت 5: 16)."
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "عندما يمارسون"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الإلهيات وينطقون بها، ويعيشون الحياة الإلهية، هازمين قساوة القلب ومتمتعين بسلام"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "البر، يلاحقهم مجد عظيم في كنيسة المسيح."
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "قول آبائي",
      "father_name": "القديس أغسطينوس",
      "text": "القديس أغسطينوس"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "جاء السيد المسيح إلى العالم ليقتني البشرية عروسًا له يسكب مجده وبهاءه في"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "داخلها؛ يهبها روحه القدوس لكي يُزينها ويُجمِلّها لتتهيأ بالمجد الداخلي للعرس"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "السماوي الأبدي. فيُقال لها: \"اسمعي يا ابنتي وانظري وأميلي أذنك وأنسي شعبك"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "وبيت أبيك، فيشتهي الملك حسنك، لأنه هو سيدك فاسجدي له... كل مجدٌ ابنة الملك في"
    },
    {
      "section_title": "1. مدينة منيرة",
      "content_type": "شرح",
      "father_name": null,
      "text": "خدرها\" (مز 45: 10-13)."
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "3 فَتَسِيرُ الأُمَمُ فِي نُورِكِ، وَالْمُلُوكُ فِي ضِيَاءِ إِشْرَاقِكِ. 4 «اِرْفَعِي عَيْنَيْكِ حَوَالَيْكِ وَانْظُرِي. قَدِ اجْتَمَعُوا كُلُّهُمْ. جَاءُوا إِلَيْكِ. يَأْتِي بَنُوكِ مِنْ بَعِيدٍ وَتُحْمَلُ بَنَاتُكِ عَلَى الأَيْدِي. 5 حِينَئِذٍ تَنْظُرِينَ وَتُنِيرِينَ وَيَخْفُقُ قَلْبُكِ وَيَتَّسِعُ، لأَنَّهُ تَتَحَوَّلُ إِلَيْكِ ثَرْوَةُ الْبَحْرِ، وَيَأْتِي إِلَيْكِ غِنَى الأُمَمِ. 6 تُغَطِّيكِ كَثْرَةُ الْجِمَالِ، بُكْرَانُ مِدْيَانَ وَعِيفَةَ كُلُّهَا تَأْتِي مِنْ شَبَا. تَحْمِلُ ذَهَبًا وَلُبَانًا، وَتُبَشِّرُ بِتَسَابِيحِ الرَّبِّ. 7 كُلُّ غَنَمِ قِيدَارَ تَجْتَمِعُ إِلَيْكِ. كِبَاشُ نَبَايُوتَ تَخْدِمُكِ. تَصْعَدُ مَقْبُولَةً عَلَى مَذْبَحِي، وَأُزَيِّنُ بَيْتَ جَمَالِي. 8 مَنْ هؤُلاَءِ الطَّائِرُونَ كَسَحَابٍ وَكَالْحَمَامِ إِلَى بُيُوتِهَا؟ 9 إِنَّ الْجَزَائِرَ تَنْتَظِرُنِي، وَسُفُنَ تَرْشِيشَ فِي الأَوَّلِ، لِتَأْتِيَ بِبَنِيكِ مِنْ بَعِيدٍ وَفِضَّتُهُمْ وَذَهَبُهُمْ مَعَهُمْ، لاسْمِ الرَّبِّ إِلهِكِ وَقُدُّوسِ إِسْرَائِيلَ، لأَنَّهُ قَدْ مَجَّدَكِ."
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله الداخلي في النفس جذّاب، يقتنص النفوس لمملكته الروحية. فأنه إذ تصير كنيسة"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "العهد الجديد مدينة منيرة تجتذب الأمم، وكما يقول الرب نفسه: \"أنتم نور"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "العالم، لا يمكن أن تُخفى مدينة موضوعة على جبل، ولا يوقدون سراجًا ويضعونه تحت"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "المكيال بل على المنارة فيضئ لجميع الذين في البيت، فليضئ نوركم هكذا قدام الناس"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "لكي يروا أعمالكم الحسنة ويمجدوا أباكم الذي في السموات\" (مت 5: 14-16). هذا"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "تحقيق لما جاء في إشعياء النبي: \"فتسير الأمم في نورك والملوك في ضياء"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "إشراقك\" [3]."
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "تصير"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الكنيسة كعريسها عمود نور الحق الذي يقود الأمم في طريق الرب ويقيم فيهم ملوكًا"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "روحيين أصحاب سلطان داخلي."
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "تتطلع"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الكنيسة حواليها لتنظر من كل جانب عمل الله العجيب، يجتذب من كل الأمم أولادًا"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "وبنات لها، يأتون من بعيد ليصيروا أهل بيت الرب المكرمين، المحمولين على الأيدي [14]."
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "تظهر"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "قوة المسيح القائم من الأموات في حياة كنيسته بتحويل الطاقات (ثروة الأمم) لحساب"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "ملكوته، إذ قيل لعروسه: \"حينئذ تنظرين وتنيرين ويخفق قلبكِ ويتسع لأنه"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "تحوَّل إليكِ ثروة البحر ويأتي إليك غنى الأمم\" [5]..."
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "هي ثروة أو غنى الأمم التي تتقدس لحساب كنيسة المسيح؟"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "ثروة البحر [5]، أي الأسماك واللؤلؤ. لقد"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "حسب آباء الكنيسة الأولى السيد المسيح هو"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"السمكة\" (أخسوس ἰχθύς)، وأما المؤمنون فهم السمك الذي يعيش مع السيد المسيح"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "وفيه (حز 47: 9). يقول"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "قول آبائي",
      "father_name": "العلامة ترتليان",
      "text": "العلامة ترتليان: [نحن السمك الصغير بحسب سمكتنا"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "يسوع المسيح قد وُلدنا في المياه، ولا نكون في أمان بطريق ما غير بقائنا في المياه"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "على الدوام]."
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "ذهب ولبان تحمله الجمال من مديان وشبا لا للتجارة، لكنه يُقدم هدية لصهيون."
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "قدم المجوس ذهبًا ولبانًا ومرًا للسيد المسيح علامة ملكه وأنه إله يُقدم البخور،"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "ومتألم؛ هكذا يصير أعضاء جسده ملوكًا يقدمون اللبان كبخور طيب للمخلص."
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "تقديم ذبائح مقبولة لخدمة بيت الرب وزينته [7-8]، هذه الذبائح هي حياتنا وأجسادنا"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "وكل طاقاتنا التي تلتحم بالذبيح الفريد، فتصير محرقات حب مرفوعة خلال الصليب. يقول"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرسول: \"فاطلب إليكم أيها الأخوة برأفة الله أن تقدموا أجسادكم ذبيحة حية"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "مقدسة مرضية عند الله عبادتكم العقلية\" (رو 12: 1). تقدماتنا للرب هي"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"نفوسنا\" ذاتها كقول"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "قول آبائي",
      "father_name": "القديس جيروم",
      "text": "القديس جيروم."
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "لعل أجمل ما نقدمه لصهيون هو تمتعنا بالقدرة على الطيران كسحاب يحملنا روح الرب"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "نحو السمويات فنعيش مع مسيحنا في أمجاده كما في بيتنا الخاص. \"من هؤلاء"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الطائرون كسحاب وكالحمام إلى بيوتها؟!\" [8]."
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "سيأتي"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرب في اليوم الأخير على سحاب (مت 24: 30)، يأتي محمولًا على قديسيه السحاب"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الخفيف المنير (إش 19: 1)... كأن تشبيهنا بالسحاب يعني أننا صرنا عرشًا نحمل"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "مسيحنا؛ أما تشبيهنا بالحمام فيعني أننا صرنا روحيين، لأن الروح القدس ظهر أثناء"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "عماد الرب كحمامة. بمعنى آخر أن ارتباطنا بكنيسة الله يصيّرنا عرشًا للرب حاملين"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "ثمار روحه القدوس."
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "في الترجمة السبعينية: \"من هؤلاء الطائرون كسحاب وكالحمام مع صغارهم؟!\""
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "القديس غريغوريوس النيصي أن هذه العبارة النبوية تعلن من بعيد عن"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الكنيسة القادمة بأطفالها المملوءين جمالًا الكثيري العدد."
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "يقارن"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "القديس غريغوريوس النيصي بين أولاد الكنيسة الحقيقيين الذين في خفة الروح"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "يطيرون كالحمام والسحاب وبين الأشرار الذين بسبب ثقل الخطية يغطسون كما في مياه"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "عميقة. [يسير الواحد خفيفًا بما فيه الكفاية بينما يغطس الآخر في مياه عميقة. لأن"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الفضيلة خفيفة تطفو، وكل الذين يعيشون في طريقها يطيرون كالسحاب ومثل الحمام مع"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "صغارهم كقول إشعياء؛ وأما الخطية فثقيلة؛ وكما يقول نبي آخر أنها تجلس على وزنة من"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرصاص (زك 5: 7)]."
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الفضة مع الذهب [9]. إن كانت الفضة تُشير إلى كلمة الله (مز 12: 6) فان الذهب يُشير"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "إلى الحياة السماوية النقية؛ وكأن غنى الكنيسة القادمة من الأمم يكمن في تمسكها"
    },
    {
      "section_title": "2. جذابة للأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "بكلمة الله وتمتعها بالفكر السماوي."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "10 «وَبَنُو الْغَرِيبِ يَبْنُونَ أَسْوَارَكِ، وَمُلُوكُهُمْ يَخْدِمُونَكِ. لأَنِّي بِغَضَبِي ضَرَبْتُكِ، وَبِرِضْوَانِي رَحِمْتُكِ. 11 وَتَنْفَتِحُ أَبْوَابُكِ دَائِمًا. نَهَارًا وَلَيْلًا لاَ تُغْلَقُ. لِيُؤْتَى إِلَيْكِ بِغِنَى الأُمَمِ، وَتُقَادَ مُلُوكُهُمْ. 12 لأَنَّ الأُمَّةَ وَالْمَمْلَكَةَ الَّتِي لاَ تَخْدِمُكِ تَبِيدُ، وَخَرَابًا تُخْرَبُ الأُمَمُ. 13 مَجْدُ لُبْنَانَ إِلَيْكِ يَأْتِي. السَّرْوُ وَالسِّنْدِيَانُ وَالشَّرْبِينُ مَعًا لِزِينَةِ مَكَانِ مَقْدِسِي، وَأُمَجِّدُ مَوْضِعَ رِجْلَيَّ. 14 «وَبَنُو الَّذِينَ قَهَرُوكِ يَسِيرُونَ إِلَيْكِ خَاضِعِينَ، وَكُلُّ الَّذِينَ أَهَانُوكِ يَسْجُدُونَ لَدَى بَاطِنِ قَدَمَيْكِ، وَيَدْعُونَكِ: مَدِينَةَ الرَّبِّ، «صِهْيَوْنَ قُدُّوسِ إِسْرَائِيلَ. 15 عِوَضًا عَنْ كَوْنِكِ مَهْجُورَةً وَمُبْغَضَةً بِلاَ عَابِرٍ بِكِ، أَجْعَلُكِ فَخْرًا أَبَدِيًّا فَرَحَ دَوْرٍ فَدَوْرٍ. 16 وَتَرْضَعِينَ لَبَنَ الأُمَمِ، وَتَرْضَعِينَ ثُدِيَّ مُلُوكٍ، وَتَعْرِفِينَ أَنِّي أَنَا الرَّبُّ مُخَلِّصُكِ وَوَلِيُّكِ عَزِيزُ يَعْقُوبَ. 17 عِوَضًا عَنِ النُّحَاسِ آتِي بِالذَّهَبِ، وَعِوَضًا عَنِ الْحَدِيدِ آتِي بِالْفِضَّةِ، وَعِوَضًا عَنِ الْخَشَبِ بِالنُّحَاسِ، وَعِوَضًا عَنِ الْحِجَارَةِ بِالْحَدِيدِ، وَأَجْعَلُ وُكَلاَءَكِ سَلاَمًا وَوُلاَتَكِ بِرًّا. 18 «لاَ يُسْمَعُ بَعْدُ ظُلْمٌ فِي أَرْضِكِ، وَلاَ خَرَابٌ أَوْ سَحْقٌ فِي تُخُومِكِ، بَلْ تُسَمِّينَ أَسْوَارَكِ: خَلاَصًا وَأَبْوَابَكِ: تَسْبِيحًا. 19 لاَ تَكُونُ لَكِ بَعْدُ الشَّمْسُ نُورًا فِي النَّهَارِ، وَلاَ الْقَمَرُ يُنِيرُ لَكِ مُضِيئًا، بَلِ الرَّبُّ يَكُونُ لَكِ نُورًا أَبَدِيًّا وَإِلهُكِ زِينَتَكِ. 20 لاَ تَغِيبُ بَعْدُ شَمْسُكِ، وَقَمَرُكِ لاَ يَنْقُصُ، لأَنَّ الرَّبَّ يَكُونُ لَكِ نُورًا أَبَدِيًّا، وَتُكْمَلُ أَيَّامُ نَوْحِكِ. 21 وَشَعْبُكِ كُلُّهُمْ أَبْرَارٌ. إِلَى الأَبَدِ يَرِثُونَ الأَرْضَ، غُصْنُ غَرْسِي عَمَلُ يَدَيَّ لأَتَمَجَّدَ. 22 اَلصَّغِيرُ يَصِيرُ أَلْفًا وَالْحَقِيرُ أُمَّةً قَوِيَّةً. أَنَا الرَّبُّ فِي وَقْتِهِ أُسْرِعُ بِهِ»."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"وبنو الغريب يبنون أسواركِ وملوكهم يخدمونك\" [10]. يُشير"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "هنا إلى كورش الغريب الجنس الذي أمر برجوع المسبيين وأعطى نحميا التسهيلات لبناء"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "السور."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "في محبته يستخدم كل الطاقات الغريبة لحساب بناء ملكوته، مقدمًا كل صلاح من أجل"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "كنيسته؛ وهذا هو مجد الكنيسة الحق: تقديس كل عمل!"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "جمال الكنيسة ينصب في فتح أبوابها دائمًا، \"نهارًا وليلًا لا تغلق\""
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "[11]. لا ترد خاطئًا ولا تجرح مشاعره؛ تحمل قلبًا متسعًا بالحب كعريسها نحو"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الجميع."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "إنها"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "كسفينة نوح أبوابها متسعة، قبلت نوح وعائلته والحيوانات والطيور إلخ... من كان"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "بداخلها خلص، أما من رفض فهلك. \"لأن الأمة والمملكة التي لا تخدمك تبيد"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "وخرابًا تخرب الأمم\" [12]. وكما يقول"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "قول آبائي",
      "father_name": "القديس كبريانوس",
      "text": "الشهيد كبريانوس: [إنه"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "لا خلاص خارج الكنيسة]."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"مجد لبنان إليكِ يأتي، السرو والسنديان والشربين معًا لزينة مكان مقدسي"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "وأُمجد موضع رجليّ\" [13]. لقد عُرفت لبنان بشجرها الممتاز، لذا"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "تحول ثروتها الخشبية لاستخدامها في تزيين هيكل الرب. صورة رائعة لتحويل الطاقات"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الخاملة أو التي أُسيء استخدامها لحساب هيكل الرب."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "التمتع بسلطان روحي حيث تخضع قوات الظلمة تحت أقدام المؤمنين. \"وبنو الذين"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "قهروكِ يسيرون إليك خاضعين، وكل الذين أهانوكِ يسجدون لدى باطن قدميكِ ويدعونك"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "مدينة الرب صهيون قدوس إسرائيل\" [14]. حتى عدو الخير بكل طاقاته"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "يشهد للمؤمنين أنهم"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "مدينة الله المقدسة. لا يستطيع الأشرار إلاَّ أن يشهدوا لأولاد"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله عن قدسية حياتهم حتى في لحظات اضطهادهم لهم."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "تمتعها بالفرح الدائم الأبدي: \"عوضًا عن كونكِ مهجورة ومُبغَضة بلا عابر"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "بك أجعلك فخرًا أبديًا فرح دور فدور\" [15]. هذا هو فخرها الأبدي"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "أنها ليست بعد مهجورة ولا تعاني من حالة فراغ أو عزلة أو بغضة الغير لها بل تمتلئ"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "فرحًا فتصير مجيدة إلى الأبد."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "يهبها الله أكثر مما تطلب وفوق ما تسأل، فإن سألت نحاسًا يهبها ذهبًا، وأن طلبت"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "حديدًا يهبها فضة وعوض الخشب يُقدم لها نحاسًا، وبدل الحجارة حديدًا... هكذا تجد"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "في الله شبعها الداخلي وأيضًا سرّ غناها الروحي وشبع كل احتياجاتها."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "يسكن العدل فيها لذلك \"لا يُسمع بعد ظلم في أرضك، ولا خراب أو سحق في"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "تخومك بل تُسمين أسوارك خلاصًا وأبوابك تسبيحًا\" [18]. كل إنسان"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "يجد فيها خلاصه وسرّ تسبيحه وفرحه، لأن الله العادل فيها يهب عدلًا وبرًا، ولا"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "يسمح بظلم أو خراب أو سحق أن يُمارس في داخلها."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "بكونها أيقونة السماء لا تحتاج إلى شمس أو قمر لإضاءتها \"بل الرب يكون لكِ"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "نورًا أبديًا وإلهك زينتك\" [19]."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "التمتع بالحياة البارة [21]."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "التمتع بقوة الله الفائقة \"الصغير يصير ألفًا، والحقير أمة قوية\""
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "[22]. الإنسان بذاته يُحسب صغيرًا أما كعضو في جسد المسيح فيُحسب ألفًا أي"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "سماويًا، لأن رقم 1000 يُشير إلى السماء. خارج المسيح يحسب حقيرًا يلهو به عدو"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الخير وتحطمه الخطية، أما في المسيح يسوع فيصير أمة قوية. يصير \"أمة\" إذ"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "يحمل طاقات مقدسة للروح والجسد تعمل معًا بانسجام وفي وحدة، تحمل قوة روح الرب"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "فيها."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "هكذا"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "يُقدم لنا هذا الأصحاح صورة حيَّة عن كنيسة السيد المسيح بكونها المدينة المنيرة"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الحاملة إشراقات السيد المسيح فيها، تجتذب الأمم والشعوب خلال مجدها الداخلي،"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "وتقدس كل طاقاتها وإمكانياتهم التي أساءوا استخدامها تفتح أبوابها أمام الجميع"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالحب، ويفتح الرب أبوابه أمامها ليهبها أكثر مما تطلب وفوق ما تسأل، يهبها بره"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "وعدله وقوته وجماله ونوره فلا يُعوزها شيء!"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "Kay’s Writings of Clement of Alexandria, p. 437."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "للمؤلف: الروح القدس"
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "بين الميلاد الجديد والتجديد المستمر، 1981م، ص 83."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "المقدسة."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "City of God 5:14."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله، 1979م، ص 311-314."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "On Ps. Hom 23."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "On the Baptism of Christ."
    },
    {
      "section_title": "3. مدينة مجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "On Virginity 18."
    },
