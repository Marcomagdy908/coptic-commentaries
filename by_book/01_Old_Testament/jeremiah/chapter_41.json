  "sections_count": 275,
  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "اغتيال جدليا والي أورشليم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "اليهود يحتفلون بقتل"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "جدليا كمناسبة حزينة وذلك بالصوم في الشهر السابع (أكتوبر)"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "(زك 7: 5؛ 8: 19). ولا تُعرف السنة التي قُتل فيها جدليا. فقد تم جمع المحصول قبل"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "قتله (إر 40: 14)، هذا يعني احتمال أنه مرَّ عام ما بين سقوط أورشليم ومصرعه، حيث"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "سُمح للاجئين أن يعودوا ويزرعوا الأرض. وإن كان البعض يرى أن جدليا لم يبقَ في"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الولاية سوى شهرين"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أو ثلاثة شهور."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "قُتل"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "جدليا لكن الله حفظ إرميا حتى يتمم رسالته. في هذا الأصحاح لا نجد خبرًا عن إرميا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "نفسه، ولا نسمع عنه كلمة، بل جاء كمقدمة لما يأتي فيما بعد، وهو نزول جماعة من"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "اليهود إلى مصر آخذين معهم إرميا على الرغم منه."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مصرع جدليا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "فظائع أخرى"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "سبي البقية وإطلاق سراحها"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "1 وَكَانَ فِي الشَّهْرِ السَّابعِ، أَنَّ إِسْمَاعِيلَ بْنَ نَثَنْيَا بْنِ أَلِيشَامَاعَ، مِنَ النَّسْلِ الْمُلُوكِيِّ، جَاءَ هُوَ وَعُظَمَاءُ الْمَلِكِ وَعَشَرَةُ رِجَال مَعَهُ إِلَى جَدَلْيَا بْنِ أَخِيقَامَ إِلَى الْمِصْفَاةِ،"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَأَكَلُوا هُنَاكَ خُبْزًا مَعًا فِي الْمِصْفَاةِ."
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "2 فَقَامَ إِسْمَاعِيلُ بْنُ نَثَنْيَا وَالْعَشَرَةُ الرِّجَالِ الَّذِينَ كَانُوا مَعَهُ وَضَرَبُوا جَدَلْيَا بْنَ أَخِيقَامَ بْنِ شَافَانَ بِالسَّيْفِ فَقَتَلُوهُ،"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "هذَا الَّذِي أَقَامَهُ مَلِكُ بَابِلَ عَلَى الأَرْضِ."
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "3 وَكُلُّ الْيَهُودِ الَّذِينَ كَانُوا مَعَهُ، أَيْ مَعَ جَدَلْيَا، فِي الْمِصْفَاةِ"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَالْكَلْدَانِيُّونَ الَّذِينَ وُجِدُوا هُنَاكَ، وَرِجَالُ الْحَرْبِ، ضَرَبَهُمْ إِسْمَاعِيلُ. [1-3]."
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "أن تحدثنا في الأصحاح السابق عن إسمعيل بن نثنيا الذي دفعه بعليس ملك عمون على"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "اغتيال جدليا. ولا نعرف ما الذي دفعه إلى هذه الجريمة، وما الذي دفع ملك"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "عمون"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "على تحريضه."
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "كان إسمعيل مدفوعًا بغيرة دينية قومية على بلاده حاسبًا أن الخضوع لبابل خيانة"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "عظمى؟"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "كان مدفوعًا بوعود ملك عمون (إر 40: 14)؟"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "كان الحسد أو العداوة الشخصية مع جدليا؟"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "محبة المال هي الباعث؟"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "حاسبًا"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "نفسه أحق برئاسة الشعب دون جدليا؟"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "تحدى"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "إسمعيل كل قوانين كرم الضيافة الشريفة في الشرق باغتياله مضيفه بعمل صارخ من أعمال"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الخيانة."
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "واضح"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "أن عنصر الحسد له دوره في ارتكاب هذه الجريمة. فإن الحسد يفقد الإنسان اتزانه"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "وقدرته على التفكير لصالح غيره وصالح الجماعة وأيضًا لمجد الله. إنه يدفع الإنسان"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "إلى التهور ليقتل أعماق نفسه، غير مبالٍ بنظرة الله أو الجماعة أو حتى"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "ضميره الداخلي. وكما قيل: \"حياة الجسد هدوء"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "القلب، ونخر العظام الحسد\" (أم 14: 30)."
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "لم يرشق الآخرين بغريزة الغيرة قبل أن يرشق نفسه بها، ولا رشقهم بالأسر قبل أن"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "يُؤسر، ولا بالدمار قبل أن يهلك. وفي إغرائه بالغيرة أفقد الإنسان نعمة الخلود"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الموهوبة له، وهو نفسه فقد تلك التي كانت له سابقًا."
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "يالها"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "من شرورٍ عظيمة أيها الأحباء، فقد أسقطت (الغيرة أو الحسد) الملاك، وأزالت مجدًا"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "عظيمًا وبهيًا، فتلك التي خدع بها الآخرون هو نفسه بها خُدع!"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "قول آبائي",
      "father_name": "القديس كبريانوس",
      "text": "القديس كبريانوس"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "توجد خطية تفرق الإنسان عن الله والناس مثل خطية الحسد، لأن هذا المرض أشد خبثًا"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "من محبة الفضة. لأن محب الفضة يفرح متى ربح شيئًا، أما الحاسد فيفرح متى خسر أحد"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "شيئًا أو ضاع تعبه سدى. ويحسب خسائر الآخرين ربحًا له أكثر من أي نجاح، فأي شرٍ"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "أعظم من هذا؟!"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "يتورط"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الزاني في الخطأ لأجل لذة مؤقتة، وقد تكون للسارق حجة الفقر، ولكن أي عذرٍ تقدمه"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "أيها الحاسد...؟! الحاسد يعذب نفسه ولو لم يحدث له ضرر مما يحسده، لهذا خطيئة"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الحسد أشر الخطايا وأشنعها. لأن الحاسد لا يمكنه مفارقة خطيته، بل يكون كالخنزير"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "المتمرغ في الحمأة، ويماثل بفعله الشيطان..."
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "لهذا"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "أقول لكم إنه إن كان أحدكم يصنع المعجزات أو يحفظ البتولية أو يكون صوامًا أو"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "باسطًا كفّيه أو ينام على الأرض ويصل بهذه الوسائط إلى فضيلة الملائكة، ولكن فيه"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "آلام الحسد، فلا محالة يكون أشر من جميع الخطاة وأردأ منهم."
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الشيطان"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "حاسد، لكنه يحسد البشرية ولا يحسد شيطانًا آخر، أما أنت فإنسان وتحسد أخاك"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الإنسان، وبالأخص الذين من عائلتك وعشيرتك، الأمر الذي لا يصنعه الشيطان."
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "قول آبائي",
      "father_name": "القديس يوحنا ذهبي الفم",
      "text": "القديس يوحنا ذهبي الفم"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "* الحاسد"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "النور، لأنه يلوم المضيئين ويعيبهم بحسده."
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الشيخ الروحاني"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "* الحسد"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "جرثومة"
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "شرح",
      "father_name": null,
      "text": "وأصل الشرور."
    },
    {
      "section_title": "1. مصرع جدليا",
      "content_type": "قول آبائي",
      "father_name": "القديس يوحنا ذهبي الفم",
      "text": "القديس يوحنا ذهبي الفم"
    },
    {
      "section_title": "2. فظائع أخرى",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "4 وَكَانَ فِي الْيَوْمِ الثَّانِي بَعْدَ قَتْلِهِ جَدَلْيَا وَلَمْ يَعْلَمْ إِنْسَانٌ،"
    },
    {
      "section_title": "2. فظائع أخرى",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "5 أَنَّ رِجَالًا أَتَوْا مِنْ شَكِيمَ وَمِنْ شِيلُوَ وَمِنَ السَّامِرَةِ، ثَمَانِينَ رَجُلًا مَحْلُوقِي اللُّحَى وَمُشَقَّقِي الثِّيَابِ وَمُخَمَّشِينَ، وَبِيَدِهِمْ تَقْدِمَةٌ وَلُبَانٌ لِيُدْخِلُوهُمَا إِلَى بَيْتِ الرَّبِّ."
    },
    {
      "section_title": "2. فظائع أخرى",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "6 فَخَرَجَ إِسْمَاعِيلُ بْنُ نَثَنْيَا لِلِقَائِهِمْ مِنَ الْمِصْفَاةِ سَائِرًا وَبَاكِيًا."
    },
    {
      "section_title": "فَكَانَ لَمَّا لَقِيَهُمْ أَنَّهُ قَالَ لَهُمْ",
      "content_type": "شرح",
      "father_name": null,
      "text": "«هَلُمَّ إِلَى جَدَلْيَا بْنِ أَخِيقَامَ»."
    },
    {
      "section_title": "فَكَانَ لَمَّا لَقِيَهُمْ أَنَّهُ قَالَ لَهُمْ",
