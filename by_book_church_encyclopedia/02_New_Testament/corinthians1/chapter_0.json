      "content_type": "شرح",
      "father_name": null,
      "text": "الاستعداد للتناول من الأسرار المقدسة وتصرف النساء في الكنيسة."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
