      "content_type": "شرح",
      "father_name": null,
      "text": "السلوك المسيحي بالنسبة للزواج وأكل المذبوح للأوثان."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "السلوك المسيحي بالنسبة للزواج وأكل المذبوح للأوثان."
    },
    {
