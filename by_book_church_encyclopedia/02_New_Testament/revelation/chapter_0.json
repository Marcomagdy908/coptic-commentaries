    },
    {
      "section_title": "أولًا: كاتبها",
      "content_type": "شرح",
      "father_name": null,
      "text": "التشابه في أسلوب وألفاظ السفر مع إنجيل يوحنا ورسائله."
    },
    {
      "section_title": "أولًا: كاتبها",
      "content_type": "شرح",
      "father_name": null,
      "text": "التشابه في أسلوب وألفاظ السفر مع إنجيل يوحنا ورسائله."
    },
    {
      "section_title": "ثانيا: لمن كُتِبَت",
      "content_type": "شرح",
      "father_name": null,
      "text": "إلى الكنائس السبع في آسيا الصغرى، أي تركيا الحالية، وهي أهم الكنائس فيها وليس كلها، والمقصود بعدد سبعة هو الكمال فهذه الكنائس تمثل العالم كله في حالاته الروحية المختلفة لذا فالرؤيا موجهة للعالم كله."
    },
    {
      "section_title": "ثالثًا: زمن كتابتها",
      "content_type": "شرح",
      "father_name": null,
      "text": "عام 95 م في أواخر حياة القديس."
    },
    {
      "section_title": "رابعًا: مكان كتابتها",
      "content_type": "شرح",
      "father_name": null,
      "text": "جزيرة بطمس، وهي جزيرة محيطها نحو 25 ميلًا وتقع جنوب غرب تركيا وأهم معالمها هي المغارة التي عاش فيها القديس يوحنا الحبيب."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "محاسبة النفس لمعرفة أسباب الضعف الروحي والتوبة والرجوع إلى الله."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "محاسبة النفس لمعرفة أسباب الضعف الروحي والتوبة والرجوع إلى الله."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "جمال السماء فنتشجع في الجهاد الروحي لنتمتع بالوجود مع الله وأمجاد السماء."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "جمال السماء فنتشجع في الجهاد الروحي لنتمتع بالوجود مع الله وأمجاد السماء."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "النصرة، فمهما قابلنا من ضيقات لا ننزعج عالمين أنها مؤقتة وقوة الشيطان وكل حروبه ستنتهي وكل مباهج العالم ستزول، فلا نتعلق بها ونثق في قوة الله التي تسندنا لننتصر في النهاية ونصل إلى السماء."
    },
    {
      "section_title": "خامسًا: أغراضها",
