      "title": "دعوة للخلاص",
      "verses": "1 -5"
    },
    {
      "number": 2,
      "title": "تجاوب الإنسان",
      "verses": "6 -13"
    }
  ],
  "sections_count": 233,
  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "دعوة عامة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "للخلاص"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "كشف الرب عن عمله في الكنيسة التي"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أقامها من حالة الترمل إلى العرس الأبدي، ومن الخراب إلى"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مدينة الله الثمينة فائقة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الجمال، والآن يفتح الرب أبوابها للجميع كي يأتوا إلى ينبوع المياه الحية ويشربوا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ويرتووا ويجدوا طعامًا لائقًا يُناسب احتياجات الكل، ويدخلوا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "في عهد جديد أبدي. أمام هذه الدعوة يليق بالعطاش أن يُعلنوا عن تجاوبهم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "عمليًا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "بطلب الرب ورفض الشر مع التسليم الكامل بين يدي المخلص بفرح وتهليل قلب."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "1 «أَيُّهَا الْعِطَاشُ جَمِيعًا هَلُمُّوا إِلَى الْمِيَاهِ، وَالَّذِي لَيْسَ لَهُ فِضَّةٌ تَعَالَوْا اشْتَرُوا وَكُلُوا. هَلُمُّوا اشْتَرُوا بِلاَ فِضَّةٍ وَبِلاَ ثَمَنٍ خَمْرًا وَلَبَنًا. 2 لِمَاذَا تَزِنُونَ فِضَّةً لِغَيْرِ خُبْزٍ، وَتَعَبَكُمْ لِغَيْرِ شَبَعٍ؟ اسْتَمِعُوا لِي اسْتِمَاعًا وَكُلُوا الطَّيِّبَ، وَلْتَتَلَذَّذْ بِالدَّسَمِ أَنْفُسُكُمْ. 3 أَمِيلُوا آذَانَكُمْ وَهَلُمُّوا إِلَيَّ. اسْمَعُوا فَتَحْيَا أَنْفُسُكُمْ. وَأَقْطَعَ لَكُمْ عَهْدًا أَبَدِيًّا، مَرَاحِمَ دَاوُدَ الصَّادِقَةَ. 4 هُوَذَا قَدْ جَعَلْتُهُ شَارِعًا لِلشُّعُوبِ، رَئِيسًا وَمُوصِيًا لِلشُّعُوبِ. 5 هَا أُمَّةٌ لاَ تَعْرِفُهَا تَدْعُوهَا، وَأُمَّةٌ لَمْ تَعْرِفْكَ تَرْكُضُ إِلَيْكَ، مِنْ أَجْلِ الرَّبِّ إِلهِكَ وَقُدُّوسِ إِسْرَائِيلَ لأَنَّهُ قَدْ مَجَّدَكَ»."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "جاءت"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "الدعوة الإلهية للتمتع بخلاص الرب المجاني تحمل البنود التالية:"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "دعوة عامة للعطاش: \"أيها العطاش جميعًا هلموا إلى المياه، والذي ليس له"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "فضة تعالوا اشتروا وكلوا هلموا اشتروا بلا فضة وبلا ثمن خمرًا ولبنًا\" [1]."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "إنها دعوة عامة للجميع، أبواب الكنيسة مفتوحة أمام الكل، ينصت إليها من يشعر"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالاحتياج أي \"العطاش\". وكما قال الرب \"طوبى للجياع والعطاش إلى البر فإنهم يشبعون\" (مت 5: 6)."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "سبق فكررنا أن المياه في الكتاب المقدس تُشير أحيانًا إلى الروح القدس الذي يعمل في"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "مياه المعمودية؛ وكأن الدعوة هنا موجهة إلى الجميع للتمتع بالعماد مجانًا."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "يتحدث"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "قول آبائي",
      "father_name": "القديس غريغوريوس النزينزي",
      "text": "القديس غريغوريوس النزينزي عن عطية العماد قائلًا: [لا تتردد مهما كانت"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرحلة طويلة، إن كانت بالبحر أو بالبر ما دامت العطية مُقدمة لك، مهما كانت"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "العوائق كثيرة أو قليلة فإن إشعياء يدعوك: \"أيها العِطاش جميعًا"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "هلموا...\" يا لسرعة مراحم الله، يا لسهولة العهد! إنك تنال هذه البركة بمجرد"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "أن تُريدها. أنه يقبل رغبتك"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "ذاتها"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "كثمن عظيم. أنه يتعطّش إلى عطشك، ويروي كل الراغبين في السرّ. يقدم لطفًا لكل"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "السائلين لطفًا. إنه مستعد للعطاء بسخاء، يفرح بالعطاء أكثر من فرح نائليه]."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "عطاء مشبع للكل، هذه العطية المجانية التي لا تُشترى بفضة ولا بثمن تقدم لكل إنسان"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "احتياجاته؛ فيجد الكبار خمرًا يفرحهم والصغار لبنًا يسندهم."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "الخمر"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "الروحي الذي يتمتع به الكبار يُشير إلى حالة الفرح التي يتمتع بها البالغون في"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "القامة الروحية، فتتلذذ نفوسهم بدسم الرب [2]. وكما يقول"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "الشيخ الروحاني: [طوبى للحامل في قلبه ذكرك في كل وقت، لأن نفسه تسكر دائمًا"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "بحلاوتك]."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "اللبن"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "الروحي المقدم للصغار يُشير إلى ترفق الله بالمبتدئين، فيُقدم لهم ما يناسب"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "معدتهم الروحية حتى ينموا وينضجوا؛ يعرف كيف يُقدم"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "لكل واحد ما هو لبنيانه وسلامه وشبعه وإروائه."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "هكذا لا يشعر أحد بالحرمان بل كما قيل: \"كلوا الطيب"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "ولتتلذذ بالدسم أنفسكم\" [2]."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "يشتاق"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "الجسد إلى الشبع، لكن يعود إليه الجوع مرة أخرى بعد الهضم، لذلك يقول السيد"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "المسيح: \"كل من يشرب من هذا الماء يعطش أيضًا\" (لو 4: 13)..."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "ليتنا نجوع ونعطش إلى البر، لكي ما نشبع منه.."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "ليت إنساننا الداخلي يجوع ويعطش حتى يكون له"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "الطعام والشراب"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "المناسبين له."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "قال (الرب): \"أنا هو الخبز الذي نزل من السماء\" (يو 6: 41). هذا هو خبز"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "الجياع."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "ليتنا نشتاق أيضًا إلى"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "الشرب كالظمأى، \"لأن عندك ينبوع الحياة\" (مز 36: 9)."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "طوبى"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "لمن نسى حديث العالم بحديثه معك، لأن منك تكتمل كل احتياجاته."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "هو أكله وشربه...!"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "أعطيت روح ابنك في قلبه، والروح أعطاه دالة أن يطلب منك كل ما لك، مثلما يطلب"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "الابن من أبيه! معك حديثه في كل حين، لأنه لا يعلم له أبًا غيرك!"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "الشيخ الروحاني"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "إنني لن أشبع إلاَّ عندما يتجلى مجدك قدامي...!"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "يمتلكك تشبع كل رغباته!"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "يا لبشاعة بؤسي! ويحي يا إلهي، فإن قلبي يميل إلى الهروب منك؛ الهروب منك أنت أيها"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "الغني الحقيقي والفرح الحقيقي، لكي يتبع العالم الذي ليس فيه إلاَّ الحزن والألم."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "قول آبائي",
      "father_name": "القديس أغسطينوس",
      "text": "القديس أغسطينوس"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "ليكونوا"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالأكثر محتاجين كي يستحقوا أن يشبعوا، لئلا بينما هم يظهرون التخمة المتعجرفة"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "يُحرمون من الخبز الذي يهب حياة صحية."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"اطلبوا"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرب\" أيها المحتاجون والجياع والعطاش، فانه هو الخبز الحيّ النازل من السماء"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "(يو 6: 33، 51)."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"اطلبوا"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرب فتحيون\". أنتم تطلبون الخبز لكي يعيش جسدكم، والرب يطلبكم لكي تحيا"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "نفوسكم."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "قول آبائي",
      "father_name": "القديس أغسطينوس",
      "text": "القديس أغسطينوس"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "[\"مسود"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "العينين من الخمر ومبيض الأسنان من اللبن\" (تك 49: 12)]."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "عيناه"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "حمراوان بالخمر، هاتان هما شعبه الروحي الذي يسكر بكأسه؛ وأسنانه بيضاء أكثر من"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "البن الذي هو الكلمات التي يرضعها الأطفال الذين لم يتأهلوا للطعام القوي كقول"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرسول (1 كو 3: 2؛ 1 بط 2: 2)."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "قول آبائي",
      "father_name": "القديس أغسطينوس",
      "text": "القديس أغسطينوس"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "لتسكر، ولكن كن"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "حذرًا من المصدر."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "إن كانت تشرب بكثرة من كأس الرب الرائعة فسيُرى سُكرك في أعمالك،"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "ويظهر في حبك القدسي للبر، وأخيرًا في تغرُّب ذهنك عن الأرضيات إلى السمويات."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "قول آبائي",
      "father_name": "القديس أغسطينوس",
      "text": "القديس أغسطينوس"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "لنتقدم"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "إذن إلى مسيحنا ونشترِ خمره ولبنه مجانًا حسب وعده ودعوته."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "دخول في عهد أبدي لإقامة مملكة"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "داود الساقطة حسب الوعد الإلهي الصادق؛ \"وأقطع"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "لكم عهدًا أبديًا، مراحم داود الصادقة\" [3]. خلال هذا العهد نصير"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "ملوكًا (رؤ 5: 10) منتسبين لملك الملوك الذي قيل عنه \"هوذا قد جعلته"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "شارعًا للشعوب، رئيسًا وموصيًا للشعوب\" [4]. هو الملك واضع شريعة"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "العهد الجديد والوصية الجديدة لا لشعب معين بل لكل الشعوب."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "قبول الأمم الوثنية الراجعة إلى الله بالإيمان: \"ها أمة لا تعرفها تدعوها"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "وأمة لم تعرفك تركض إليك من أجل الرب إلهك وقدوس إسرائيل لأنه قد مجدك\" [5]."
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "يكن هذا الأمر مقبولًا لدى الشعب القديم، بل وحتى بعد انفتاح الباب أمام الأمم"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "بقيت الكنيسة في العالم كله إلى قرون في دهشة أمام حب الله للبشرية كلها، يجتذبهم"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "من الوثنية ورجاساتها ليعلنوا مجد الله. في عجب يقول"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "قول آبائي",
      "father_name": "القديس أغسطينوس",
      "text": "القديس أغسطينوس: [كيف"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "دخلت الأمم إلى الإيمان هكذا سريعًا...؟! نسألهم: ماذا تريدون؟ يجيبون:"
    },
    {
      "section_title": "1. دعوة للخلاص",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"معرفة مجد الله\"]."
    },
    {
      "section_title": "2. تجاوب الإنسان",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "6 اُطْلُبُوا الرَّبَّ مَا دَامَ يُوجَدُ. ادْعُوهُ وَهُوَ قَرِيبٌ. 7 لِيَتْرُكِ الشِّرِّيرُ طَرِيقَهُ، وَرَجُلُ الإِثْمِ أَفْكَارَهُ، وَلْيَتُبْ إِلَى الرَّبِّ فَيَرْحَمَهُ، وَإِلَى إِلهِنَا لأَنَّهُ يُكْثِرُ الْغُفْرَانَ. 8 «لأَنَّ أَفْكَارِي لَيْسَتْ أَفْكَارَكُمْ، وَلاَ طُرُقُكُمْ طُرُقِي، يَقُولُ الرَّبُّ. 9 لأَنَّهُ كَمَا عَلَتِ السَّمَاوَاتُ عَنِ الأَرْضِ، هكَذَا عَلَتْ طُرُقِي عَنْ طُرُقِكُمْ وَأَفْكَارِي عَنْ أَفْكَارِكُمْ. 10 لأَنَّهُ كَمَا يَنْزِلُ الْمَطَرُ وَالثَّلْجُ مِنَ السَّمَاءِ وَلاَ يَرْجِعَانِ إِلَى هُنَاكَ، بَلْ يُرْوِيَانِ الأَرْضَ وَيَجْعَلاَنِهَا تَلِدُ وَتُنْبِتُ وَتُعْطِي زَرْعًا لِلزَّارِعِ وَخُبْزًا لِلآكِلِ، 11 هكَذَا تَكُونُ كَلِمَتِي الَّتِي تَخْرُجُ مِنْ فَمِي. لاَ تَرْجعُ إِلَيَّ فَارِغَةً، بَلْ تَعْمَلُ مَا سُرِرْتُ بِهِ وَتَنْجَحُ فِي مَا أَرْسَلْتُهَا لَهُ. 12 لأَنَّكُمْ بِفَرَحٍ تَخْرُجُونَ وَبِسَلاَمٍ تُحْضَرُونَ. الْجِبَالُ وَالآكَامُ تُشِيدُ أَمَامَكُمْ تَرَنُّمًا، وَكُلُّ شَجَرِ الْحَقْلِ تُصَفِّقُ بِالأَيَادِي. 13 عِوَضًا عَنِ الشَّوْكِ يَنْبُتُ سَرْوٌ، وَعِوَضًا عَنِ الْقَرِيسِ يَطْلَعُ آسٌ. وَيَكُونُ لِلرَّبِّ اسْمًا، عَلاَمَةً أَبَدِيَّةً لاَ تَنْقَطِعُ»."
    },
    {
      "section_title": "2. تجاوب الإنسان",
      "content_type": "شرح",
      "father_name": null,
      "text": "أمام"
    },
    {
      "section_title": "2. تجاوب الإنسان",
      "content_type": "شرح",
      "father_name": null,
      "text": "هذه الدعوة العامة المجانية المقدسة للعطاش يليق بالإنسان أن يعلن تجاوبه معها"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "الصلاة أو طلب الله للالتقاء معه: \"اطلبوا الرب ما دام يوجد ادعوه وهو قريب\""
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "كان الله قد أحبنا أولًا، نزل إلينا ليعلن أنه ليس ببعيد عنا إنما على أبواب"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "قلوبنا يقرعها لنفتح له ويدخل فيها (رؤ 3: 20)، فإنه يليق بنا أن نطلبه سائلين إياه"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "أن يتسلم مفاتيح قلوبنا لكي يفتح فيدخل ويغلق فلا يشاركه أحد في قلوبنا، بكونه"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"يفتح ولا أحد يغلق، ويغلق ولا أحد يفتح\"."
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "إعلان"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "قبولنا لحب الله خلال الصلاة هو تجاوب الحب بالحب، وإعلان النفس عن رغبتها في"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "عريسها الفريد الذي يطلب يدها أبديًا."
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "التوبة: \"ليترك الشرير طريقه ورجل الإثم أفكاره وليتب إلى الرب فيرحمه"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "وإلى إلهنا لأنه يكثر الغفران\" [7]."
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "ماذا"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "تعني التوبة إلاَّ الإعلان عن قبول النور دون الظلمة، والمسيح دون بليعال (2 كو 6: 14)؟!"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "التوبة"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "هي الطريق الذي مهد به القديس يوحنا المعمدان للسيد المسيح، والذي كرز به التلاميذ"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "لتهيئة البشرية لقبول ملكوته في داخلهم!"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "الاتكال على حكمة الله والثقة في خطته وتدابيره نحونا، إذ يقول: \"لأن"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "أفكاري ليست أفكاركم ولا طرقكم طرقي يقول الرب، لأنه كما علت السموات عن الأرض"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "هكذا علت طرقي عن طرقكم وأفكاري عن أفكاركم\" [8]."
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "إيماننا"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالعريس السماوي يستلزم الاتكال عليه بثقة في إمكانياته كقدير كُلّي الحكمة والحب،"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "يعرف كيف يخطط لعروسه، لبنيانها وخلاصها، حتى إن بدت خطته قاسية وتدابيره مُرّة."
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "الارتواء بكلمة الرب واهبة الثمر: \"لأنه كما ينزل المطر والثلج من السماء"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "ولا يرجعان إلى هناك بل يرويان"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأرض ويجعلانها تلد وتنبت وتعطي زرعًا للزارع وخبزًا للآكل هكذا تكون كلمتي التي"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "تخرج من فمي، لا ترجع فارغة، بل تعمل ما سررت به وتنجح في ما أرسلتها له\" [10-11]."
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "نزل كلمة الله متجسدًا ليروي الطبيعة البشرية بدمه كمطر فريد قادر أن يُعيد خلقتها ويُجددها، محولًا إياها من"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "برية قاحلة تسكنها الوحوش العنيفة إلى فردوس مثمر يسكنه الثالوث القدوس ويتهلل به"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "السمائيون وأيضًا الأرضيون. هكذا يليق"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "بنا أيضًا أن نقبل كلمة الله المكتوبة لا للدراسة العقلانية البحتة وإنما كحياة"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "مُعاشة تُعطي ثمرًا إلهيًا."
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "التسبيح الدائم علامة قبول العريس قلبيًا والتجاوب معه داخليًا؛ \"لأنكم"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "بفرح تخرجون وبسلام تُحضرون، الجبال والآكام تشيد أمامكم ترنمًا وكل شجر الحقل"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "تصفق بالأيادي\" [12]."
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "الخروج بفرح إنما يعني خروج النفس من \"الأنا\"،"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "واتساعها بالحب لحساب عريسها وكل أحبائه، اتساعها للسمائيين والأرضيين... تخرج لكي"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "تعود بالكل في سلام ومصالحة مع الله والملائكة والبشر. هذا الحب المتسع يخلق جوًا"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "من الفرح خلاله تترنم الجبال والتلال أي جماعة المؤمنين المحيطين بك، إذ يرون"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "عُرسًا أبديًا قائمًا في داخلك. أما شجر الحقل الذي يُصفق"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالأيادي فيعني أن الفرح لا يكون باللسان فحسب وإنما يُعلن بالعمل (بالأيادي)..."
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "ثمر إيجابي متكاثر، فلا يكفي انتزاع الشوك والقريس وإنما يلزم ظهور السرو والآس"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "علامة ختمنا باسم الرب واهب"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "الثمر الروحي. بمعنى آخر قبولنا لدعوته لا يعني تركنا"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "للشر فحسب وإنما صنعنا برّ المسيح وممارستنا حياته"
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "القدسية المثمرة بعمل روحه القدوس فينا."
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "On Holy Baptism 28."
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "On Ps. 70."
    },
    {
      "section_title": "وقبوله لها عمليًا بالوسائط التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "City of God 16:41."
    },
    {
