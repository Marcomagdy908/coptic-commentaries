    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "سيف الرب على الفلسطينيين الوثنيين"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "والقوات"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "المتحالفة معهم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "إرميا النبي نبواته ضد الأمم بمصر بكونها ترمز لحياة الرخاوة والتهاون كأول باب"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ينفتح للخطايا كي تتسلل إلى النفس وتفسدها. الآن يتحدث عن الفلسطينيين  الوثنيين"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "حيث كانوا يحملون عداوة ضد الله الحيَّ وضد شعبه. كأن هذه النبوات موجهة ضد خطية"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "العنف والعداوة لله وللناس."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "غالبًا ما برهن المصريون أنهم أصدقاء"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "باطلون، قدموا وعودًا بالخلاص، فدفعوا شعب الله إلى الاتكال على الذراع البشري"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "العاجز، أما الفلسطينيون فغالبًا ما حملوا روح العداوة والمقاومة، ومما يزيدهم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "خطورة أنهم كانوا من ألصق الجيران لهم."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "بدأت العداوة بدخول الإسرائيليين أرض الموعد"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "حيث احتلوا بعض مدنهم بعد موت يشوع (قض 1: 18)، ولكن الفلسطينيين استردوا مدنهم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "وسقط العبرانيون في قبضتهم (قض 10: 6-7) ثم أُنقذوا. عاد فأذل الفلسطينيون"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "العبرانيين أربعين عامًا حتى أنقذهم شمشون (قض 14-16)، وفي عهد صموئيل النبي"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "استولوا على تابوت العهد (1 صم 14-16)، ثم عاد فهزمهم صموئيل النبي بعد عشرين"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "عامًا. دخلوا في حرب مع إسرائيل في أيام شاول الملك، وأُخضعوا في أيام داود النبي،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "لكنهم برزوا ثانية للمقاومة حتى جاء نبوخذنصر الذي حطمهم مع بقية الأمم المجاورة."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "تخلل"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "هذه النبوات نبوة عن الحلفاء مع الفلسطينيين: قوات صور وصيدا [4]."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "نبوات ضد الفلسطينيين"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "نبوات ضد صور وصيدا"
    },
    {
      "section_title": "1. نبوات ضد الفلسطينيين الوثنيين",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "1 كَلِمَةُ الرَّبِّ الَّتِي صَارَتْ إِلَى إِرْمِيَا النَّبِيِّ عَنِ الْفِلِسْطِينِيِّينَ قَبْلَ ضَرْبِ فِرْعَوْنَ غَزَّةَ: 2 «هكَذَا قَالَ الرَّبُّ: هَا مِيَاهٌ تَصْعَدُ مِنَ الشِّمَالِ وَتَكُونُ سَيْلًا جَارِفًا، فَتُغَشِّي الأَرْضَ وَمِلأَهَا، الْمَدِينَةَ وَالسَّاكِنِينَ فِيهَا، فَيَصْرُخُ النَّاسُ، وَيُوَلْوِلُ كُلُّ سُكَّانِ الأَرْضِ. 3 مِنْ صَوْتِ قَرْعِ حَوَافِرِ أَقْوِيَائِهِ، مِنْ صَرِيرِ مَرْكَبَاتِهِ وَصَرِيفِ بَكَرَاتِهِ لاَ تَلْتَفِتُ الآبَاءُ إِلَى الْبَنِينَ، بِسَبَبِ ارْتِخَاءِ الأَيَادِي. 4 بِسَبَبِ الْيَوْمِ الآتِي لِهَلاَكِ كُلِّ الْفِلِسْطِينِيِّينَ، لِيَنْقَرِضَ مِنْ صُورَ وَصَيْدُونَ كُلُّ بَقِيَّةٍ تُعِينُ، لأَنَّ الرَّبَّ يُهْلِكُ الْفِلِسْطِينِيِّينَ، بَقِيَّةَ جَزِيرَةِ كَفْتُورَ. 5 أَتَى الصُّلْعُ عَلَى غَزَّةَ. أُهْلِكَتْ أَشْقَلُونُ مَعَ بَقِيَّةِ وَطَائِهِمْ. حَتَّى مَتَى تَخْمِشِينَ نَفْسَكِ. 6 آهِ، يَا سَيْفَ الرَّبِّ، حَتَّى مَتَى لاَ تَسْتَرِيحُ؟ انْضَمَّ إِلَى غِمْدِكَ! اهْدَأْ وَاسْكُنْ. 7 كَيْفَ يَسْتَرِيحُ وَالرَّبُّ قَدْ أَوْصَاهُ عَلَى أَشْقَلُونَ، وَعَلَى سَاحِلِ الْبَحْرِ هُنَاكَ وَاعَدَهُ؟»."
    },
    {
      "section_title": "1. نبوات ضد الفلسطينيين الوثنيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"كلمة"
    },
    {
      "section_title": "1. نبوات ضد الفلسطينيين الوثنيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرب التي صارت إلى إرميا النبي عن الفلسطينيين قبل ضرب فرعون غزة\" [1]."
    },
    {
      "section_title": "1. نبوات ضد الفلسطينيين الوثنيين",
      "content_type": "شرح",
      "father_name": null,
      "text": "نعرف القليل جدًا عن الزمن الذي يقصده"
    },
    {
      "section_title": "هنا الخاص بضرب فرعون غزة، ربما يقصد أحد المواقف التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "عندما"
    },
    {
      "section_title": "هنا الخاص بضرب فرعون غزة، ربما يقصد أحد المواقف التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "كان فرعون نخو في الشمال [2] بين (609 و605 ق.م.) يترقب الدخول في معركة حاسمة مع"
    },
    {
      "section_title": "هنا الخاص بضرب فرعون غزة، ربما يقصد أحد المواقف التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "نبوخذنصر على نهر الفرات، مؤكدًا في ذلك الحين سلطانه على الفلسطينيين."
    },
    {
      "section_title": "هنا الخاص بضرب فرعون غزة، ربما يقصد أحد المواقف التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "ربما"
    },
    {
      "section_title": "هنا الخاص بضرب فرعون غزة، ربما يقصد أحد المواقف التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "ضرب فرعون نخو غزة عند عودته بعد غلبته على يوشيا في موقعة مجدو (2 أي 35: 20)."
    },
    {
      "section_title": "هنا الخاص بضرب فرعون غزة، ربما يقصد أحد المواقف التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "* عند"
    },
    {
      "section_title": "هنا الخاص بضرب فرعون غزة، ربما يقصد أحد المواقف التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "عودته من محاولته الفاشلة لإنقاذ أورشليم من الكلدانيين، ضرب غزة حتى لا يظن أحد"
    },
    {
      "section_title": "هنا الخاص بضرب فرعون غزة، ربما يقصد أحد المواقف التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "أنه عاد إلى بلده"
    },
    {
      "section_title": "هنا الخاص بضرب فرعون غزة، ربما يقصد أحد المواقف التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "فاشلًا."
    },
    {
      "section_title": "هنا الخاص بضرب فرعون غزة، ربما يقصد أحد المواقف التالية",
      "content_type": "شرح",
      "father_name": null,
      "text": "يتحدث"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"هكذا"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "قال الرب:"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "مياه تصعد من الشمال وتكون سيلًا جارفًا فتغشي الأرض وملأها،"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "المدينة"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "والساكنين فيها،"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "يصعد الجيش البابلي الذي زحف بقوة عليهم بعد غلبته على المصريين في"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "كركميش كمياه"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "تنهار عليهم من الشمال [3]؛ هنا لا يقصد ب\"الشمال\""
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الاتجاه الجغرافي فحسب، لكنه يرمز للقوة المضادة أيا كان مصدرها."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "يحل الجيش المهاجم عليهم كسيلٍ جارفٍ [2] يغرق الأرض وكل ملئها،"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "المدينة والساكنين فيها [2]. يشبه الكلدانيون بالسيل الجارف أو فيضان مياه كثيرة"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "تصدر عن نهرهم"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الفرات. كثرة المياه تعني كثرة الجماهير التي تحل على موقع ما كفيضان."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "للشيطان"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "طرق كثيرة، يعرف كيف يحل بالنفس كسيلٍ جارفٍ يسقط عليها فجأة ليحوط بها من"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "كل جانب، فيشل كل حركتها، ويفقدها التمتع بأية معونة خارجية، وأحيانًا يتسلل خفية"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "إلى النفس ليدخل إلى أعماقها ويتسلم عجلة قيادتها."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "كل ما لعدو الخير من حيل وخبرات طويلة وقدرات خطيرة، لا يحمل سلطانًا عليها للتسلل"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "إلى داخلها ما لم يكن الباب مفتوحًا، ويجد في الداخل من يتجاوب معه. كما ليس له"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "سلطان أن يحل بالنفس فجأة ويسيطر عليها إن كانت في يد الله، محفوظة بنعمته. في هذا"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "يؤكد"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "قول آبائي",
      "father_name": "القديس يوحنا ذهبي الفم",
      "text": "القديس يوحنا الذهبي الفم أنه ليس لعدو الخير سلطان علينا، ولن يقدر"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "أن يؤذينا ما لم يؤذِ الإنسان نفسه بنفسه."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "يغطي السيل الجارف الأرض وملأها [2]، لكنه لا يستطيع أن يقترب من السماء"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "ولا أن يصل إليها. فإن كانت النفس أرضًا تغرق بسيول الخطايا، أما التي صارت سماءً"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "بسكنى السماوي فيها فلا تقدر الخطية أن تقترب إليها."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"يصرخ الناس ويولول كل سكان الأرض\" [2]. إذ اختاروا الأرض"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "لا السماء مسكنًا لنفوسهم لا يختبروا فرح السماء وتهليلاتها بل الصراخ والولولة."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "مسكين الإنسان الذي يحرم نفسه من بهجة الخلاص فلا يختبر الفرح الداخلي حتى وسط"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "تسلياته ونجاحة الزمني، ومطوَّب هو ذاك الذي يجلس مع الرسول بولس في السماويات (أف 2: 6)، فإنه وإن دخل في ضيقات كثيرة يفرح ويتهلل بالله مخلصه، الذي يحول أتون"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الضيق إلى ندى السماء، كما فعل مع الثلاثة فتيه الغرباء."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "صوت قرع حوافر أقويائه،"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "صرير مركباته،"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "وصريف"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "بكراته،"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "تلتفت الآباء إلى البنين بسبب ارتخاء الأيادي\" [3]."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "يفقدون"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "حتى العواطف الطبيعية التي تربط الوالدين بأبنائهم، إذ لا يلتفت الآباء إلى بنيهم"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "حيث ترتخي أياديهم بسبب صوت الجيش المرعب الصادر عن حوافر الخيول والمركبات"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "العسكرية والبكرات. ليس لديهم الشجاعة ولا القوة للعودة إلى الخلف لإنقاذ أبنائهم"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الذين تركوهم."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "حقًا"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "إذ تدخل الخطية إلى القلب ترهبه فلا يبالي الإنسان بخلاص نفسه وخلاص بنيه... لا"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "يلتفت إليهم، بل يصير في رعبٍ ورعدةٍ."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "و. \"بسبب اليوم الآتي"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "لهلاك كل الفلسطينيين لينقرض من صور وصيدُون كل بقية تعين،"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرب يُهلك الفلسطينيين بقية جزيرة كفتور\" [4]."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "يحطم المتحالفين معهم، صور وصيدا [4]"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "ويُهلك الفلسطينيون في جذورهم إذ يشير إليهم في جزيرة كفتور، وهي تشير في العهد"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "القديم إلى جزيرة كريت، الأرض التي جاء منها الفلسطينيون أصلًا (عا 9: 7). ربما"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "قصد بالكريتيين هنا جماعة من الفلسطينيين كانوا قد قدموا من جزيرة كريت في الربع"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأول من القرن الثاني عشر ق.م."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "ز. \"أتي الصلع على"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "غزة\" [5]."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "تشبه"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "فلسطين بسيدة أو فتاة قصت شعرها حتى القرع، وجرحت جسمها. هذه وسائل وثنية تستخدم"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "للتعبير عن الحزن الشديد (لا 19: 28)، خاصة عند موت الأقرباء جدًا (إر 16: 6؛ 41: 5)،"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "أو هو وصف يعبر عن مسح غزة من كل إنسانٍ كما بموسى فلا يُترك فيها أحدٌ. ربما يقصد"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالصلع أن العدو سلبهم كل ممتلكاتهم من ذهبٍ وفضةٍ وحجارةٍ كريمة فصاروا كالقرع"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "بلا زينة."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"أُهِلكت"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "أشقلون مع بقية وطائهم\" [5]."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "أشقلون: هي إحدى المدن الفلسطينية"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الخمس الرئيسية، مكانها اليوم مدينة عسقلان. كان لها ميناء بحري في العصور"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الغابرة. اسم الإلهة الرئيسية في اشقلون دركتو، لها وجه إنسان وجسم سمكة.  تقع على"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "بعد عشرة أميال شمال غزة. وفي عصر العمارنة كان يحكمها ملك مصري (تث 2: 23). وفي"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "التواريخ الأشورية عرفت ب As-qa-en-na."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "تُصاب النفس بالجراحات إراديًا، فمن يخضع للخطية يحطم نفسه بالجراحات الداخلية،"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "لذا يُقال لها بروح التوبيخ:"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"حتى"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "متى تخمشين نفسكِ؟!"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "يا سيف الرب حتى متى لا تستريح؟!"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "أنضم"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "إلى غمدك، أهدأ وأسكن."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "يستريح والرب قد أوصاه؟!"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "أشقلون وعلى ساحل البحر هناك واعده\" [5-7]."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "يُسمى"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "سيف بابل هنا \"سيف الرب\"، لأنه يشبه المنجل في يد الله، به يحصد سكان"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "المدن الذين كمل شرهم وسقطوا تحت الغضب الإلهي."
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "أن كلمة الله لا ترجع فارغة حتى تحقق رسالتها، هكذا سيف الرب (أو تأديبه) لا يتوقف"
    },
    {
      "section_title": "عن انهيار الفلسطينيين هكذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "حتى يتمم ما أُرسل لأجله."
    },
    {
      "section_title": "2. نبوات ضد صور وصيدا",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"لِيَنْقَرِضَ مِنْ صُورَ وَصَيْدُونَ كُلُّ بَقِيَّةٍ تُعِينُ\" [4]."
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"صور\" اسم سامي معناه"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"صخر\"، ربما لأنها قامت على جزيرة صخرية، إلا أن"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "قول آبائي",
      "father_name": "القديس جيروم",
      "text": "القديس جيروم"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "يرى أن كلمة \"صور\" في العبرية تعني \"محنة\"، ولذا يرى سكانها"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "يمثلون الساقطين تحت محنة الشيطان وبلاياه."
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "كما يفسر اسمهم: \"موت بسبب جرعةٍ سامةٍ\"، لذلك"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "كانوا في رأيه يمثلون الذين يشربون كأس غواية الشيطان فيسقطون سريعًا."
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "أما \"صيدون\" فتعني"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"أرض صيد سمك\"، اشتركت مع صور في السخرية من يهوذا عند سبيها. اتسمت صور"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "وصيدا بالغنى الشديد خلال تجارتهما العالمية مع الانحلال والفساد."
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "في سفر إشعياء النبي يشبه الله"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"صور\" بزانية تزني مع كل ممالك البلاد على وجه الأرض (إش 23: 17)، لكنها"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "إذ تتمتع بالإيمان الحيّ \"تكون تجارتها وأجرتها قدسًا للرب\" (إش 26: 18)."
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "نالت كل من صور وصيدُون (صيدا) نصيبهما من الجيش البابلي"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "لمنع أية قوة عسكرية فينيقية تهب لنجدة فلسطين من أيدي البابليين. قدم حزقيال"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "النبي نبوات ضد صور وصيدا (حز 26-27)، وقد سبق لنا التعليق عليها في"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "دراستنا لسفر"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "حزقيال."
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "وحي إرميا 47"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "من ينقذني من سيول خطاياي الجارفة؟!"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "إنقذني"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "من سيول خطاياي الجارفة"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "التي حلت بأرض قلبي فغطتها بمياهٍ"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "مهلكةٍ،"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "غرَّقت كل زرعٍ مقدسٍ في داخلي!"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "حوِّل"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "أرضي إلى سماء"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "فلا تقدر مياه كثيرة أن تقترب إليها!"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "عوض الصراخ يمتلئ قلبي تهليلًا!"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "عوض جفاف العاطفة يتسع قلبي بالحب"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "للجميع!"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "عوض معونة الناس أترقب غنى نعمتك!"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "عوض القبح اسكب جمالك فيّ!"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
      "text": "يعود سيف الرب يجرح ويقتل أعماقي،"
    },
    {
      "section_title": "صور وصيدُون",
      "content_type": "شرح",
      "father_name": null,
