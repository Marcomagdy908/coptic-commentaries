  "sections_count": 171,
  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "السموات"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الجديدة والأرض الجديدة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "يطالبنا الله أن"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "نحمل شوقًا نحو نزوله إلينا وحلوله في داخلنا، معترفين بأعماله الخلاصية الفائقة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "في حياتنا مع اعترافنا بآثامنا وعجز كل برّ ذاتي فينا، الآن يعلن دعوته للأمم بغير"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "محاباة ليتمتع الكل بالحياة الجديدة فيه، والتي يُحرم منها الجاحدون أيا كان"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "جنسهم."
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "1 «أَصْغَيْتُ إِلَى الَّذِينَ لَمْ يَسْأَلُوا. وُجِدْتُ مِنَ الَّذِينَ لَمْ يَطْلُبُونِي. قُلْتُ: هأَنَذَا، هأَنَذَا. لأُمَّةٍ لَمْ تُسَمَّ بِاسْمِي."
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"أصغيت"
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "إلى الذين لم يسألوا، وُجدت من الذين لم يطلبوني، قلت هأنذا لأمة لم تُسم باسمي\""
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "[1]. واضح هنا أن الحديث خاص بقبول الأمم التي لم تعرف الله ولا طلبته قبلًا"
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "ولا حملت اسمه، لكنها آمنت بالمخلص فتمتعت بما حرم شعب الله نفسه بنفسه منه."
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "تحدث"
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "القديس بولس عن دعوة الأمم ورفض الجاحدين من اليهود في رسالته إلى أهل رومية (رو 9: 11)، مستشهدًا بالعبارة النبوية الواردة هنا (رو 10: 20-21). فقد أصغى الله إلى"
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأمم التي لم تسأله، ووجده هؤلاء الذين لم يطلبوه، لأننا ونحن أعداء صالحنا مع"
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الآب. أحب البشرية كلها قبلما تحبه، واختارنا قبلما نعرفه أو نطلبه. لقد أمال"
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "قلوبنا إليه إذ بادرنا بالحب قبلما يُدعى اسمه علينا."
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "يقول"
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "قول آبائي",
      "father_name": "القديس يوحنا ذهبي الفم",
      "text": "القديس يوحنا الذهبي الفم: [هل سمع إسرائيل ولم يفهم؟ إن كانت الأمم"
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الوثنية قد سمعت وأدركت الإيمان فكم بالحري كان يليق باليهود الذين أعطاهم الله"
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "منذ القدم كل العلامات التي تستهدف إزالة الغشاوة عن عيونهم]."
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "من هم الذين لم يبحثوا عنه؟ من هم الذين لم يسألوا عنه؟ بالتأكيد ليس"
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "اليهود بل الذين هم من الأمم التي لم تعرفه، هؤلاء وصفهم موسى بالكلمات:"
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"ليسوا شعبًا\"، \"أمة غبية\"؛ وعلى ذات الأساس يُشير إليهم هنا من جهة جهلهم"
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الزائد."
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "عار عظيم للغاية أن الذين لم يطلبوه وجدوه، والذين بحثوا عنه فقدوه (بعدم"
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "شرح",
      "father_name": null,
      "text": "إيمانهم)."
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "قول آبائي",
      "father_name": "القديس يوحنا ذهبي الفم",
      "text": "القديس يوحنا الذهبي الفم"
    },
    {
      "section_title": "1. دعوة الأمم",
      "content_type": "قول آبائي",
      "father_name": "القديس هيبوليتس",
      "text": "القديس هيبوليتس"
    },
    {
      "section_title": "2. جحود شعبه",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "2 بَسَطْتُ يَدَيَّ طُولَ النَّهَارِ إِلَى شَعْبٍ مُتَمَرِّدٍ سَائِرٍ فِي طَرِيق غَيْرِ صَالِحٍ وَرَاءَ أَفْكَارِهِ. 3 شَعْبٍ يُغِيظُنِي بِوَجْهِي. دَائِمًا يَذْبَحُ فِي الْجَنَّاتِ، وَيُبَخِّرُ عَلَى الآجُرِّ. 4 يَجْلِسُ فِي الْقُبُورِ، وَيَبِيتُ فِي الْمَدَافِنِ. يَأْكُلُ لَحْمَ الْخِنْزِيرِ، وَفِي آنِيَتِهِ مَرَقُ لُحُومٍ نَجِسَةٍ. 5 يَقُولُ: قِفْ عِنْدَكَ. لاَ تَدْنُ مِنِّي لأَنِّي أَقْدَسُ مِنْكَ. هؤُلاَءِ دُخَانٌ فِي أَنْفِي، نَارٌ مُتَّقِدَةٌ كُلَّ النَّهَارِ. 6 هَا قَدْ كُتِبَ أَمَامِي. لاَ أَسْكُتُ بَلْ أُجَازِي. أُجَازِي فِي حِضْنِهِمْ، 7 آثَامَكُمْ وَآثَامَ آبَائِكُمْ مَعًا قَالَ الرَّبُّ، الَّذِينَ بَخَّرُوا عَلَى الْجِبَالِ، وَعَيَّرُونِي عَلَى الآكَامِ، فَأَكِيلُ عَمَلَهُمُ الأَوَّلَ فِي حِضْنِهِمْ»."
    },
    {
      "section_title": "2. جحود شعبه",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"بسطت"
    },
    {
      "section_title": "2. جحود شعبه",
      "content_type": "شرح",
      "father_name": null,
      "text": "يدي طول النهار إلى شعب متمرد سائر في طريق غير صالح وراء أفكاره\" لقد"
    },
    {
      "section_title": "2. جحود شعبه",
      "content_type": "شرح",
      "father_name": null,
      "text": "بسط الرب يديه على الصليب بالحب ليحتضن الكل ويهبهم حياة الغلبة كما بسط موسى"
    },
    {
      "section_title": "2. جحود شعبه",
      "content_type": "شرح",
      "father_name": null,
      "text": "النبي يديه أثناء المعركة ضد عماليق كرمز لعمل المسيح الخلاصي."
    },
    {
      "section_title": "2. جحود شعبه",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرب يديه من جانبه منتظرًا أن نستجيب لهذا العمل بطلبه كل يوم كما يقول القديس"
    },
    {
      "section_title": "2. جحود شعبه",
      "content_type": "شرح",
      "father_name": null,
      "text": "بفنوتيوس"
    },
    {
      "section_title": "سرّ رفض الله شعبه فهو",
      "content_type": "شرح",
      "father_name": null,
      "text": "تمردهم [2]، طالبين السير حسب أهوائهم الذاتية لا حسب فكر الله."
    },
    {
      "section_title": "سرّ رفض الله شعبه فهو",
      "content_type": "شرح",
      "father_name": null,
      "text": "كسرهم للشريعة، وانحرافهم نحو العبادات الوثنية [3-4]."
    },
    {
      "section_title": "سرّ رفض الله شعبه فهو",
      "content_type": "شرح",
      "father_name": null,
      "text": "اتكالهم على البرّ الذاتي [5]."
    },
    {
      "section_title": "سرّ رفض الله شعبه فهو",
      "content_type": "قول آبائي",
      "father_name": "القديس أغسطينوس",
      "text": "القديس أغسطينوس أن جحد الإيمان بالرب هو موت، فقد شاهدوا معجزات المخلص"
    },
    {
      "section_title": "سرّ رفض الله شعبه فهو",
      "content_type": "شرح",
      "father_name": null,
      "text": "بأعينهم ولم يحيوا خلالها بل بقوا كما في حالة موت."
    },
    {
      "section_title": "3. اهتمامه بالبقية",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "8 هكَذَا قَالَ الرَّبُّ: «كَمَا أَنَّ السُّلاَفَ يُوجَدُ فِي الْعُنْقُودِ، فَيَقُولُ قَائِلٌ: لاَ تُهْلِكْهُ لأَنَّ فِيهِ بَرَكَةً. هكَذَا أَعْمَلُ لأَجْلِ عَبِيدِي حَتَّى لاَ أُهْلِكَ الْكُلَّ. 9 بَلْ أُخْرِجُ مِنْ يَعْقُوبَ نَسْلًا وَمِنْ يَهُوذَا وَارِثًا لِجِبَالِي، فَيَرِثُهَا مُخْتَارِيَّ، وَتَسْكُنُ عَبِيدِي هُنَاكَ. 10 فَيَكُونُ شَارُونُ مَرْعَى غَنَمٍ، وَوَادِي عَخُورَ مَرْبِضَ بَقَرٍ، لِشَعْبِي الَّذِينَ طَلَبُونِي."
    },
    {
      "section_title": "3. اهتمامه بالبقية",
      "content_type": "شرح",
      "father_name": null,
      "text": "كان الشعب ككل قد أخذ موقف الجحود لكن هناك بقية مقدسة للرب مثل التلاميذ والرسل"
    },
    {
      "section_title": "3. اهتمامه بالبقية",
      "content_type": "شرح",
      "father_name": null,
      "text": "والمريمات وزكا العشار ولاوي"
    },
    {
      "section_title": "3. اهتمامه بالبقية",
      "content_type": "شرح",
      "father_name": null,
      "text": "إلخ... هذه القلة المقدسة لا تهلك بل تكون بركة."
    },
    {
      "section_title": "3. اهتمامه بالبقية",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"هكذا قال الرب: كما إن السُلاف يوجد في العنقود فيقول قائل لا تهلكه لأن"
    },
    {
      "section_title": "3. اهتمامه بالبقية",
      "content_type": "شرح",
      "father_name": null,
      "text": "فيه بركة، هكذا أعمل لأجل عبيدي حتى لا أهلك الكل\" [8]."
    },
    {
      "section_title": "3. اهتمامه بالبقية",
      "content_type": "شرح",
      "father_name": null,
      "text": "المقاومين وُجد مختارون للرب، عبيد له، يطلبونه [10]."
    },
    {
      "section_title": "4. مقارنة بين المؤمنين والجاحدين",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "11 «أَمَّا أَنْتُمُ الَّذِينَ تَرَكُوا الرَّبَّ وَنَسُوا جَبَلَ قُدْسِي، وَرَتَّبُوا لِلسَّعْدِ الأَكْبَرِ مَائِدَةً، وَمَلأُوا لِلسَّعْدِ الأَصْغَرِ خَمْرًا مَمْزُوجَةً، 12 فَإِنِّي أُعَيِّنُكُمْ لِلسَّيْفِ، وَتَجْثُونَ كُلُّكُمْ لِلذَّبْحِ، لأَنِّي دَعَوْتُ فَلَمْ تُجِيبُوا، تَكَلَّمْتُ فَلَمْ تَسْمَعُوا، بَلْ عَمِلْتُمُ الشَّرَّ فِي عَيْنَيَّ، وَاخْتَرْتُمْ مَا لَمْ أُسَرَّ بِهِ. 13 لِذلِكَ هكَذَا قَالَ السَّيِّدُ الرَّبُّ: هُوَذَا عَبِيدِي يَأْكُلُونَ وَأَنْتُمْ تَجُوعُونَ. هُوَذَا عَبِيدِي يَشْرَبُونَ وَأَنْتُمْ تَعْطَشُونَ. هُوَذَا عَبِيدِي يَفْرَحُونَ وَأَنْتُمْ تَخْزَوْنَ. 14 هُوَذَا عَبِيدِي يَتَرَنَّمُونَ مِنْ طِيبَةِ الْقَلْبِ وَأَنْتُمْ تَصْرُخُونَ مِنْ كآبَةِ الْقَلْبِ، وَمِنِ انْكِسَارِ الرُّوحِ تُوَلْوِلُونَ. 15 وَتُخْلِفُونَ اسْمَكُمْ لَعْنَةً لِمُخْتَارِيَّ، فَيُمِيتُكَ السَّيِّدُ الرَّبُّ وَيُسَمِّي عَبِيدَهُ اسْمًا آخَرَ. 16 فَالَّذِي يَتَبَرَّكُ فِي الأَرْضِ يَتَبَرَّكُ بِإِلهِ الْحَقِّ، وَالَّذِي يَحْلِفُ فِي الأَرْضِ يَحْلِفُ بِإِلهِ الْحَقِّ، لأَنَّ الضِّيقَاتِ الأُولَى قَدْ نُسِيَتْ، وَلأَنَّهَا اسْتَتَرَتْ عَنْ عَيْنَيَّ."
    },
    {
      "section_title": "4. مقارنة بين المؤمنين والجاحدين",
      "content_type": "شرح",
      "father_name": null,
      "text": "ظن بعض تاركي الرب أنهم ينجون بإقامة ولائم وثنية تتسم بالترف والسكر، ولم يدركوا"
    },
    {
      "section_title": "4. مقارنة بين المؤمنين والجاحدين",
      "content_type": "شرح",
      "father_name": null,
      "text": "أنهم صاروا كغنم للذبح [11-12]."
    },
    {
      "section_title": "4. مقارنة بين المؤمنين والجاحدين",
      "content_type": "شرح",
      "father_name": null,
      "text": "غالبًا ما يظن الجاحدون أنهم يعيشون في ترف بلا حرمان، لكن سرعان ما يشبع المؤمنون"
    },
    {
      "section_title": "4. مقارنة بين المؤمنين والجاحدين",
      "content_type": "شرح",
      "father_name": null,
      "text": "ويجوع الجاحدون، يفرح الأولون ويحزن الآخرون. يتمتع المؤمنون بحياة التسبيح"
    },
    {
      "section_title": "4. مقارنة بين المؤمنين والجاحدين",
      "content_type": "شرح",
      "father_name": null,
      "text": "والتهليل الداخلي بينما ينكسر قلب الجاحدين [13-15]."
    },
    {
      "section_title": "4. مقارنة بين المؤمنين والجاحدين",
      "content_type": "شرح",
      "father_name": null,
      "text": "يتعرض المؤمنون للضيقات لكنهم ينالون بركة الله الحق حتى وهم على الأرض فينسون"
    },
    {
      "section_title": "4. مقارنة بين المؤمنين والجاحدين",
      "content_type": "شرح",
      "father_name": null,
      "text": "متاعبهم وسط تعزيات الله وبركته [16]."
    },
    {
      "section_title": "5. السموات الجديدة والأرض الجديدة",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "17 «لأَنِّي هأَنَذَا خَالِقٌ سَمَاوَاتٍ جَدِيدَةً وَأَرْضًا جَدِيدَةً، فَلاَ تُذْكَرُ الأُولَى وَلاَ تَخْطُرُ عَلَى بَال. 18 بَلِ افْرَحُوا وَابْتَهِجُوا إِلَى الأَبَدِ فِي مَا أَنَا خَالِقٌ، لأَنِّي هأَنَذَا خَالِقٌ أُورُشَلِيمَ بَهْجَةً وَشَعْبَهَا فَرَحًا. 19 فَأَبْتَهِجُ بِأُورُشَلِيمَ وَأَفْرَحُ بِشَعْبِي، وَلاَ يُسْمَعُ بَعْدُ فِيهَا صَوْتُ بُكَاءٍ وَلاَ صَوْتُ صُرَاخٍ. 20 لاَ يَكُونُ بَعْدُ هُنَاكَ طِفْلُ أَيَّامٍ، وَلاَ شَيْخٌ لَمْ يُكْمِلْ أَيَّامَهُ. لأَنَّ الصَّبِيَّ يَمُوتُ ابْنَ مِئَةِ سَنَةٍ، وَالْخَاطِئُ يُلْعَنُ ابْنَ مِئَةِ سَنَةٍ. 21 وَيَبْنُونَ بُيُوتًا وَيَسْكُنُونَ فِيهَا، وَيَغْرِسُونَ كُرُومًا وَيَأْكُلُونَ أَثْمَارَهَا. 22 لاَ يَبْنُونَ وَآخَرُ يَسْكُنُ، وَلاَ يَغْرِسُونَ وَآخَرُ يَأْكُلُ. لأَنَّهُ كَأَيَّامِ شَجَرَةٍ أَيَّامُ شَعْبِي، وَيَسْتَعْمِلُ مُخْتَارِيَّ عَمَلَ أَيْدِيهِمْ. 23 لاَ يَتْعَبُونَ بَاطِلًا وَلاَ يَلِدُونَ لِلرُّعْبِ، لأَنَّهُمْ نَسْلُ مُبَارَكِي الرَّبِّ، وَذُرِّيَّتُهُمْ مَعَهُمْ. 24 وَيَكُونُ أَنِّي قَبْلَمَا يَدْعُونَ أَنَا أُجِيبُ، وَفِيمَا هُمْ يَتَكَلَّمُونَ بَعْدُ أَنَا أَسْمَعُ. 25 الذِّئْبُ وَالْحَمَلُ يَرْعَيَانِ مَعًا، وَالأَسَدُ يَأْكُلُ التِّبْنَ كَالْبَقَرِ. أَمَّا الْحَيَّةُ فَالتُّرَابُ طَعَامُهَا. لاَ يُؤْذُونَ وَلاَ يُهْلِكُونَ فِي كُلِّ جَبَلِ قُدْسِي، قَالَ الرَّبُّ»."
    },
    {
      "section_title": "5. السموات الجديدة والأرض الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "يقدم"
    },
    {
      "section_title": "5. السموات الجديدة والأرض الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "لنا إشعياء النبي صورة رائعة عن عمل السيد المسيح الخالق لإقامة كنيسة العهد"
    },
    {
      "section_title": "5. السموات الجديدة والأرض الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الجديد."
    },
    {
      "section_title": "5. السموات الجديدة والأرض الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "لقد أقام سموات جديدة وأرضًا جديدة [17]؛ أقام تجديدًا حقيقيًا للنفس"
    },
    {
      "section_title": "5. السموات الجديدة والأرض الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "(السموات) وللجسد (الأرض)، فصارت النفس والجسد معًا في انسجام، إذ خضع كلاهما"
    },
    {
      "section_title": "5. السموات الجديدة والأرض الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "لروحه القدوس. انتهى الصراع القديم بين شهوات النفس وشهوات الجسد، ودخلنا بالروح"
    },
    {
      "section_title": "5. السموات الجديدة والأرض الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "القدس إلى حياة الفرح الروحي والبهجة السماوية،"
    },
    {
      "section_title": "5. السموات الجديدة والأرض الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "إذ امتلأت حياتنا بثمر الروح القدس"
    },
    {
      "section_title": "5. السموات الجديدة والأرض الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "من محبة وفرح وسلام (غلا 5: 22). نفرح نحن كعروس مقدسة متجددة بعريسها، ويفرح هو"
    },
    {
      "section_title": "5. السموات الجديدة والأرض الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "بنا، إذ يقول: \"فأبتهج بأورشليم وأفرح بشعبي\" [19]. إنها فرحة"
    },
    {
      "section_title": "5. السموات الجديدة والأرض الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الحب المشترك!"
    },
    {
      "section_title": "5. السموات الجديدة والأرض الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "هذه الحياة الجديدة التي صارت لنا في المعمودية تتحول الذئاب إلى حملان فيرعى"
    },
    {
      "section_title": "5. السموات الجديدة والأرض الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الذئب مع الحمل، وتتحطم طبيعة الافتراس والشراسة فيأكل الأسد مع البقر. أما الحيات"
    },
    {
      "section_title": "5. السموات الجديدة والأرض الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "فلا تؤذي ولا تُهلك من عرف بنوته لله وعاش بإمكانيات الحياة التي صارت له]."
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "لا نعود نذكر الحياة الأولى ولا تخطر على بالنا، لأن فيض بركة الرب تمتص كل"
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "طاقاتنا [17]."
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "حياة فرح وابتهاج دائم أبدي [18-19]، لا يسمع فيها صوت بكاء أو صراخ."
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "ليس فيها إنسان يحمل عجز الطفولة أو الشيخوخة، بل يتمتع الكل بالنضوج الروحي [20]."
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "مملوءة بركات: يبنون بيوتًا روحيًا يسكنون فيها مع الله ويغرسون كرومًا ليشبعوا من"
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "ثمار الروح [21]."
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "لا يغتصب العدو (إبليس) موضعًا فيهم [23]."
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "مملوئين سلامًا، لا يحل بهم الرعب [13]."
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "يستجيب الرب صلواتهم قبلما ينطقون بها: \"ويكون أنيّ قبلما يدعون أنا أُجيب"
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "وفيما هم يتكلمون بعد أنا أسمع\" [24]."
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "تغيير الطبيعة بانتزاع روح العداوة والتمتع بروح الحب والوحدة حتى بين الذئب"
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "والحمل، الأسد والبقر، الحية والإنسان! يأتي البشر من أمم متباينة اتسمت بعضها"
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالشراسة، وصار الكل شعبًا واحدًا تحت قيادة روح الله القدوس."
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "In Rom. Hom 18."
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "Against the Heresy of One Noetus 12."
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "See Ep. Of Barnabas 12; St. Justin Apol. 1:35."
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "St. Sassian Conf, 3:22."
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "On Ps. 88."
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "للمؤلف: الروح القدس"
    },
    {
      "section_title": "سمات هذه الحياة الجديدة فهي",
      "content_type": "شرح",
      "father_name": null,
      "text": "بين الميلاد الجديد والتجديد المستمر، 1981م، ص 14-15."
    },
