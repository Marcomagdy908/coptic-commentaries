{
  "book_id": "isaiah",
  "book_title": "تفسير سفر إشعياء",
  "chapter_number": 15,
  "chapter_title": "الأصحاح 15",
  "topic": "وحي من جهة موآب",
  "chapter_outline": [
    {
      "number": 1,
      "title": "سرعة تحقيق النبوة",
      "verses": "1"
    },
    {
      "number": 2,
