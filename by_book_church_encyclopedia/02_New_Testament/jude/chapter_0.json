    },
    {
      "section_title": "أولًا: كاتبها",
      "content_type": "شرح",
      "father_name": null,
      "text": "يهوذا ابن حلفى أخو يعقوب ابن خالة المسيح فيلقب لذلك بأخى الرب، لأن ابن الخالة في المجتمع اليهودي يعتبر أخ."
    },
    {
      "section_title": "أولًا: كاتبها",
      "content_type": "شرح",
      "father_name": null,
      "text": "وهو أحد الإثنى عشر تلميذًا. وقد بشَّر في فلسطين وبلاد العرب والعراق وبلاد فارس."
    },
    {
      "section_title": "ثانيا: لمن كُتِبَت",
      "content_type": "شرح",
      "father_name": null,
      "text": "للمؤمنين في العالم كله سواء من أصل يهودي أو أممى."
    },
    {
      "section_title": "ثالثًا: زمن كتابتها",
      "content_type": "شرح",
      "father_name": null,
      "text": "قبل خراب أورشليم وفي زمن قريب من وقت كتابة رسالة بطرس الثانية لتشابههما في حديثهما عن المعلمين الكذبة، وهو تقريبًا عام 68 م."
    },
    {
      "section_title": "رابعًا: مكان كتابتها",
      "content_type": "شرح",
      "father_name": null,
      "text": "لم يحدد الآباء مكان كتابتها ولكن كتبت غالبًا في بلاد فارس التي أنهى فيها حياته."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "المعلمون الكذبة وصفاتهم وعقابهم."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "المعلمون الكذبة وصفاتهم وعقابهم."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "عقائد أساسية مثل الثالوث القدوس والمجئ الثاني، والملائكة والشياطين."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "عقائد أساسية مثل الثالوث القدوس والمجئ الثاني، والملائكة والشياطين."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "الكنيسة والإيمان المُسَلَّم من القديسين."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "الكنيسة والإيمان المُسَلَّم من القديسين."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "ملاحظة : تنفرد هذه الرسالة بذكر أمور لم تذكر في أي سفر آخر وهي:"
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "الخلاف بين رئيس الملائكة ميخائيل والشيطان حول إظهار جسد موسى النبي."
    },
    {
      "section_title": "خامسًا: أغراضها",
      "content_type": "شرح",
      "father_name": null,
      "text": "نبوة أخنوخ."
    },
    {
      "section_title": "سادسًا: أقسامها",
      "content_type": "شرح",
      "father_name": null,
      "text": "الانحراف عن الإيمان وأمثلة له (ع1-7)."
    },
