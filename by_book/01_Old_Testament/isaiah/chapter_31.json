      "verses": "6 -9"
    }
  ],
  "sections_count": 149,
  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الاتكال على"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الذراع البشري"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "لما كان الاتكال على الذراع"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "البشري أمرًا خطيرًا يُحطم الإيمان في حياة البشرية عبر الأجيال فلا نعجب. إن"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "عالجه إشعياء النبي مرارًا من زوايا مختلفة. هنا يوضح النبي خطورة النزول إلى مصر"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "لطلب حماية فرعون عوض ارتفاع القلب إلى الله القدوس كحصن حقيقي ومعين لشعبه."
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "1 وَيْلٌ لِلَّذِينَ يَنْزِلُونَ إِلَى مِصْرَ لِلْمَعُونَةِ، وَيَسْتَنِدُونَ عَلَى الْخَيْلِ وَيَتَوَكَّلُونَ عَلَى الْمَرْكَبَاتِ لأَنَّهَا كَثِيرَةٌ، وَعَلَى الْفُرْسَانِ لأَنَّهُمْ أَقْوِيَاءُ جِدًّا، وَلاَ يَنْظُرُونَ إِلَى قُدُّوسِ إِسْرَائِيلَ وَلاَ يَطْلُبُونَ الرَّبَّ. 2 وَهُوَ أَيْضًا حَكِيمٌ وَيَأْتِي بِالشَّرِّ وَلاَ يَرْجعُ بِكَلاَمِهِ، وَيَقُومُ عَلَى بَيْتِ فَاعِلِي الشَّرِّ وَعَلَى مَعُونَةِ فَاعِلِي الإِثْمِ. 3 وَأَمَّا الْمِصْرِيُّونَ فَهُمْ أُنَاسٌ لاَ آلِهَةٌ، وَخَيْلُهُمْ جَسَدٌ لاَ رُوحٌ. وَالرَّبُّ يَمُدُّ يَدَهُ فَيَعْثُرُ الْمُعِينُ، وَيَسْقُطُ الْمُعَانُ وَيَفْنَيَانِ كِلاَهُمَا مَعًا."
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "يقدم لنا إشعياء النبي فكرًا روحيًا"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "رائعًا، فإن موضوع الالتجاء إلى فرعون ليس مجرد خطة سياسية عسكرية لكنها موضوع"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "لاهوتي يمس حياة الإنسان ومصيره الأبدي. من يتكئ على البشر مهما كثر عددهم أو إمكانياتهم"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "أو قوتهم [1] إنما يلتصق بأناس جسدانيين مائتين فيصير مثلهم مائتًا، أما من يلتصق"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالمخلص قدوس إسرائيل غير المتغير الأبدي فيحمل معه الخلود. اتكالنا على البشر"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "يوحّدنا معهم فنهلك، واتكالنا على الله يربطنا به فنشاركه أمجاده الأبدية. هذا ما"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "عناه عندما حذرهم قائلًا: \"وأما المصريون فهم أناس لا آلهة، وخيلهم جسد لا"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "روح، والرب يمد يده فيَعثر المعُين ويَسقط المُعان ويفنيان كلاهما معًا\""
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "لنتكئ إذن على الخالق الأبدي لا الخليقة"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "الضعيفة العاجزة حتى على إعانة نفسها."
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "الآن خلال نوع من ضعف النفس البشرية"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "عندما يقع الإنسان في ضيقة ييأس من جهة الله، مختارًا أن يتكئ على إنسان."
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "ليقل لإنسان ساقط في ضيقة: \"يوجد"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "إنسان عظيم يُحررك\"، للحال يبتسم ويبتهج وترتفع معنوياته، أما إن قيل له"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"الله يُحررك\" فيسقط في حالة إحباط وييأس!"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "أنك تفرح عندما"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "تنال عونًا من مائت، فكيف تحزن عندما تنال العون من الخالق؟!"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "لقد نلت وعدًا بأن يُحررك من هو محتاج أن"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "يتحرر معك فترتفع معنوياتك كمن نال عونًا عظيمًا. ها أنت تنال وعدًا من (الله)"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "المحرر الذي لا يحتاج إلى من يُحرره ومع ذلك تيأس كأنك تنال أمرًا واهنًا."
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "ويل لمثل هذه الأفكار، لقد ضلوا، حقًا"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "صار فيهم موت خطير ومحزن!"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"تخرج"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "روحه فيعود إلى ترابه، في ذلك اليوم تهلك كل أفكاره\""
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "(مز 146: 4)..."
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"قد رأيت الشرير عاتيًا فوق شجر"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "لبنان، عبر فإذا هو ليس بموجود، والتمسته فلم يوجد\" (مز 37: 35-36)..."
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "كل هؤلاء قابلون للموت، سريعوا الزوال،"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "هالكون."
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "إذن، ماذا يجب علينا أن نفعل إن كنا لا"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "نترجى بني البشر ولا الرؤساء؟ ماذا يجب علينا أن نفعل؟ \"طوبى لمن كان معينه"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "إله يعقوب\" (مز 146: 5)، لا يكون معينه هذا الإنسان أو ذاك، ولا"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "هذا الملاك أو ذاك، إنما \"طوبى لمن كان معينه إله يعقوب\". فقد كان"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "ليعقوب معينًا عظيمًا هكذا أقام من يعقوب إسرائيل. يا له من عون قدير! الآن هو"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "إسرائيل \"يرى الله\"! أن بقيت أنت أيضًا هنا ولم تشرد عن رؤية الله، أن"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "صار لك إله يعقوب معينًا، فأنك تتحول من يعقوب إلى إسرائيل؛ ترى الله، وتنتهي"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "المتاعب وكل التنهدات وتبطل الارتباكات وتحل التسابيح السعيدة..."
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "ليكن رجاؤك في الرب إلهك، ليكن رجاؤك"
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "شرح",
      "father_name": null,
      "text": "فيه."
    },
    {
      "section_title": "1. الالتجاء إلى فرعون",
      "content_type": "قول آبائي",
      "father_name": "القديس أغسطينوس",
      "text": "القديس أغسطينوس"
    },
    {
      "section_title": "حامي أولاده",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "4 لأَنَّهُ هكَذَا قَالَ لِيَ الرَّبُّ: «كَمَا يَهِرُّ فَوْقَ فَرِيسَتِهِ الأَسَدُ وَالشِّبْلُ الَّذِي يُدْعَى عَلَيْهِ جَمَاعَةٌ مِنَ الرُّعَاةِ وَهُوَ لاَ يَرْتَاعُ مِنْ صَوْتِهِمْ وَلاَ يَتَذَلَّلُ لِجُمْهُورِهِمْ، هكَذَا يَنْزِلُ رَبُّ الْجُنُودِ لِلْمُحَارَبَةِ عَنْ جَبَلِ صِهْيَوْنَ وَعَنْ أَكَمَتِهَا. 5 كَطُيُورٍ مُرِفَّةٍ هكَذَا يُحَامِي رَبُّ الْجُنُودِ عَنْ أُورُشَلِيمَ. يُحَامِي فَيُنْقِذُ. يَعْفُو فَيُنَجِّي»."
    },
    {
      "section_title": "حامي أولاده",
      "content_type": "شرح",
      "father_name": null,
      "text": "إن كان عدو الخير إبليس يشبه أسدًا"
    },
    {
      "section_title": "حامي أولاده",
      "content_type": "شرح",
      "father_name": null,
      "text": "مزمجرًا يُريد أن يفترس ليأكل ويشبع ويهلك فريسته (1 بط 5: 8)، فإن \"قدوس إسرائيل\""
    },
    {
      "section_title": "حامي أولاده",
      "content_type": "شرح",
      "father_name": null,
      "text": "هو الأسد الخارج من"
    },
    {
      "section_title": "حامي أولاده",
      "content_type": "شرح",
      "father_name": null,
      "text": "سبط يهوذا (رؤ 5: 5) لا يهلك الفريسة وإنما قادر أن يحميها."
    },
    {
      "section_title": "حامي أولاده",
      "content_type": "شرح",
      "father_name": null,
      "text": "يقتني النفس كفريسة يحوط بها ليهبها سماته الملوكية فيُقيم مؤمنيه \"كهنة"
    },
    {
      "section_title": "حامي أولاده",
      "content_type": "شرح",
      "father_name": null,
      "text": "وملوكًا\" (رؤ 1: 6)، يهبهم خلوده وشركة أمجاده."
    },
    {
      "section_title": "حامي أولاده",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله موضع ثقة قادر أن يحمينا وأيضًا أن"
    },
    {
      "section_title": "حامي أولاده",
      "content_type": "شرح",
      "father_name": null,
      "text": "يرعانا، لذا يُشبه نفسه بالأسد ملك الوحوش لا يقدر أحد أن يقف أمامه، وفي نفس"
    },
    {
      "section_title": "حامي أولاده",
      "content_type": "شرح",
      "father_name": null,
      "text": "الوقت كطائر يهتم بصغاره [5]."
    },
    {
      "section_title": "حامي أولاده",
      "content_type": "شرح",
      "father_name": null,
      "text": "مسيحنا يرعانا على الصليب كأسد ربض ونام"
    },
    {
      "section_title": "حامي أولاده",
      "content_type": "شرح",
      "father_name": null,
      "text": "(تك 49: 9) ولم يقدر العدو أن يقترب إليه، ولا أن يقترب إلينا."
    },
    {
      "section_title": "الله",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "6 اِرْجِعُوا إِلَى الَّذِي ارْتَدَّ بَنُو إِسْرَائِيلَ عَنْهُ مُتَعَمِّقِينَ. 7 لأَنْ فِي ذلِكَ الْيَوْمِ يَرْفُضُونَ كُلُّ وَاحِدٍ أَوْثَانَ فِضَّتِهِ وَأَوْثَانَ ذَهَبِهِ الَّتِي صَنَعَتْهَا لَكُمْ أَيْدِيكُمْ خَطِيئَةً. 8 وَيَسْقُطُ أَشُّورُ بِسَيْفِ غَيْرِ رَجُل، وَسَيْفُ غَيْرِ إِنْسَانٍ يَأْكُلُهُ، فَيَهْرُبُ مِنْ أَمَامِ السَّيْفِ، وَيَكُونُ مُخْتَارُوهُ تَحْتَ الْجِزْيَةِ. 9 وَصَخْرُهُ مِنَ الْخَوْفِ يَزُولُ، وَمِنَ الرَّايَةِ يَرْتَعِبُ رُؤَسَاؤُهُ، يَقُولُ الرَّبُّ الَّذِي لَهُ نَارٌ فِي صِهْيَوْنَ، وَلَهُ تَنُّورٌ فِي أُورُشَلِيمَ."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "يكشف النبي عن غاية عمل الله معهم، فإن الرب"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "يُحطم آشور بطريقة غير بشرية ولا طبيعية لا لاستعراض قوته الإلهية وإنما لاجتذاب"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "نفوس جاحديه، إذ يقول الرب: \"ارجعوا إلى الذي ارتد بنو إسرائيل عنه"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "متعمقين... ويسقط آشور بسيف غير رجل وسيف غير إنسان يأكله...\" [6، 8]."
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "أليست هذه صورة خلاص الله الذي تم على"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "الصليب حيث أسقط إبليس لا بفكر بشري ولا بسيف مادي وإنما ببذل حياته ذبيحة إثم"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "عنا، ومحرقة حب لحسابنا وباسمنا، فتحطم العدو تحت أقدامنا ورجعنا إلى الله بأعماق"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "جديدة لم يختبرها رجال العهد القديم مثلنا؟!"
    },
    {
      "section_title": "الله",
      "content_type": "شرح",
      "father_name": null,
      "text": "سفر التكوين، 1988م،"
    },
    {
