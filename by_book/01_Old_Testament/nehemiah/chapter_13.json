      "content_type": "شرح",
      "father_name": null,
      "text": "وَأَقَمْتُ حِرَاسَاتِ الْكَهَنَةِ وَاللاَّوِيِّينَ كُلَّ وَاحِدٍ عَلَى عَمَلِهِ. [30]"
    },
    {
      "section_title": "وَاسْتَحْلَفْتُهُمْ بِاللَّهِ قَائِلًا",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَلأَجْلِ قُرْبَانِ الْحَطَبِ فِي أَزْمِنَةٍ مُعَيَّنَةٍ وَلِلْبَاكُورَاتِ."
    },
    {
      "section_title": "وَاسْتَحْلَفْتُهُمْ بِاللَّهِ قَائِلًا",
      "content_type": "شرح",
      "father_name": null,
      "text": "فَاذْكُرْنِي يَا إِلَهِي بِالْخَيْرِ. [31]"
