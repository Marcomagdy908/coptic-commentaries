  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "شريعة ميراث النساء"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "صار لبنات"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "صلفحاد من"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "سبط مَنَسَّى حق ميراث نصيب أبيهن (أصحاح 27)، تقدم رؤساء"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الآباء من عشيرة بني جلعاد بن ماكير بن مَنَسَّى إلى موسى النبي يشتكون بأن بنات"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "صلفحاد إن تزوجن من سبط آخر ينتقل جزء من ميراث"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "سبط مَنَسَّى إلى السبط الآخر،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "بهذا يمكن أن يقتني سبط على حساب آخر. فأجاب موسى حسب أمر الرب مؤكدًا مبدأين:"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "من حق البنات أن يتزوجن بمن يخترن، فإن الزواج لا يكون إلزامًا."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "هذا الاختيار يكون أيضًا محدودًا فيتزوجن بمن يخترن من رجال السبط عينه حتى يبقى"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الميراث محفوظًا لذات السبط."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أخيرًا،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "خُتم السفر بهذه العبارة: \"هذه هي الوصايا والأحكام التي أوصى بها الرب"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "إلى بني إسرائيل على يد موسى في عربات موآب على أردن أريحا\"."
    },
    {
