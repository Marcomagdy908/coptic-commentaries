  ],
  "sections_count": 188,
  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "خضوع موآب ليهوذا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "في أيام حزقيا يُقدم إشعياء"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "النبي مشورة لموآب أن تفي بالجزية التي تعهدت بها أمام يهوذا فترسل إليه حملان، وهي"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "جزية مناسبة لأن موآب مشهورة بقطعانها (عد 32: 4). قدمت موآب فيما بعد جزية أيضًا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "لإسرائيل (2 مل 3: 4). بهذه المشورة تتمتع موآب بالحماية عوض أن تصير كطائر تائه"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "لا يجد عشًا. وإذ خشى النبي ألا تقبل موآب مشورته كشف لها جراحاتها المهلكة ألا وهي"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الكبرياء."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "هذه دعوة مقدمة لكل نفس كي تخضع للسيد"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "المسيح الملك الخارج من"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "سبط يهوذا، لكي تقدم حياتها كحمل ذبيح من أجل الرب، فتنعم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "بالسلام الداخلي عوض أن يُحطمها جحود الإيمان والكبرياء."
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "1 أَرْسِلُوا خِرْفَانَ حَاكِمِ الأَرْضِ مِنْ سَالِعَ نَحْوَ الْبَرِّيَّةِ إِلَى جَبَلِ ابْنَةِ صِهْيَوْنَ. 2 وَيَحْدُثُ أَنَّهُ كَطَائِرٍ تَائِهٍ، كَفِرَاخٍ مُنَفَّرَةٍ تَكُونُ بَنَاتُ مُوآبَ فِي مَعَابِرِ أَرْنُونَ. 3 هَاتِي مَشُورَةً، اصْنَعِي إِنْصَافًا، اجْعَلِي ظِلَّكِ كَاللَّيْلِ فِي وَسَطِ الظَّهِيرَةِ، اسْتُرِي الْمَطْرُودِينَ، لاَ تُظْهِرِي الْهَارِبِينَ. 4 لِيَتَغَرَّبْ عِنْدَكِ مَطْرُودُو مُوآبَ. كُونِي سِتْرًا لَهُمْ مِنْ وَجْهِ الْمُخَرِّبِ، لأَنَّ الظَّالِمَ يَبِيدُ، وَيَنْتَهِي الْخَرَابُ، وَيَفْنَى عَنِ الأَرْضِ الدَّائِسُونَ. 5 فَيُثَبَّتُ الْكُرْسِيُّ بِالرَّحْمَةِ، وَيَجْلِسُ عَلَيْهِ بِالأَمَانَةِ فِي خَيْمَةِ دَاوُدَ قَاضٍ، وَيَطْلُبُ الْحَقَّ وَيُبَادِرُ بِالْعَدْلِ."
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "سبق أن رأينا قلب إشعياء النبي يتحرك"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "بحنان شديد نحو موآب فصار يصرخ من أجلهم. الآن يُقدم للموآبيين مشورة صالحة لإصلاح"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "حالهم وتمتعهم بعلاقات طيبة مع بني يهوذا وتذوقهم للسلام والحماية، بتقديم الجزية"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "(حملان) لحزقيا الملك؛ كرمز لدعوة الأمم إلى الخضوع للسيد المسيح، الأسد الخارج من"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "سبط يهوذا، فإنه لا سلام ولا حياة أبدية دون قبوله ملكًا في حياتنا الداخلية."
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "في نهاية"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأصحاح السابق قيل: \"على"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الناجين من موآب أسدًا وعلى بقية الأرض\" (إش 15: 9)، ويرى البعض أن الأسد"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "ربما يكون حزقيا، أو السيد المسيح الأسد الخارج من"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "سبط يهوذا ليملك على الأمم روحيًا."
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "يتقدم النبي نفسه ليعلن استعداده أن يكون"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "وسيطًا أو شفيعًا لدى يهوذا عن موآب، مطالبًا الموآبيين بدفع الجزية: \"أرسلوا"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "خرفان حاكم الأرض من سالع نحو البرية إلى جبل ابنة صهيون، ويحدث أنه كطائر تائه"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "كفراخ منفّرة تكون بنات موآب في معابر أرنون\" [1-2]."
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"سالع\""
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "Sala اسم عبري סֶלַע معناه \"صخرة\"،"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "دعاة اليونانيون بترا πέτρα والتي"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "تحمل ذات المعنى، إذ هو موقع حصين في أرض أدوم؛ كان الأدوميون يهربون إليه أثناء"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الحصار العسكري كقلعة طبيعية حصينة لا تُقهر، لأنها قائمة على قمة جبل (عو 2)، تُسمى"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "حاليًا أم البيَّارة."
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "كأن النبي يدعو الموآبيين الذين التجاؤا"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "إلى أدوم وتحصنوا في سالع أن يتقدموا مع بقية الموآبيين الذين في البرية ليهوذا،"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "وأن يقدموا الحملان في أورشليم \"جبل ابنة صهيون\"."
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "إنها دعوة لكل إنسان ألا يظن في الذراع"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "البشري أو الإمكانيات الطبيعية ملجأ له. إنما يكمن سلامه في بلوغه أورشليم، وتقديم"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "حياته ذبيحة حب لابن داود، الأسد الخارج من"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "سبط يهوذا. جاء الأسد كحمل ليصلب خارج أورشليم"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "حتى نتقدم نحن كحملان -ذبائح حيَّة- نُشاركه آلامه، فندخل إلى أورشليمه السماوية."
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "ربما يُقال: كيف يصير الجسد ذبيحة؟ دع"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "العين لا تنظر الشر، فتصير ذبيحة! لا ينطق لسانك بدنس فيصير ذبيحة! لا تمارس يدك"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "عملًا محرمًا فتصير محرقة كاملة...! بهذا لا نحتاج إلى سكين أو مذبح أو نار،"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالحري نحتاج إلى هذه كلها لكنها ليست مصنوعة بالأيدي، إنما تأتينا من فوق. نحتاج"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "إلى نار علوية، وسكين كهذه؛ مذبحنا هو اتساع السماء."
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "إن كان إيليا إذ قدم ذبيحة منظورة نزلت"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "نار من فوق التهمت كل الماء والخشب والحجارة، فكم بالأكثر يحدث هذا بالنسبة لك؟!"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "قول آبائي",
      "father_name": "القديس يوحنا ذهبي الفم",
      "text": "القديس يوحنا الذهبي الفم"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "أحضر"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "تقدماتك ... تقدمات نفسك!"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "قول آبائي",
      "father_name": "القديس جيروم",
      "text": "القديس جيروم"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "خارج السيد المسيح يرى النبي بنات موآب"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "تعبرن نهر أرنون كطائر تائه ليس له عش يستقر فيه، أو كفراخ منفرة تفتقر إلى ظل"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الجناحين والدفء والحماية [2]، أما بقبوله فنصير تحت جناحي صليبه، نجد راحتنا وسلامنا وشبعنا الداخلي."
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "يُقدم النبي أيضًا مشورة لشيوخ يهوذا،"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "مطالبًا إياهم أن يستقبلوا الموآبيين اللاجئين إليهم ليقدموا لهم ظلًا وسط"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "الظهيرة، فيصير لهم الوقت كأنه ليل للراحة من شمس التجارب والضيقات؛ وأن يستروا"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "المطرودين والهاربين إليهم بدون خداع، فلا يسلموا عبيدًا للأعداء [3-4]."
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "يليق برجال يهوذا أن يحملوا رمزًا للسيد"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "المسيح الملجأ الحقيقي، فيفتحوا قلوبهم ومدنهم للهاربين، ويستقبلوهم بإخلاص؛ بهذا"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "تعلن مملكة المسيح القائمة على كرسي الرحمة أبديًا: \"فيثبت الكرسي بالرحمة،"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "ويجلس عليه بالأمانة في خيمة داود قاضٍ ويطلب الحق ويبادر بالعدل\""
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "هكذا يُقدم لنا النبي نصًا مسيانيًا،"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "معلنًا أن الكنيسة -خيمة داود- هي موضع النجاة، يملك فيها المسّيا ليجتذب الأمم"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "إليه فيجدوا فيه الحق ويتمتعوا بالمراحم الإلهية، مترنمين: \"العدل والحق"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "قاعدة كرسيك؛ الرحمة والأمانة تتقدمان وجهك..."
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "لأن الرب مجننا وقدوس إسرائيل"
    },
    {
      "section_title": "1. مشورة للخضوع ليهوذا",
      "content_type": "شرح",
      "father_name": null,
      "text": "ملكنا\" (مز 89: 14، 18)."
    },
    {
      "section_title": "للإنسان",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "6 قَدْ سَمِعْنَا بِكِبْرِيَاءِ مُوآبَ الْمُتَكَبِّرَةِ جِدًّا عَظَمَتِهَا وَكِبْرِيَائِهَا وَصَلَفِهَا بُطْلِ افْتِخَارِهَا."
    },
    {
      "section_title": "للإنسان",
      "content_type": "شرح",
      "father_name": null,
      "text": "قدم إشعياء النبي المشورة الصالحة لموآب،"
    },
    {
      "section_title": "للإنسان",
      "content_type": "شرح",
      "father_name": null,
      "text": "كما قدم دانيال النبي مشورته أيضًا لنبوخذ نصَّر (دا 4: 27)... وقد كشف في نفس"
    },
    {
      "section_title": "للإنسان",
      "content_type": "شرح",
      "father_name": null,
      "text": "الوقت عن ضعفهم الروحي أي الكبرياء كعائق لهم عن قبول المشورة. \"قد سمعنا"
    },
    {
      "section_title": "للإنسان",
      "content_type": "شرح",
      "father_name": null,
      "text": "بكبرياء موآب المتكبرة جدًا عظمتها وكبريائها وصلفها بُطل افتخارها\" [6]."
    },
    {
      "section_title": "للإنسان",
      "content_type": "شرح",
      "father_name": null,
      "text": "لقد سمع النبي عن كبرياء الموآبيين وتشامخهم الزائد وكلماتهم الفارغة (الباطلة)!"
    },
    {
      "section_title": "للإنسان",
      "content_type": "شرح",
      "father_name": null,
      "text": "الكبرياء محطم للإنسان كما للأمم، يحرم"
    },
    {
      "section_title": "للإنسان",
      "content_type": "شرح",
      "father_name": null,
      "text": "صاحبه من قبول المشورة الصالحة، ويفقده التمتع بنعمة الله ورحمته."
    },
    {
      "section_title": "3. ولولة على موآب",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "7 لِذلِكَ تُوَلْوِلُ مُوآبُ. عَلَى مُوآبَ كُلُّهَا يُوَلْوِلُ. تَئِنُّونَ عَلَى أُسُسِ قِيرَ حَارِسَةَ، إِنَّمَا هِيَ مَضْرُوبَةٌ. 8 لأَنَّ حُقُولَ حَشْبُونَ ذَبُلَتْ. كَرْمَةُ سِبْمَةَ كَسَّرَ أُمَرَاءُ الأُمَمِ أَفْضَلَهَا. وَصَلَتْ إِلَى يَعْزِيرَ. تَاهَتْ فِي الْبَرِّيَّةِ، امْتَدَّتْ أَغْصَانُهَا، عَبَرَتِ الْبَحْرَ. 9 لِذلِكَ أَبْكِي بُكَاءَ يَعْزِيرَ عَلَى كَرْمَةِ سِبْمَةَ. أُرْوِيكُمَا بِدُمُوعِي يَا حَشْبُونُ وَأَلْعَالَةُ، لأَنَّهُ عَلَى قِطَافِكِ وَعَلَى حَصَادِكِ قَدْ وَقَعَتْ جَلَبَةٌ. 10 وَانْتُزِعَ الْفَرَحُ وَالابْتِهَاجُ مِنَ الْبُسْتَانِ، وَلاَ يُغَنَّى فِي الْكُرُومِ وَلاَ يُتَرَنَّمُ، وَلاَ يَدُوسُ دَائِسٌ خَمْرًا فِي الْمَعَاصِرِ. أَبْطَلْتُ الْهُتَافَ. 11 لِذلِكَ تَرِنُّ أَحْشَائِي كَعُودٍ مِنْ أَجْلِ مُوآبَ وَبَطْنِي مِنْ أَجْلِ قِيرَ حَارِسَ. 12 وَيَكُونُ إِذَا ظَهَرَتْ، إِذَا تَعِبَتْ مُوآبُ عَلَى الْمُرْتَفَعَةِ وَدَخَلَتْ إِلَى مَقْدِسِهَا تُصَلِّي، أَنَّهَا لاَ تَفُوزُ. 13 هذَا هُوَ الْكَلاَمُ الَّذِي كَلَّمَ بِهِ الرَّبُّ مُوآبَ مُنْذُ زَمَانٍ. 14 وَالآنَ تَكَلَّمَ الرَّبُّ قَائِلًا: «فِي ثَلاَثِ سِنِينَ كَسِنِي الأَجِيرِ يُهَانُ مَجْدُ مُوآبَ بِكُلِّ الْجُمْهُورِ الْعَظِيمِ، وَتَكُونُ الْبَقِيَّةُ قَلِيلَةً صَغِيرَةً لاَ كَبِيرَةً»."
    },
    {
      "section_title": "3. ولولة على موآب",
      "content_type": "شرح",
      "father_name": null,
      "text": "لم يسمع قادة موآب لصوت إشعياء النبي"
    },
    {
      "section_title": "3. ولولة على موآب",
      "content_type": "شرح",
      "father_name": null,
      "text": "بسبب كبريائهم واعتدادهم برأيهم لهذا سقطوا تحت العقوبات المُرّة واستحقوا الويلات"
    },
    {
      "section_title": "التي يُلاحظ فيها الآتي",
      "content_type": "شرح",
      "father_name": null,
      "text": "أ. حدوث ولولة شاملة: \"لذلك"
    },
    {
      "section_title": "التي يُلاحظ فيها الآتي",
      "content_type": "شرح",
      "father_name": null,
      "text": "تولول موآب على موآب كلها يولول\" [7]؛ إذ صارت الولولة سمة عامة"
    },
    {
      "section_title": "التي يُلاحظ فيها الآتي",
      "content_type": "شرح",
      "father_name": null,
      "text": "في كل موآب."
    },
    {
      "section_title": "ب. شملت الولولة أكبر المدن مثل قير",
      "content_type": "شرح",
      "father_name": null,
      "text": "حارسة [7] التي ضُربت، وأيضًا الحقول التي ذبلت كحقول"
    },
    {
      "section_title": "ب. شملت الولولة أكبر المدن مثل قير",
      "content_type": "شرح",
      "father_name": null,
      "text": "حشبون وكرمة سبمة"
    },
    {
      "section_title": "ب. شملت الولولة أكبر المدن مثل قير",
      "content_type": "شرح",
      "father_name": null,
      "text": "Sibmah ويعزير [8-9]؛"
    },
    {
      "section_title": "ب. شملت الولولة أكبر المدن مثل قير",
      "content_type": "شرح",
      "father_name": null,
      "text": "شملت المدن والقرى؛ المتعلمين والجهال، الأغنياء والفقراء إلخ..."
    },
    {
      "section_title": "ب. شملت الولولة أكبر المدن مثل قير",
      "content_type": "شرح",
      "father_name": null,
      "text": "اشتهرت"
    },
    {
      "section_title": "ب. شملت الولولة أكبر المدن مثل قير",
      "content_type": "شرح",
      "father_name": null,
      "text": "حشبون وسبمه ويعزير بغنى كرومها."
    },
    {
      "section_title": "ج. تحولت أفراح",
      "content_type": "شرح",
      "father_name": null,
      "text": "الحصاد إلى بكاء ونوح؛"
    },
    {
      "section_title": "ج. تحولت أفراح",
      "content_type": "شرح",
      "father_name": null,
      "text": "عوض صيحات العيد المبهجة سُمعت صرخات المعركة المُرّة [10]."
    },
    {
      "section_title": "د. انطلق الموآبيون إلى المرتفعة للصلاة",
      "content_type": "شرح",
      "father_name": null,
      "text": "في هيكل"
    },
    {
      "section_title": "د. انطلق الموآبيون إلى المرتفعة للصلاة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الإله كموش بلا جدوى [12]."
    },
    {
      "section_title": "ه. تحدد ميعاد العقوبة بثلاث سنوات",
      "content_type": "شرح",
      "father_name": null,
      "text": "خلالها تنهار موآب أمام سنحاريب ملك آشور، ويذل الموآبيين ويتحطم مجدهم [14]."
    },
    {
      "section_title": "ه. تحدد ميعاد العقوبة بثلاث سنوات",
      "content_type": "شرح",
      "father_name": null,
      "text": "هذه هي نهاية الإنسان المتكبر، يصير"
    },
    {
      "section_title": "ه. تحدد ميعاد العقوبة بثلاث سنوات",
      "content_type": "شرح",
      "father_name": null,
      "text": "كموآب تحل الولولة بحياته ككل، في الأمور الكبيرة وأيضًا الصغيرة، لا يعرف الفرح"
    },
    {
      "section_title": "ه. تحدد ميعاد العقوبة بثلاث سنوات",
      "content_type": "شرح",
      "father_name": null,
      "text": "الداخلي ولا بهجة القلب، أعياده تتحول إلى أحزان، عبادته تكون بلا نفع، ينهار يومًا"
    },
    {
      "section_title": "ه. تحدد ميعاد العقوبة بثلاث سنوات",
      "content_type": "شرح",
      "father_name": null,
      "text": "فيومًا ليفقد مجده تمامًا."
    },
    {
      "section_title": "ه. تحدد ميعاد العقوبة بثلاث سنوات",
      "content_type": "شرح",
      "father_name": null,
      "text": "وسط هذه الصورة القاتمة يكشف إشعياء النبي"
    },
    {
      "section_title": "ه. تحدد ميعاد العقوبة بثلاث سنوات",
      "content_type": "شرح",
      "father_name": null,
      "text": "عن جانبين مبهجين: الأول مشاركة النبي بني موآب متاعبهم، إذ يقول: \"لذلك"
    },
    {
      "section_title": "ه. تحدد ميعاد العقوبة بثلاث سنوات",
      "content_type": "شرح",
      "father_name": null,
      "text": "ترن أحشائي كعود من أجل موآب وبطني من أجل قير حارس\" [11]. لا"
    },
    {
      "section_title": "ه. تحدد ميعاد العقوبة بثلاث سنوات",
      "content_type": "شرح",
      "father_name": null,
      "text": "تحتمل أحشاؤه الداخلية أن تنظر نفوسًا متألمة حتى وإن كانت آلامها ثمرة خطاياها."
    },
    {
      "section_title": "ه. تحدد ميعاد العقوبة بثلاث سنوات",
      "content_type": "شرح",
      "father_name": null,
      "text": "الجانب الثاني وجود بقية قليلة جدًا"
    },
    {
      "section_title": "ه. تحدد ميعاد العقوبة بثلاث سنوات",
      "content_type": "شرح",
      "father_name": null,
      "text": "وضعيفة للغاية [14]، ففي القديم تمتعت راعوث الموآبية بالخلاص، إذ جاءت تحتمي تحت"
    },
    {
      "section_title": "ه. تحدد ميعاد العقوبة بثلاث سنوات",
      "content_type": "شرح",
      "father_name": null,
      "text": "ظل الله، وفي العهد الجديد جاء الأمم إلى الإيمان ليتمتعوا بالحياة الجديدة في"
    },
    {
      "section_title": "ه. تحدد ميعاد العقوبة بثلاث سنوات",
      "content_type": "شرح",
      "father_name": null,
      "text": "المسيح يسوع."
    },
    {
      "section_title": "ه. تحدد ميعاد العقوبة بثلاث سنوات",
      "content_type": "شرح",
      "father_name": null,
      "text": "Cf. Bultema, p. 177."
    },
    {
      "section_title": "ه. تحدد ميعاد العقوبة بثلاث سنوات",
      "content_type": "شرح",
      "father_name": null,
      "text": "In Rom, hom 20."
    },
    {
      "section_title": "ه. تحدد ميعاد العقوبة بثلاث سنوات",
      "content_type": "شرح",
      "father_name": null,
      "text": "On Ps, hom, 23."
