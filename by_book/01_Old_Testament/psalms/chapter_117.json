{
  "book_id": "psalms",
  "book_title": "تفسير سفرالمزامير",
  "chapter_number": 117,
  "chapter_title": "المزمور 117",
  "topic": "الأصحاح 117",
  "chapter_outline": [
    {
      "number": 1,
      "title": "\"حقه يدوم إلى الأبد\"",
      "verses": ""
    },
    {
      "number": 2,
      "title": "مزامير",
      "verses": ""
    },
    {
      "number": 3,
      "title": "الكتاب المقدس",
      "verses": ""
    },
    {
      "number": 4,
      "title": "تقصير الرابط",
      "verses": ""
    }
  ],
  "sections_count": 276,
  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ظن البعض أن هذا المزمور هو مجرد"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مجدلة ختامية لأي مزمور آخر، غير أن النص العبري يؤكد بطلان هذا الرأي، بل هو"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مزمور كامل مستقل. في الحقيقة هو قصيدة قصيرة، لكنها تقدم مشاعر حيَّة ملتهبة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "هو مزمور مسياني، ونبوة خاصة بقبول كل الأمم الإيمان، وقيام كنيسة العهد"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الجديد."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "تسبح به الكنيسة في بدء مزامير الغروب، إشارة إلى قيام الكنيسة في ملء الزمان،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "وانفتاح باب الإيمان أمام الأمم بكونهم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أصحاب الساعة الحادية عشرة."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مع صغر حجم المزمور إلا أنه غاية في العذوبة يعطي رجاءً في قبول العالم للسيد"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "المسيح، وبث روح التسبيح والحمد لله في كل موضع."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "قام السيد المسيح بشرح هذا المزمور عمليًا قبل صعوده مباشرة، إذ قال لتلاميذه:"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "\"دُفع إليّ كل سلطان في السماء وعلى الأرض. فاذهبوا وتلمذوا جميع الأمم،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "وعمدوهم باسم الآب والابن والروح القدس، وعلموهم أن يحفظوا جميع ما أوصيتكم له. وها أنا معكم كل الأيام إلى انقضاء الدهر\" (مت 28: 18-20؛ راجع مر 16: 15-16)."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أخيرًا فقد جاء هذا المزمور المختصر للغاية كما أيضًا (المزمور 119) الذي يُدعى"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "بالمزمور الكبير، وكأن العبادة لا تُقاس بالزمن وطول العبادة أو قُصرها، إنما"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "بعمق العبادة وحرارتها الروحية."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "يشتهي الله أن يكون شعبه كله بركة لكل الأمم، فيكون الكل بالحق أبناء إبراهيم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الذي نال وعدًا إلهيًا: \"وتكون بركة\" (تك 12: 2)، وتتحقق وصية السيد المسيح"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "لتلاميذه أن يصيروا بركة للعالم كله (مت 28: 18-20). لقد قدم السيد المسيح"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الخلاص لحساب العالم على الصليب، وأرسل لنا روحه القدوس لنكون بركة لمن نعرفهم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ومن لا نعرفهم."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "إنه مزمور مفرح يهب النفس طمأنينة أن معرفة الله تنتشر في كل المسكونة، كما"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "تملأ المياه المحيطات."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "سَبِّحُوا الرَّبَّ يَا كُلَّ"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الأُمَمِ."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "احَمِّدُوهُ يَا كُلَّ"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الشُّعُوبِ [1]"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "هذه نبوة تعلن عن حب الله لكل البشرية واشتياقه أن يتمتع الكل بخلاصه، وأن"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "يتحول الجميع مع الطغمات السمائية إلى خورس للتسبيح."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "كثيرًا ما عانى شعب إسرائيل من العجز في تقديم تسابيح لائقة بقدسية الهيكل. أما"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الآن فإذ تشترك كل الأمم في التسبيح لله، تُقدم بأيادٍ طاهرة وقلوب نقية."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "لقد وعد السيد المسيح نفسه: \"لي خراف أُخَر ليست من هذه الحظيرة، ينبغي أن آتي"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "بتلك أيضًا، فتسمع صوتي، وتكون رعية واحدة وراع واحد\" (يو 10: 16-17). تحقق ذلك"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "عندما بدأت الكرازة بين الأمم بدخول كرنيليوس الإيمان، إذ قيل: \"كانوا يمجدون"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الله، قائلين إذًا أعطى الله الأمم أيضًا التوبة للحياة\" (أع 11: 18)."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "*يدعو"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "المزمور ليس أمة واحدة ولا اثنتين ولا ثلاثة بل كل الأرض والبحر. هذا ما حدث"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "فعلًا عندما أشرق مجيء المسيح. وبعد ذلك يشير إلى سبب خلاصهم، أنه ليس لأجل"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أعمالهم الصالحة قد خلصوا، ولا لأجل حياتهم ولا أجل ثقتهم، إنما من أجل حنوه"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "وحده. \"رحمته علينا قد ثبتت\"... إنها قوية وأكثر صلابة من الصخر."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "إنها تنمو يومًا فيومًا (إذ يقبلها كثيرون)"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "القديس يوحنا"
    },
    {
      "section_title": null,
      "content_type": "قول آبائي",
      "father_name": "القديس يوحنا ذهبي الفم",
      "text": "الذهبي الفم"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "*من زمن"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "طويل قضى الله في [المزمور 116] (LXX)"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أن بتدخل رحمته يتحد اليهود مع الأمم. تُوهب نعمة للأمم، ليصيروا زملاء اليهود"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "في الميراث، الذين بنعمة الله دُعوا منذ زمن بعيد شعبه. بينما كان اليهود نبلاء"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "كان الأمم وضيعين، لكن الآن برحمة الله صار الأمم نبلاء أيضًا لكي يفرح الكل"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "معًا بمعرفة الحق"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الأب أمبروسياتر"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "لأَنَّ رَحْمَتَهُ قَدْ قَوِيَتْ"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "عَلَيْنَا،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "وَأَمَانَةُ الرَّبِّ إِلَى"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الدَّهْرِ."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "هَلِّلُويَا [2]."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "جاء في الترجمة السبعينية"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "والقبطية: \"لأن رحمته قد قويت علينا، وحق الرب"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "يدوم إلى الدهر. هللويا\"."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ظهرت رحمة الله بكل قوة في ثلاث حقائق إنجيلية هامة: قيامة السيد المسيح التي"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "قدمت لنا الحياة الجديدة المُقامة، وصعود المسيح الذي فتح لنا أبواب السماء،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "وقبول الأمم للإيمان، حيث تحققت وعود الله بتجديد قلوب الأمم وأفكارهم للتمتع"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "بوعود الله الصادقة. قبولهم للإنجيل أذهل العالم، وشهادة لأمانة الرب إلى"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الدهر. قدم إنجيل المسيح للمؤمنين عزاءً أبديًا ورجاءً صالحًا بالنعمة (2 تس 2: 16). قدم محبة الآب العملية، واهبًا الحياة الأبدية خلال ذبيحة الابن الوحيد"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الجنس."
    },
    {
      "section_title": null,
      "content_type": "قول آبائي",
      "father_name": "القديس أغسطينوس",
      "text": "القديس أغسطينوس"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أن المرتل يشير إلى أمرين: رحمة الرب وحق الرب أو"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "عدله، وذلك كما ورد في (المزمور 116: 5). خضع الأمم لاسم الرب خلال وعده بالرحمة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "للأتقياء، كما خلال تهديده الأشرار (بعدله)."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "*يخبر"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "هذا المزمور بأكثر إيضاح عن كرازة الرسل القديسين بالإنجيل في كل الأرض،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "وانضمام جميع الأمم ودخولهم إلى الإيمان بالمسيح، كما جاء في نبوة زكريا:"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "\"ترنمي وافرحي يا بنت صهيون، لأني هأنذا آتي وأسكن في وسطك، يقول الرب. فيتصل"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أمم كثيرة بالرب في ذلك اليوم، ويكونون لي شعبًا، فأسكن في وسطك، فتعلمين أن رب"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الجنود قد أرسلني إليك\" (زك 2: 10-11). يقول زكريا النبي جهارًا إن الآب رب"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الجنود الذي أرسل الرب... الذي جعل الأمم شعبه. جاء ابنه الوحيد وسكن في كنيسته"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "المقدسة. وقد قويت رحمته غالبة خطايا الأمم، وحق كلامه الذي أوصاه لأنبيائه"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "سابقًا قد أنجزه. وهو يدوم إلى الدهر مع دوام الإيمان بالمسيح."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الأب أنسيمُس الأورشليمي"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "هذه على وجه الخصوص سمة حقه الذي يشرق. قال هذا أيضًا، لأن أحداث العهد القديم"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "كانت رمزًا وظلًا. هذا ما أشار إليه الإنجيلي بقوله: \"لأن الناموس بموسى أُعطى."
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "أما النعمة والحق فبيسوع المسيح صارا\" (يو 1: 17)"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "القديس يوحنا"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "قول آبائي",
      "father_name": "القديس يوحنا ذهبي الفم",
      "text": "الذهبي الفم"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "من وحي المزمور 117"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "لنصر جميعًا كنيسة واحدة"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "مقدسة!"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "*تسبحك"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "يا رب نفسي،"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "من أجل كثرة إحساناتك لي."
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "بل وأدعو كل الأمم معي،"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "لنقدم تسبحة الشكر على غنى حبك"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "لنا."
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "لن يستريح قلبي حتى أرى الكل قد"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "اجتمعوا مع السمائيين."
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "لنصر جميعًا كنيسة واحدة مقدسة!"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "نلهج دومًا بحبك ورعايتك."
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "*رحمتك"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "يا رب هي سرّ قوتنا."
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "حررتنا من عبودية إبليس،"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "وأقمتنا أبناء لله الآب أبيك."
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "حطمت متاريس الهاوية،"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "وأعطيتنا جناحي الروح،"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "فنطير وننطلق إليك."
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "فتحت لنا أبواب السماء،"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "وقدمت لنا برَّك برًّا لنا."
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "حقك يسندنا إلى الأبد."
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "لك المجد يا محب البشر!"
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "W. S. Plumer, Ps 117."
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "On Ps. 117."
    },
    {
      "section_title": "\"حقه يدوم إلى الأبد\"",
      "content_type": "شرح",
      "father_name": null,
      "text": "Commentary on Paul’s"
    },
