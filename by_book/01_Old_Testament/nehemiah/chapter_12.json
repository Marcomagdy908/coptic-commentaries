      "text": "قوائم الكهنة والاحتفال الختامي"
    },
    {
      "section_title": "4. الله سرّ فرحهم",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "43 وَذَبَحُوا فِي ذلِكَ الْيَوْمِ ذَبَائِحَ عَظِيمَةً وَفَرِحُوا، لأَنَّ اللهَ أَفْرَحَهُمْ فَرَحًا عَظِيمًا. وَفَرِحَ الأَوْلاَدُ وَالنِّسَاءُ أَيْضًا، وَسُمِعَ فَرَحُ أُورُشَلِيمَ عَنْ بُعْدٍ. 44 وَتَوَكَّلَ فِي ذلِكَ الْيَوْمِ أُنَاسٌ عَلَى الْمَخَادِعِ لِلْخَزَائِنِ وَالرَّفَائِعِ وَالأَوَائِلِ وَالأَعْشَارِ، لِيَجْمَعُوا فِيهَا مِنْ حُقُولِ الْمُدُنِ أَنْصِبَةَ الشَّرِيعَةِ لِلْكَهَنَةِ وَاللاَّوِيِّينَ، لأَنَّ يَهُوذَا فَرِحَ بِالْكَهَنَةِ وَاللاَّوِيِّينَ الْوَاقِفِينَ 45 حَارِسِينَ حِرَاسَةَ إِلهِهِمْ وَحِرَاسَةَ التَّطْهِيرِ. وَكَانَ الْمُغَنُّونَ وَالْبَوَّابُونَ حَسَبَ وَصِيَّةِ دَاوُدَ وَسُلَيْمَانَ ابْنِهِ. 46 لأَنَّهُ فِي أَيَّامِ دَاوُدَ وَآسَافَ مُنْذُ الْقَدِيمِ كَانَ رُؤُوسُ مُغَنِّينَ وَغِنَاءُ تَسْبِيحٍ وَتَحْمِيدٍ للهِ. 47 وَكَانَ كُلُّ إِسْرَائِيلَ فِي أَيَّامِ زَرُبَّابِلَ وَأَيَّامِ نَحَمْيَا يُؤَدُّونَ أَنْصِبَةَ الْمُغَنِّينَ وَالْبَوَّابِينَ أَمْرَ كُلِّ يَوْمٍ فِي يَوْمِهِ، وَكَانُوا يُقَدِّسُونَ لِلاَّوِيِّينَ، وَكَانَ اللاَّوِيُّونَ يُقَدِّسُونَ لِبَنِي هَارُونَ."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "أمور كثيرة هزت أعماق الكل: القادة والشعب ليفرح الكل ويتهلل. لكن الكاتب يسجل لنا هذه العبارة المفرحة: \" الله أفرحهم فرحًا عظيمًا \". سرّ فرحهم هو الحضور الإلهي، وعمله الفائق في حياتهم."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله هو الذي بدأ بالعمل في قلب نحميا، وهو الذي كمل العمل حتى النهاية."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله هو الذي وهبهم النجاح، وأبطل مقاومة الأشرار."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله وهبهم روح الوحدة للعمل معًا."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله هو الذي قدَّس المدينة والهيكل والسور!"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله هو قائد الموكب الخفي!"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله هو سور أورشليم الحقيقية وأبوابها، فهو الذي يحمي شعبه، ويدخل بهم إلى أمجاده!"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "* مَن نظر في ذاته إلى ربنا، وامتزجت نفسه بنوره، يمتلئ قلبه بالفرح."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "الشيخ الروحاني"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "* كما أن الأشجار إن لم تشرب من الماء لا يمكنها أن تنمو، هكذا النفس إن لم تقبل الفرح السماوي لا يمكنها أن تنمو وتصعد إلى العلاء. أما النفوس التي قبلت الروح والفرح السمائي فهي التي تستطيع الارتفاع إلى العلاء.. فقد انكشفت لها أسرار ملكوت السماوات وهي بعد في هذا الجسد، ووجدت دالة قدام الله في كل شيء، وكملت لها جميع طلباتها."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "* تتربى النفس دائمًا بهذا الفرح وتسعد به، وبه تصعد إلى السماء كالجسد لها غذاؤها الروحي."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "قول آبائي",
      "father_name": "القديس أنطونيوس الكبير",
      "text": "القديس أنطونيوس الكبير"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "* الفرح الحقيقي للنفس هو الخالق. لذلك يليق بالإنسان أن يبقى في حزن أبدي في داخله بتركه خالقه، وبحثه عن الفرح في نفسه."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "البابا غريغوريوس (الكبير)"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَتَوَكَّلَ فِي ذَلِكَ الْيَوْمِ أُنَاسٌ عَلَى الْمَخَادِعِ لِلْخَزَائِنِ وَالرَّفَائِعِ وَالأَوَائِلِ وَالأَعْشَارِ"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "لِيَجْمَعُوا فِيهَا مِنْ حُقُولِ الْمُدُنِ أَنْصِبَةَ الشَّرِيعَةِ لِلْكَهَنَةِ وَاللاَّوِيِّينَ"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "لأَنَّ يَهُوذَا فَرِحَ بِالْكَهَنَةِ وَاللاَّوِيِّينَ الْوَاقِفِينَ [44]"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "حينما تُقدم العبادة بالروح يفرح الكل، كهنةً وشعبًا."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "حَارِسِينَ حِرَاسَةَ إِلَهِهِمْ وَحِرَاسَةَ التَّطْهِيرِ."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَكَانَ الْمُغَنُّونَ وَالْبَوَّابُونَ حَسَبَ وَصِيَّةِ دَاوُدَ وَسُلَيْمَانَ ابْنِهِ. [45]"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "لأَنَّهُ فِي أَيَّامِ دَاوُدَ وَآسَافَ مُنْذُ الْقَدِيمِ"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "كَانَ رُؤُوسُ مُغَنِّينَ وَغِنَاءُ تَسْبِيحٍ وَتَحْمِيدٍ لِلَّهِ. [46]"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَكَانَ كُلُّ إِسْرَائِيلَ فِي أَيَّامِ زَرُبَّابِلَ وَأَيَّامِ نَحَمْيَا"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "يُؤَدُّونَ أَنْصِبَةَ الْمُغَنِّينَ وَالْبَوَّابِينَ أَمْرَ كُلِّ يَوْمٍ فِي يَوْمِهِ"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَكَانُوا يُقَدِّسُونَ لِلاَّوِيِّينَ"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "وَكَانَ اللاَّوِيُّونَ يُقَدِّسُونَ لِبَنِي هَارُونَ. [47]"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "من وحي نح 12"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "أنت هو سرّ فرحي!"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "* إلهي، أنت هو البداية والنهاية."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "بدأت العمل مع نحميا وسرت معه وبلغت معه إلى كمال النجاح!"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "كنت مرافقًا له،"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "فلم تستطع كل قوات الظلمة أن تحطمه."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "أعطيته نعمة أمام العظماء والفقراء."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "* إلهي وهبت شعبك روح الوحدة."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "كنت حاضرًا في وسطهم،"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "عاملًا بهم وفيهم لحساب ملكوتك!"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "* كنت القائد والمدبر والمقّدِس الخفي."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "صرت لهم سورًا من نارٍ تحميهم."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "وصرت لهم الباب لينعموا بالدخول إليك!"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "* إلهي أنت هو سرّ فرحي."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "كل أسوار العالم تُهدم يومًا ما."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "وأبواب الحياة الزمنية تُغلق."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "أنت هو سور حياتي."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "تحميني من ضربات العدو."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "وتحوط حولي بنعمتك،"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "وتجدد على الدوام أعماقي."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "* أنت هو فرحي الأبدي."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "بك أتحدى الموت."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "وبك أبلغ إلى حضن أبيك."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "وبك أنعم بالأبدية."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "لك المجد يا ينبوع كل فرحٍ سماويٍ!"
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "[1] Adam Clarke, Neh 12: 7."
    },
    {
      "section_title": "كل ما هو حولهم مفرح",
      "content_type": "شرح",
      "father_name": null,
      "text": "[2] Antiquities 7:11:8."
    }
  ]
}