{
  "book_id": "psalms",
  "book_title": "تفسير سفرالمزامير",
  "chapter_number": 119,
  "chapter_title": "المزمور 119",
  "topic": "الأصحاح 119",
  "chapter_outline": [
    {
      "number": 1,
      "title": "مزامير",
      "verses": ""
    },
    {
      "number": 2,
      "title": "الكتاب المقدس",
      "verses": ""
    },
    {
      "number": 3,
      "title": "تقصير الرابط",
      "verses": ""
    }
  ],
  "sections_count": 213,
  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "غنى كلمة الله ولذتها"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مزمور كلمة الله"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "هذا المزمور مقسم إلى قطع، وستجد تفسير كل قطع"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "في الجدول التالي..  اضغط على رقم القطعة لتصل إلى التفسير:-"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (أ): 1."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "تطويب الطاعة بقلبٍ غير منقسمٍ"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (ب): 2."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الوصية... كنز خفي"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (ج): 3."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الوصية... عزاء في الغربة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (د): 4."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "إحيني ككلمتك"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (ه): 5."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "اهدني في سبيل وصاياك"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (و): 6."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الشهادة لكلمة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الله"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (ز): 7."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "كلامك عزّاني في مذلتي"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (ح): 8."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ترضيت وجهك بكل قلبي"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (ط): 9."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "خير لي أنك أذللتني حتى أتعلم حقوقك"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (ي): 10."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أحكامك عادلة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (ك): 11."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "رجاء وسط الظلمة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (ل): 12."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "كلمتك دائمة في السموات"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (م): 13."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "كلماتك حلوة في حلقي"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (ن): 14."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مصباح لرجلي كلامك"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (س): 15."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "اعضدني حسب قولك"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (ع): 16."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "لا تسلمني إلى الذين يظلمونني"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (ف): 17."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "عجيبة هي شهاداتك"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (ص): 18."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "عادلة هي شهادتك إلى الأبد"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (ق): 19."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "قريب أنت يا رب"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (ر): 20."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "بعيد هو الخلاص عن الخطاة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (ش): 21."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "سلام عظيم للذين يحبون اسمك"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مز 119 (ت): 22."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "علمني، أعني، ابحث عني!"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "← تفاسير أصحاحات"
    },
