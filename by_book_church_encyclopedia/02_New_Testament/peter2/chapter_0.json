    {
      "section_title": "أولًا: كاتبها",
      "content_type": "شرح",
      "father_name": null,
      "text": "هو بطرس الرسول بدليل:"
    },
    {
      "section_title": "أولًا: كاتبها",
      "content_type": "شرح",
      "father_name": null,
      "text": "ذكر ذلك بنفسه (2 بط 1: 1)."
    },
    {
      "section_title": "أولًا: كاتبها",
      "content_type": "شرح",
      "father_name": null,
      "text": "ذكر ذلك بنفسه (2 بط 1: 1)."
    },
    {
      "section_title": "أولًا: كاتبها",
      "content_type": "شرح",
      "father_name": null,
      "text": "دعى نفسه رسولًا (ص 1: 1)."
    },
    {
      "section_title": "أولًا: كاتبها",
      "content_type": "شرح",
      "father_name": null,
      "text": "دعى نفسه رسولًا (ص 1: 1)."
    },
    {
      "section_title": "أولًا: كاتبها",
      "content_type": "شرح",
      "father_name": null,
      "text": "كان مع المسيح في تجليه (ص1: 16-18) ومن المعلوم أنه لم يكن مع المسيح إلا ثلاثة من الرسل أحدهم بطرس."
    },
    {
      "section_title": "أولًا: كاتبها",
      "content_type": "شرح",
      "father_name": null,
      "text": "كان مع المسيح في تجليه (ص1: 16-18) ومن المعلوم أنه لم يكن مع المسيح إلا ثلاثة من الرسل أحدهم بطرس."
    },
    {
      "section_title": "أولًا: كاتبها",
      "content_type": "شرح",
      "father_name": null,
      "text": "قال أنه كتب رسالة قبل هذه وهي الرسالة الأولى (ص3: 1)."
    },
    {
      "section_title": "أولًا: كاتبها",
      "content_type": "شرح",
      "father_name": null,
      "text": "قال أنه كتب رسالة قبل هذه وهي الرسالة الأولى (ص3: 1)."
    },
    {
      "section_title": "ثانيا: لمن كُتِبَت",
      "content_type": "شرح",
      "father_name": null,
      "text": "إلى مسيحيى آسيا الصغرى المذكورة بلادهم في (1 بط 1: 1) ويكتب لهم هنا رسالة ثانية (ص 3: 1)."
    },
    {
      "section_title": "ثالثًا: زمن كتابتها",
      "content_type": "شرح",
      "father_name": null,
      "text": "كتبت في أواخر حياة بطرس الرسول (ص 1: 14) أي بين عامى 64 م و68 م وبالتقريب حوالي عام 66 م."
    },
    {
      "section_title": "رابعًا: مكان كتابتها",
      "content_type": "شرح",
      "father_name": null,
      "text": "لم يذكر في هذه الرسالة وغالبًا في نفس مكان كتابة الرسالة الأولى أي بابل وهي بابليون الدرج بمصر القديمة."
    },
    {
      "section_title": "خامسًا: أغراضها وسماتها",
      "content_type": "شرح",
      "father_name": null,
      "text": "حياة القداسة والإستعداد لمجئ الرب."
    },
    {
      "section_title": "خامسًا: أغراضها وسماتها",
      "content_type": "شرح",
      "father_name": null,
      "text": "حياة القداسة والإستعداد لمجئ الرب."
    },
    {
      "section_title": "خامسًا: أغراضها وسماتها",
      "content_type": "شرح",
      "father_name": null,
      "text": "رفض الهرطقات."
    },
    {
      "section_title": "خامسًا: أغراضها وسماتها",
      "content_type": "شرح",
      "father_name": null,
      "text": "رفض الهرطقات."
    },
    {
      "section_title": "خامسًا: أغراضها وسماتها",
      "content_type": "شرح",
      "father_name": null,
      "text": "تتشابه هذه الرسالة مع رسالة يهوذا لدرجة كبيرة في الكلام عن الهراطقة."
    },
    {
      "section_title": "خامسًا: أغراضها وسماتها",
      "content_type": "شرح",
      "father_name": null,
      "text": "تتشابه هذه الرسالة مع رسالة يهوذا لدرجة كبيرة في الكلام عن الهراطقة."
