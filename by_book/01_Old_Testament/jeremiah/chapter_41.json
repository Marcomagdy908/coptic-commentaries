      "content_type": "شرح",
      "father_name": null,
      "text": "سَبَى"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "إسمعيل بنات الملك، لا يُقصد بهن بنات صدقيا فحسب بل كل الأعضاء الأناث في البيت"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "الملكي والأميرات اللواتي كن قد وُضعن في رعاية جدليا، اللواتي تسلمهن من يد"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "نبوخذنصر."
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "قبل أن يتمكن إسمعيل السفَّاك من الهرب إلى بلاد"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "عمون بمن أراد أن يأخذهم معه من أهل جدليا والشعب عمومًا، هاجمه يوحنان بن قاريح"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "وبعض الرؤساء الآخرين عند"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "بركة جبعون (2 صم 2: 13) حيث وقع في القديم الصدام بين"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "رجال داود ورجال إيشبوشث بن شاول، ولم يقدر إسمعيل أن يقاومهم فاضطر أن يترك الذين"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "أجبرهم إلى ذهاب معه، فهرب ومعه ثمانية رجال إلى بلاد عمون حيث فقد اثنين من"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "رجاله، ولم نعد نسمع عنه شيئًا."
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "البعض أن المياه الكثيرة في جبعون ربما تشير إلى"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "بركة جبعون لخزان المياه المحفور"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "في الصخر الموجود في الجب، والذي يرجع تاريخه إلى العصر الحديدي الأول. هذه الحفرة"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "قد حفرت إلى عمق خمسة وثلاثين قدمًا في الصخر وبها درج يؤدي إلى نفق على بعد"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "أربعين قدمًا أخرى مؤديًا إلى خزان مياه. وفي القرن السابع ق.م. كان يُصنع النبيذ"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "في منطقة الحفرة وكانت الجرار المختومة تخَّزن في مخازن رطبة محفورة في الصخر."
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "والرأي"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "القائل بأن الكلمة هنا يجب أن تكون (جبعة) \"Geba\" بدلًا من جبعون رأى ليس له قيمة حقيقية."
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "يوحانان بن قاريح حاسمًا وسريعًا في تتبع إسمعيل وقد سبق فحذر جدليا من نواياه"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "الإجرامية."
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "يوحانان والذين معه أن يهربوا إلى مصر خوفًا من عقاب بابل، وإن كانوا هم أنفسهم لم"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "يثوروا على بابل هذه المرة كإسمعيل."
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "وحي إرميا 41"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "من ينزع عني روح الحسد!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "انزع"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "عني روح الحسد يا محب البشر!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "قتل إسمعيل جدليا حسدًا بلا سبب!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "قتل الرؤساء فحطَّم بلده،"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "قتل البسطاء والقادمين للعبادة الأتقياء!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "قتل وتمادَى في القتل، ولم ينتفع شيئًا!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "* من"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "ينزع عني"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "روح الحسد؟"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "بثّ إبليس روحه فينا،"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "هذا الذي حرمنا من الفردوس وهو لم يدخله!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "صرنا أشر منه،"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "فالشيطان لا يحسد شيطانًا،"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "أما الإنسان فيحسد أخاه الإنسان!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "ويحي"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "أنا الشقي!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالحسد لا أطلب نجاح نفسي بل فشل إخوتي!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالحسد يحترق قلبي لا لشيء إلا لنجاح"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "الغير!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالحسد يضيق قلبي جدًا،"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "فلا يسمح بدخول أحدٍ!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالحسد أُطرد خارج الكنيسة،"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "بل وأفقد جمال إنسانيتي!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "* بالحسد"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "جبابرة"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "إيمان!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالحسد صارت عبادتهم عائقًا في طريق"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "نموهم!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالحسد حُرم صانعوا عجائب من التمتع بك!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالحسد تسلل الموت حتى إلى بعض الخدام"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "الناجحين والنسَّاك والمتوحدين!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "إنه لصٌ خفيٌ خطير،"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "له مداخل خفيَّة إلى أعماق النفس!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "ينزع عني الحسد،"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "إلا أنت يا محب البشر؟!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "يحملني روحك القدوس إلى حضن أبيك،"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "أجده متسعًا للجميع،"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "فأصير أنا متسعًا للكل!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "بصليبك"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "حطمت حسد إبليس العامل فيّ،"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "ووهبتني حبك الإلهي الفائق!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "فأشتهي أن أقتدي بك يا من صرت آخر الكل!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "هب لي أن أنطلق معك إلى الصف الآخير،"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "أبسط يديّ مع يديك لاحتضن الجميع."
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "أشتهي أن أتألم معك ليستريح الكل،"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "وأن أحمل عارك لتتمجد كل نفسٍ،"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "وأفقد كل شيء لكي يغتني الجميع بك."
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "نعم، لأمت معك وليحيا الكل بك!"
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "Keil: Jeremiah, p. 136."
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
      "father_name": null,
      "text": "المؤلف: الحب الأخوى 1964، ص 397."
    },
    {
      "section_title": "3. سبي البقية وإطلاق سراحها",
      "content_type": "شرح",
