  "sections_count": 50,
  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "عظمة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مردخاي"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "قدم لنا هذا الأصحاح صورة عن"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "عظمة أحشويروش الذي خضعت له كور كثيرة تقدم له الجزية، وكان الرجل الثاني مردخاي"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "\"عظيمًا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "بين اليهود ومقبولًا عند كثرة إخوته طالبًا الخير لشعبه ومتكلمًا بالسلام لكل"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "نسله\" [3]. وكان سرّ عظمته هو اتساع قلبه بالحب لإخوته، وحديثه بالسلام"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "من أجل أولاده. لقد صار سرّ بركة لجيله وللأجيال المقبلة خلال محبته الفائقة."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "إن كان الشعب كله قد تمجد بخلاصه من"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "العدو، فمردخاي وهو لا يطلب ما لنفسه بل ما للآخرين تمجد أكثر فأكثر."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "وفي تتمة أستير يكمل هذا الأصحاح"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "باستعراض حلم مردخاي الذي فيه أكد الله له أنه يعمل به وبأستير لخلاص إخوتهما، وقد"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "سبق لنا الحديث عن هذا الحلم."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "إلهنا الصالح الذي أعطى لأستير ومردخاي"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "نعمة الفم المفتوح والقلب المتسع بالحب من أجل إخوتها يفتح قلوبنا لبنيان كل نفس"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "لمجد الله!"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ستجد تفاسير باقي أصحاحات"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "السفر في"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "تفسير القمص أنطونيوس فكري لسفر أستير."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "← تفاسير أصحاحات"
