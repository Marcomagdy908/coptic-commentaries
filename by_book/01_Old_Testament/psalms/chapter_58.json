  ],
  "sections_count": 16,
  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "المشورات المداهنة الشريرة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "القضاة الأشرار"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "يقدم المرتل تشبيهات ليعبر عن مصير القضاة وأصحاب السلطة الأشرار:"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أ. الأخرس الصامت عن التكلم بالحق، بينما أعماله تشهد عن شره [1-2]."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ب. السقط الذي انحرف عن الحق قبل ولادته [3]."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ج. الحية الصماء التي لا تسمع توسلات الناس ولا تهديدات الله [4-5]، إنما ما يشغلها هو أن تبث سمومها القاتلة."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "د. الأسد أو الشبل، الذي يكسِّر الله أنيابه [6]."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ه. الماء الساقط من الأمطار الذي يجف ويختفي [7]."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "و. القوس الذي سهامه غير حادة [7]."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ز. الحلزون الذي مع سيره البطيء، فإن ما يخرجه من مخاط على الطريق يزول [8]."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ح. السقط الذي لا يعاين نور شمس البرَّ، لأنه لا يرى الحياة [8]."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ط. الشوك الذي تحت القدر، تجرفه الرياح سواء بعد أن احترق وصار رمادًا أو لم يحترق [9]."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "أقسامه"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "العنوانَ"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "\"لإِمَامِ الْمُغَنِّينَ. عَلَى لاَ تُهْلِكْ. لِدَاوُدَ. مُذَهَّبَة\""
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "راجع ما ورد في المزمور السابق بخصوص تعبير \" لاَ تُهْلِكْ \" ."
    }
  ]
}