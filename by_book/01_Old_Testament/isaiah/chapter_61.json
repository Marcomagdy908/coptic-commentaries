  "sections_count": 222,
  "sections": [
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الحيَاة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "الجديدة"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "يقدم لنا السيد المسيح برنامجًا حيًا"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "لعمله الخلاصي فقد جاء من أجل المساكين ومنكسري القلب والمسبيين وكل النائحين ليهب"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "عزاءً ومجدًا خلال التجديد الذي يهبه للمؤمنين به ليقيمهم كهنة وملوكًا له"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "ويختارهم عروسًا روحية مقدسة له."
    },
    {
      "section_title": "1. برنامج المسيح الخلاصي",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "1 رُوحُ السَّيِّدِ الرَّبِّ عَلَيَّ، لأَنَّ الرَّبَّ مَسَحَنِي لأُبَشِّرَ الْمَسَاكِينَ، أَرْسَلَنِي لأَعْصِبَ مُنْكَسِرِي الْقَلْبِ، لأُنَادِيَ لِلْمَسْبِيِّينَ بِالْعِتْقِ، وَلِلْمَأْسُورِينَ بِالإِطْلاَقِ. 2 لأُنَادِيَ بِسَنَةٍ مَقْبُولَةٍ لِلرَّبِّ، وَبِيَوْمِ انْتِقَامٍ لإِلَهِنَا. لأُعَزِّيَ كُلَّ النَّائِحِينَ. 3 لأَجْعَلَ لِنَائِحِي صِهْيَوْنَ، لأُعْطِيَهُمْ جَمَالًا عِوَضًا عَنِ الرَّمَادِ، وَدُهْنَ فَرَحٍ عِوَضًا عَنِ النَّوْحِ، وَرِدَاءَ تَسْبِيحٍ عِوَضًا عَنِ الرُّوحِ الْيَائِسَةِ، فَيُدْعَوْنَ أَشْجَارَ الْبِرِّ، غَرْسَ الرَّبِّ لِلتَّمْجِيدِ."
    },
    {
      "section_title": "1. برنامج المسيح الخلاصي",
      "content_type": "شرح",
      "father_name": null,
      "text": "يقدم"
    },
    {
      "section_title": "1. برنامج المسيح الخلاصي",
      "content_type": "شرح",
      "father_name": null,
      "text": "لنا السيد المسيح على لسان إشعياء النبي برنامجًا حيًا عن عمله الخلاصي، يعرضه في"
    },
    {
      "section_title": "إيجاز مع عمق، وهو",
      "content_type": "شرح",
      "father_name": null,
      "text": "تمتع البشرية بالروح القدس الذي يُجدد الطبيعة البشرية ويغنيها، ينزع عنها فسادها"
    },
    {
      "section_title": "إيجاز مع عمق، وهو",
      "content_type": "شرح",
      "father_name": null,
      "text": "ويهبها الحياة الجديدة التي في المسيح يسوع فتنعم بشركة الحياة الإلهية... هذه"
    },
    {
      "section_title": "إيجاز مع عمق، وهو",
      "content_type": "شرح",
      "father_name": null,
      "text": "العطية قُدمت لنا في شخص السيد المسيح القائل: \"روح السيد الرب عليّ\""
    },
    {
      "section_title": "إيجاز مع عمق، وهو",
      "content_type": "شرح",
      "father_name": null,
      "text": "[1]. كما سبق فقلنا في"
    },
    {
      "section_title": "إيجاز مع عمق، وهو",
      "content_type": "شرح",
      "father_name": null,
      "text": "تفسير الأصحاح الحادي عشر أن الروح القدس هو روح"
    },
    {
      "section_title": "إيجاز مع عمق، وهو",
      "content_type": "شرح",
      "father_name": null,
      "text": "الابن، ليس غريبًا عن المسيح، لكنه بالتجسد قبل حلوله عليه باسم الكنيسة ولحساب"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "لقد فارق الروح"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "القدس الإنسان لأنه لم يكن قادرًا على أن يحل في الفساد، ولكن الآن ظهر إنسان جديد"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "بين البشر وهو وحده الذي يجعل عودة الروح ممكنة، لأن هذا الإنسان بدون خطيئة."
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "لقد وعد الله"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "أن يعطي الروح مرة ثانية للبشرية... ولم تكن هناك طريقة أخرى يمكن بها إعادة هذه"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "النعمة إلى الإنسانية بدون مفارقة سوى في يسوع المسيح... إنها عودة أبدية سببها"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "حالة الاستقرار والثبات."
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "لقد منح المسيح الروح القدس لناسوته، وبذلك جعل الروح يتآلف"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "من جديد مع طبيعتنا."
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "إن عودة الروح"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "القدس للإنسان في المسيح، الإله المتجسد، آدم الثاني، عودة أبدية. فالروح القدس حلّ"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "على آدم الثاني لبرِّه. والبرّ في المسيح برّ ثابت، لأن اتحاد اللاهوت بالناسوت في"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "شخص المسيح ثابت... وهذا ضمان ثابت للبشرية واستقرارها في الحياة الجديدة."
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "قول آبائي",
      "father_name": "القديس كيرلس الكبير",
      "text": "القديس كيرلس الكبير"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "القديس"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "قول آبائي",
      "father_name": "القديس إيريناؤس",
      "text": "إيريناؤس"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "أضاء الروح"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "القدس في كمال وجوده عليه، فالشبيه يستقر بالشبيه. أما بالنسبة لكم فبعدما صعدتم"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "من جرن المياه المقدسة وُهبت لكم المسحة التي هي رمز لما مُسح به المسيح؛ هذا هو"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "الروح القدس."
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "قول آبائي",
      "father_name": "القديس كيرلس الكبير",
      "text": "القديس كيرلس الأورشليمي"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "دُفع إلى السيد المسيح سفر إشعياء قرأ هذا الفصل، \"ثم طوى السفر وسلمه إلى"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "الخادم وجلس... فابتدأ يقول لهم: إنه اليوم قد تمّ هذا المكتوب في مسامعكم\" (لو 4: 17-21)."
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "جاء السيد المسيح ليُفرِّح قلوب المساكين بإنجيل خلاصه، ويعصب منكسري القلوب ويهب"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "حريته للمسبيين... حاسبًا مجيئه سنة يوبيل حقيقية مقبولة لدى الرب وواهبة عزاء"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "للنائحين (إش 61: 2؛ لا 25: 9، 40)."
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "مجيئه \"يوم انتقام لإلهنا\" [2]، حيث حطّم سلطان قوات"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "الظلمة، إبليس وملائكته وأعماله الشريرة."
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "يُقيم الرب المؤمنين كأشجار برّ أو غروس الرب في الفردوس الإلهي [3]، تحمل جمالًا"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "عوض الرماد، ودهن فرح عوض النوح، ورداء تسبيح عوض الروح اليائسة؛ أي يسكب علينا"
    },
    {
      "section_title": "المؤمنون به",
      "content_type": "شرح",
      "father_name": null,
      "text": "جماله وفرحه وتسبيحه عوض المذلة والنوح واليأس!"
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "4 وَيَبْنُونَ الْخِرَبَ الْقَدِيمَةَ. يُقِيمُونَ الْمُوحِشَاتِ الأُوَلَ، وَيُجَدِّدُونَ الْمُدُنَ الْخَرِبَةَ، مُوحِشَاتِ دَوْرٍ فَدَوْرٍ. 5 وَيَقِفُ الأَجَانِبُ وَيَرْعَوْنَ غَنَمَكُمْ، وَيَكُونُ بَنُو الْغَرِيبِ حَرَّاثِيكُمْ وَكَرَّامِيكُمْ. 6 أَمَّا أَنْتُمْ فَتُدْعَوْنَ كَهَنَةَ الرَّبِّ، تُسَمَّوْنَ خُدَّامَ إِلهِنَا. تَأْكُلُونَ ثَرْوَةَ الأُمَمِ، وَعَلَى مَجْدِهِمْ تَتَأَمَّرُونَ."
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "رسالة"
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "السيد المسيح الذي مسحه الآب ليبشر للمساكين هي \"تجديد المدن الخربة\""
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "التي صارت موحشة عبر الأجيال. لقد صارت الطبيعة البشرية في كل الأجيال أشبه بالمدن"
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الخربة تحتاج إلى هدم وإعادة بناء. هذا هو عمل الله الخالق الذي يُقيم ملكوته"
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "فينا، فيحوّلنا بروحه القدوس من مسكن للخطية والشر إلى مقدس للرب. أما الأجانب"
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الذين يرعون غنمنا، وبنو الغريب الذين يقومون بحراسة أرضنا والعمل ككرامين في"
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "حديقتنا، فهم طاقات النفس الداخلية ودوافعها التي صارت كمن هي أجنبية وغريبة عن"
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرب وملكوته. إنها تخضع من جديد فلا تصير عثرة في طريق خلاصنا بل على العكس معينًا"
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "للنفس تسندها في جهادها. وذلك كما فعل الشعب العبراني قديمًا حين حملوا الذهب"
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "والفضة والثياب الفاخرة من المصريين واستخدموها في إقامة خيمة الاجتماع بدلًا من"
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "استخدامها في"
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "عبادة الأوثان في مصر."
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "يقول:"
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"تُدعَون كهنة للرب\" [6]، ذلك لأننا إذ نحمل الطبيعة"
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الجديدة خلال المعمودية نصير روحيًا كهنة، نرفع أيدينا للصلاة ونقدم أجسادنا ذبيحة"
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "حب مقبولة لدى الآب. هذا الكهنوت يدعوه"
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "قول آبائي",
      "father_name": "القديس جيروم",
      "text": "القديس إيرونيموس \"الكهنوت"
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الشعبي"
    },
    {
      "section_title": "2. الحياة الكنسية الجديدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "Laic Priesthood\"."
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "7 عِوَضًا عَنْ خِزْيِكُمْ ضِعْفَانِ، وَعِوَضًا عَنِ الْخَجَلِ يَبْتَهِجُونَ بِنَصِيبِهِمْ. لِذلِكَ يَرِثُونَ فِي أَرْضِهِمْ ضِعْفَيْنِ. بَهْجَةٌ أَبَدِيَّةٌ تَكُونُ لَهُمْ. 8 «لأَنِّي أَنَا الرَّبُّ مُحِبُّ الْعَدْلِ، مُبْغِضُ الْمُخْتَلِسِ بِالظُّلْمِ. وَأَجْعَلُ أُجْرَتَهُمْ أَمِينَةً، وَأَقْطَعُ لَهُمْ عَهْدًا أَبَدِيًّا. 9 وَيُعْرَفُ بَيْنَ الأُمَمِ نَسْلُهُمْ، وَذُرِّيَّتُهُمْ فِي وَسَطِ الشُّعُوبِ. كُلُّ الَّذِينَ يَرَوْنَهُمْ يَعْرِفُونَهُمْ أَنَّهُمْ نَسْلٌ بَارَكَهُ الرَّبُّ»."
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله كنيسته فيضًا من المجد الداخلي والتعزيات السماوية والفرح الدائم."
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "مكافأة مضاعفة عوض المتاعب القديمة: \"عوضًا عن خزيكم ضعفان، وعوضًا عن"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الخجل يبتهجون بنصيبهم، لذلك يرثون في أرضهم ضعفين\" [7]."
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "هي المكافأة المضاعفة التي نتمتع بها عوضًا عن خزينا؟ التمتع بغفران خطايانا،"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "ونوال برّ المسيح؛ بمعنى آخر نزع خزي الخطية والتمتع بمجد المسيح فينا؛ العفو عنا"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "كعبيد عصاة وقبولنا كأبناء لله في المسيح يسوع الابن الوحيد الجنس."
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "يقف عمل المسيح الكفاري عند إيفاء الدين الذي أثقل كاهلنا، وإنما قدم لنا بره"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "لنشاركه مجده؛ يقول الرسول: \"لأنكم قد مُتُّم وحياتكم مستترة مع المسيح في الله،"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "متى أظهر المسيح حياتنا فحينئذ تظهرون أنتم أيضًا معه في المجد\" (كو 3: 3-4)."
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "لعله"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "أيضًا يقصد بالميراث المضاعف القيامتين: القيامة الأولى التي ننالها هنا في حياتنا"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الزمنية إذ ننعم بالحياة المقامة، والقيامة الثانية حين يأتي رب المجد على السحاب"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "لنقوم معه ونوجد معه في المجد. وكما يقول"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "قول آبائي",
      "father_name": "القديس أغسطينوس",
      "text": "القديس أغسطينوس: [نحن الذين متنا"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "موتًا مزدوجًا (موت النفس والجسد)، نقوم قيامة مزدوجة. حتى الآن نحن قمنا قيامة"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "واحدة، وهي القيامة من الخطية، لأننا دُفنا معه في المعمودية، وقمنا معه خلال"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "المعمودية بالقيامة. هذه القيامة هي الخلاص من خطايانا؛ وأما القيامة الأخرى فهي"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "قيامة الجسد. هو أعطانا القيامة العظمى، وها نحن ننتظر الأقل! القيامة الأولى أعظم"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "من الثانية، إذ خلاصنا من خطايانا أعظم من قيامة الجسد]."
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "كانت سمة مملكة إبليس الأنانية التي تجلب الكراهية فأن خزينا الذي سقطنا فيه هو"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "اتسامنا بالأنانية القاتلة، عوض هذا الخزي صار لنا الميراث المضاعف أي الحب من"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "جانبيه المتكاملين، حب الله وحب القريب."
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "وكأن عمل المسيح فينا أن يُحطم الأنا"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "ليهبنا حبًا فائقًا لله ولخليقته."
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"بهجة أبدية تكون لهم\" [7]؛ ما دامت الحياة الكنسية هنا هي"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "عربون الحياة السماوية، تتسم بالمجد المضاعف عوض الخزي، وبالحب عوض الأنانية... فإنها"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "تحمل بهذا طبيعة الفرح والبهجة! سرّ فرحنا أننا نحمل مسيحنا فينا، ليُقيم ملكوته"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "السماوي المفرح في أعماقنا."
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"وأقطع لهم عهدًا أبديًا\" [8]... كثيرًا ما يكرر سفر"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "إشعياء الحديث عن هذا العهد بين الله وكنيسته المعلن في جسد المسيح المصلوب كسرّ"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "مصالحة أبدية."
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "بركة في ثمارهم الروحية كما نسلهم: \"ويُعرف بين الأمم نسلهم، وذريتهم وسط"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الشعوب، كل الذين يرونهم أنهم نسل باركه الرب\" [9]..."
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "هو هذا النسل المبارك الذي يعرفه الأمم؟"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "يقصد أولادنا حسب الجسد، وإنما بالأكثر الذين يتتلمذون للرب خلالنا، والذين"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "يتعرفون على الخلاص وينالون الميلاد الجديد خلال شهادتنا الحية لإنجيل خلاصنا."
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "وربما"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "عَنَى بالنسل والذرية الأعمال المقدسة التي هي ثمار روح الله القدوس فينا، وعطية"
    },
    {
      "section_title": "3. الحياة الكنسية المجيدة",
      "content_type": "شرح",
      "father_name": null,
      "text": "نعمته المجانية في حياتنا."
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "10 فَرَحًا أَفْرَحُ بِالرَّبِّ. تَبْتَهِجُ نَفْسِي بِإِلهِي، لأَنَّهُ قَدْ أَلْبَسَنِي ثِيَابَ الْخَلاَصِ. كَسَانِي رِدَاءَ الْبِرِّ، مِثْلَ عَرِيسٍ يَتَزَيَّنُ بِعِمَامَةٍ، وَمِثْلَ عَرُوسٍ تَتَزَيَّنُ بِحُلِيِّهَا. 11 لأَنَّهُ كَمَا أَنَّ الأَرْضَ تُخْرِجُ نَبَاتَهَا، وَكَمَا أَنَّ الْجَنَّةَ تُنْبِتُ مَزْرُوعَاتِهَا، هكَذَا السَّيِّدُ الرَّبُّ يُنْبِتُ بِرًّا وَتَسْبِيحًا أَمَامَ كُلِّ الأُمَمِ."
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الحياة"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الكنسية الحقة هي حياة عرس دائم مملوء فرحًا وبهجة بلا انقطاع، خلاله نرتدي ثوب"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الخلاص كثوب العرس الأبدي، أو كثوب كهنوتي عام..."
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"فرحًا"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "أفرح بالرب، تبتهج نفسي بإلهي لأنه قد ألبسني ثياب الخلاص، كساني رداء البرّ مثل"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "عريس يتزين بعمامة (تاج) ومثل عروس تتزين بحُليها\" [10]."
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "في بعض الكنائس التقليدية يردد الكاهن العبارة السابقة عند"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "ارتدائه الثياب الكهنوتية للاشتراك في قداس الأفخارستيا، حاسبًا أنه يتقدم لسرّ"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأفخارستيا كما إلى عرس مفرح، يحتاج إلى ارتداء ثياب الخلاص الخفية ورداء البر"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "وزينة الروح... ما هو هذا الثوب إلاَّ السيد المسيح نفسه؟! يلبسه المؤمنون عند"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "تمتعهم بمياه المعمودية (غل 3: 27)."
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "حقًا المسيح هو"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "زينة العروس، هذا الذي هو الكائن والذي كان والذي يأتي، المبارك الآن وإلى الأبد،"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "أمين."
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "قول آبائي",
      "father_name": "القديس غريغوريوس النيسي",
      "text": "القديس غريغوريوس النيسي"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الآن (بعد"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "العماد) إذ خلعتم ثيابكم القديمة ولبستم الثياب البيضاء روحيًا، يليق بكم أن"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "تستمروا في ارتداء ما هو أبيض. بالطبع لا نقصد بهذا أن تلبسوا ثوبًا أبيض على"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "الدوام، إنما أن تلتحفوا بثياب بيضاء بالحق، مضيئة روحيًا، فتقولون مع الطوباوي"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "إشعياء: \"تبتهج نفسي بإلهي لأنه قد ألبسني ثياب الخلاص...\"."
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "احفظوا اليوم"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "المقدس، مرتدين ثوب الخلاص، يسوع المسيح."
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "قول آبائي",
      "father_name": "القديس كيرلس الكبير",
      "text": "القديس كيرلس الأورشليمي"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "أوضح النبي ماذا يعني بثياب الخلاص، قائلًا: \"لأنه كما أن الأرض تخرج"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "نباتها، وكما أن الجنة تنبت مزروعاتها هكذا السيد الرب ينبت برًّا وتسبيحًا أمام"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "كل الأمم\" [11]، وكأن ثياب الخلاص هو برّ المسيح وتسبيحه الذي"
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "يهبه لنا عطية مجانية من عندياته."
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "التجسد والروح القدس، 1981، ص 10."
    },
    {
      "section_title": "4. حياة زوجية مفرحة",
      "content_type": "شرح",
      "father_name": null,
      "text": "Adv. Haer 3:18:3."
    },
    {
