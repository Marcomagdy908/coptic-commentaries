      "text": "نصيب أفرايم"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "بعشائره"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "بعشائره..."
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "1 وَخَرَجَتِ الْقُرْعَةُ لِبَنِي يُوسُفَ مِنْ أُرْدُنِّ أَرِيحَا إِلَى مَاءِ أَرِيحَا نَحْوَ الشُّرُوقِ إِلَى الْبَرِّيَّةِ الصَّاعِدَةِ مِنْ أَرِيحَا فِي جَبَلِ بَيْتِ إِيلَ. 2 وَخَرَجَتْ مِنْ بَيْتِ إِيلَ إِلَى لُوزَ وَعَبَرَتْ إِلَى تُخُمِ الأَرَكِيِّينَ إِلَى عَطَارُوتَ، 3 وَنَزَلَتْ غَرْبًا إِلَى تُخُمِ الْيَفْلَطِيِّينَ إِلَى تُخُمِ بَيْتِ حُورُونَ السُّفْلَى، وَإِلَى جَازَرَ، وَكَانَتْ مَخَارِجُهَا عِنْدَ الْبَحْرِ. 4 فَمَلَكَ ابْنَا يُوسُفَ مَنَسَّى وَأَفْرَايِمُ. 5 وَكَانَ تُخُمُ بَنِي أَفْرَايِمَ حَسَبَ عَشَائِرِهِمْ. وَكَانَ تُخُمُ نَصِيبِهِمْ شَرْقًا: عَطَارُوتَ أَدَّارَ إِلَى بَيْتِ حُورُونَ الْعُلْيَا. 6 وَخَرَجَ التُّخُمُ نَحْوَ الْبَحْرِ إِلَى الْمَكْمَتَةِ شِمَالًا، وَدَارَ التُّخُمُ شَرْقًا إِلَى تَآنَةِ شِيلُوهَ وَعَبَرَهَا شَرْقِيَّ يَنُوحَةَ. 7 وَنَزَلَ مِنْ يَنُوحَةَ إِلَى عَطَارُوتَ وَنَعَرَاتِ وَوَصَلَ إِلَى أَرِيحَا وَخَرَجَ إِلَى الأُرْدُنِّ. 8 وَجَازَ التُّخُمُ مِنْ تَفُّوحَ غَرْبًا إِلَى وَادِي قَانَةَ، وَكَانَتْ مَخَارِجُهُ عِنْدَ الْبَحْرِ. 9 هذَا هُوَ نَصِيبُ سِبْطِ بَنِي أَفْرَايِمَ حَسَبَ عَشَائِرِهِمْ مَعَ الْمُدُنِ الْمُفْرَزَةِ لِبَنِي أَفْرَايِمَ فِي وَسَطِ نَصِيبِ بَنِي مَنَسَّى. جَمِيعُ الْمُدُنِ وَضِيَاعِهَا."
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "كلمة \"أفرايم\" تعني (الثمر"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "المتكاثر)، كأن هذا السبط إنما يضم جماعة المؤمنين الذين قبلوا عطية المسيح لهم،"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "روحه القدوس ساكنًا فيهم يهبهم ثمره المتزايد. هؤلاء بحق يستحقون الالتصاق بإخوتهم"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "بني يهوذا، لأنه إن كان يهوذا يُشير إلى التمتع بالاتحاد مع السيد المسيح الخارج"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "من هذا السبط، والانتساب له، فإن بني أفرايم يمثلون أصحاب الثمار المتكاثرة في"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "المسيح يسوع بواسطة روحه القدوس، الذي يأخذ مما له ويخبرنا (يو 16: 15). إنه يهبنا"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "سمات السيد المسيح نفسه، فيعطينا محبة المسيح وفرحه وسلامه وصلاحه وطول أناته إلخ..."
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "(غلا 5: 22) وذلك خلال دخوله بنا إلى الثبوت في المسيح، أو إتحادنا معه وفيه. إذن"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "فثمر الروح لا ينفصل عن الوحدة مع الآب في المسيح يسوع، وكأن أفرايم إنما يجب أن"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "يلتصق بيهوذا ويصحبه! بمعنى آخر، ليت كل مؤمن من انتسب لأفرايم، وصار له"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "ثمر الروح"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "القدس ينطلق خلال هذا الثمر إلى إتحاد أعمق مع السيد المسيح."
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "يشجعنا"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "قول آبائي",
      "father_name": "القديس جيروم",
      "text": "القديس جيروم أن نلتصق"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "بهذا السبط إذ لنا معه نصيب في الميراث الإلهي أو الإكليل، قائلًا: [كُن أفرايم"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "أيضًا، كُن مثمرًا، لتنتج الأعمال الصالحة، وعندئذ يكون لك إكليل الرب]."
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "ونصف منسى أخذا منتصف كنعان (السامرية)، لأن شكيم كان قد عينها يعقوب ليوسف (تك 48: 21-22؛ يش 24: 32)، فيها دُفنت عظام يوسف، وقد صارت من نصيب منسى، بينما"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "صارت شيلوه من نصيب أفرايم ولكلا البلدين ذكريات روحية خاصة لدى الشعب"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "القديم، نكتفي هنا بالحديث عن شيلوه بكونها نصيب أفرايم. فإن \"شيلوه\""
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "غالبًا ما تعني (موضع الراحة)، تبعد حوالي 9 أميال شمال شرق بيت إيل وحوالي 17"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "ميلًا شمال أورشليم، ربما تكون سيلون الحالية."
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "تمتع أفرايم بشيلوه بكونها المدينة التي تمثل"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الحضرة الإلهية وسط شعبه، فقد اختارها يشوع مقرًا للتابوت والخدمة، وفيها قسم يشوع"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأرض ووزعها على"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأسباط (يش 18: 1، 8-10)، وقد بقيت الخيمة حوالي 300 عامًا في"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "شيلوه. وفي عهد القضاة كان الشعب يجتمع معًا سنويًا في شيلوه للتعييد وربما لتقديم"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الذبيحة كعلامة فرح بالله الساكن في وسطهم، وكانت بنات شيلوه يرقصن ابتهاجًا"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "بالعيد. وفي إحدى تلك الأعياد، خطف البنياميون 200 منهن وتزوجوا بهن (قض 21: 19-23؛ 1 صم 1-3). وكانت شيلوه مسكن عالي الكاهن وصموئيل. لكن الله رفض شيلوه"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "فصارت عبرة أمام كل الشعب، إن الله إن كان قد أحب شيلوه هذه القرون لكنها إذ أصرَّت"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "على الشر هجرها وسمح بخرابها، لهذا كان يُهدد الله أورشليم فيما بعد أن تصير"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "كأختها شيلوه! إنها مثل الإنسان الذي ينعم بفيض حب الله وعطاياه المجانية فتكون"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "دينونته أشد إن أصر على العصيان والحياة الدنسة. لقد رفض الله مسكن شيلوه ولم يعد"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "التابوت هناك، بل أصعده داود إلى أورشليم (2 صم 6)، ونُقِلَت الخيمة إلى نوب في"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الجنوب (1 صم 21: 1-9)، ومن هناك إلى جبعون ثم أورشليم (2 أي 1: 3-4). هناك سكن"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "أخيا النبي (1 مل 14: 1-16). ويظهر أن شيلوه كانت خربة في أيام إرميا النبي (إر 7: 12، 14؛ 26: 6، 9) وفي أيام"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "قول آبائي",
      "father_name": "القديس جيروم",
      "text": "القديس جيروم. وقد أظهرت الحفريات الدنمركية"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "(1930-1932) أن شيلوه قد خربت حوالي عام 1050 ق.م، وبقيت هكذا لعدة قرون، لهذا"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "فغالبًا ما يكون قد تم على يدّي الفلسطينيين بعد غلبتهم على أفيق."
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "إن كان لنا ثمر روح الله وحسبنا أعضاء في"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "أفرايم الروحي، إنما تقوم شيلوه في داخلنا، التي ينبغي أن نحذر لئلا تخرب"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "وتنهدم بسبب تراخينا وفساد ص 188 حياتنا، فينزع الرب بركته ويبحث عن أورشليم عوضًا عنها!"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "لنخف عن موضع استقرار الرب فينا فلا نحرم من حضرته الدائمة فينا إلى الأبد في"
    },
    {
      "section_title": "1. نصيب أفرايم",
      "content_type": "شرح",
      "father_name": null,
      "text": "داخلنا!"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "وسطهم..."
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "10 فَلَمْ يَطْرُدُوا الْكَنْعَانِيِّينَ السَّاكِنِينَ فِي جَازَرَ. فَسَكَنَ الْكَنْعَانِيُّونَ فِي وَسَطِ أَفْرَايِمَ إِلَى هذَا الْيَوْمِ، وَكَانُوا عَبِيدًا تَحْتَ الْجِزْيَةِ."
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "كما ترك يهوذا اليبوسيين في وسطهم، هكذا"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "ترك أفرايم الكنعانيين يسكنون في"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "وسطهم"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "في جازر، إذ يقول الكتاب: \"فلم يطردوا الكنعانيين الساكنين في جازر، فسكن"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "الكنعانيون في وسط أفرايم إلى هذا اليوم وكانوا عبيدًا تحت الجزية\" [10]."
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "يحذرنا"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "العلامة"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "قول آبائي",
      "father_name": "العلامة أوريجانوس",
      "text": "أوريجانوس"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "هؤلاء الكنعانيون الساكنين مع أفرايم، قائلًا: [إن كنت تحمل بالحق ثمار الرب"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "(كأفرايم) وترى إنسانًا يعيش في إهمال وعدم نظام فاعلم أنه من الكنعانيين. فإن لم"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "تستطيع أن تطرده من الكنيسة، كما لم يطرد بنو أفرايم الكنعانيين، فاتبع مبدأ"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرسول: \"ثم نوصيكم أيها الإخوة باسم ربنا يسوع المسيح أن تتجنبوا كل أخ يسلك"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "بلا ترتيب\" (2 تس 3: 6)]."
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "ويرى"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "العلامة"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "قول آبائي",
      "father_name": "العلامة أوريجانوس",
      "text": "أوريجانوس أن جازر"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "تعني (اتحاد ضيق)، وأن الكنعانيين يمثلون الجسد، وأفرايم يمثل الروح، فإنه متى تركت"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "النفس للجسد أن يطلق شهواته الشريرة تكون قد اتحدت في جازر، أي خلال (اتحاد ضيق)"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "يجعلنا كعبيد تحت الجزية."
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "لهذا ليت نفوسنا في اتحادنا بالجسد لا تدخل معه في جازر،"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "أي في اتحاد ضيق، إنما تقبله مقدسًا في الرب، ليعيش الإنسان بكليته حرًا جسديًا"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "وروحيًا، لا يتمرر من الشهوات الجسدية ولا أخطاء الروح."
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "على أي الأحوال، إن كان نصيب أفرايم"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "يعتبر أغنى المناطق خصوبة وأروعها جمالًا لكنها كانت تحمل خطرًا إذ وُجد فيها"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "الكنعانيون، وهكذا مع غنى العطية توجد مقاومة!"
    },
    {
      "section_title": "2. بقاء الكنعانيين في",
      "content_type": "شرح",
      "father_name": null,
      "text": "← تفاسير أصحاحات"
