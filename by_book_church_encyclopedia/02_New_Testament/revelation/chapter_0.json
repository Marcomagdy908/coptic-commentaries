    {
      "section_title": "أولًا: كاتبها",
      "content_type": "شرح",
      "father_name": null,
      "text": "بشَّر في كنائس آسيا الصغرى التي أُرسِلَت إليها الرسائل السبع في السِفْر."
    },
    {
      "section_title": "أولًا: كاتبها",
      "content_type": "شرح",
      "father_name": null,
      "text": "بشَّر في كنائس آسيا الصغرى التي أُرسِلَت إليها الرسائل السبع في السِفْر."
    },
    {
      "section_title": "أولًا: كاتبها",
      "content_type": "شرح",
      "father_name": null,
      "text": "نفاه الإمبراطور دوميتيان إلى جزيرة بطمس."
    },
    {
      "section_title": "أولًا: كاتبها",
      "content_type": "شرح",
      "father_name": null,
