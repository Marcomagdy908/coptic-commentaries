      "text": "الجَديد"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "تضم الأصحاحات (48-49) أحاديث عن الخلاص"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "مثل الأمر بالرجوع إلى الوطن، الصلاة كمصدر القوة في الخلاص، بهجة الخلاص."
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "تقديم كلمة عتاب لشعبه الذي اتسم بالرياء مع قساوة القلب والانحراف إلى الوثنية،"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "كشف لهم الله عن مقاصده بتسليمهم للسبي البابلي، وأخيرًا يعلن عن إصدار الأمر"
    },
    {
      "section_title": null,
      "content_type": "شرح",
      "father_name": null,
      "text": "المفرح بالخروج السريع المصحوب بالفداء."
    },
    {
      "section_title": "1. الله يعاتب شعبه",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "1 «اِسْمَعُوا هذَا يَا بَيْتَ يَعْقُوبَ، الْمَدْعُوِّينَ بِاسْمِ إِسْرَائِيلَ، الَّذِينَ خَرَجُوا مِنْ مِيَاهِ يَهُوذَا، الْحَالِفِينَ بِاسْمِ الرَّبِّ، وَالَّذِينَ يَذْكُرُونَ إِلهَ إِسْرَائِيلَ، لَيْسَ بِالصِّدْقِ وَلاَ بِالْحَقِّ! 2 فَإِنَّهُمْ يُسَمَّوْنَ مِنْ مَدِينَةِ الْقُدْسِ وَيُسْنَدُونَ إِلَى إِلهِ إِسْرَائِيلَ. رَبُّ الْجُنُودِ اسْمُهُ. 3 بِالأَوَّلِيَّاتِ مُنْذُ زَمَانٍ أَخْبَرْتُ، وَمِنْ فَمِي خَرَجَتْ وَأَنْبَأْتُ بِهَا. بَغْتَةً صَنَعْتُهَا فَأَتَتْ. 4 لِمَعْرِفَتِي أَنَّكَ قَاسٍ، وَعَضَلٌ مِنْ حَدِيدٍ عُنُقُكَ، وَجَبْهَتُكَ نُحَاسٌ، 5 أَخْبَرْتُكَ مُنْذُ زَمَانٍ. قَبْلَمَا أَتَتْ أَنْبَأْتُكَ، لِئَلاَّ تَقُولَ: صَنَمِي قَدْ صَنَعَهَا، وَمَنْحُوتِي وَمَسْبُوكِي أَمَرَ بِهَا. 6 قَدْ سَمِعْتَ فَانْظُرْ كُلَّهَا. وَأَنْتُمْ أَلاَ تُخْبِرُونَ؟ قَدْ أَنْبَأْتُكَ بِحَدِيثَاتٍ مُنْذُ الآنَ، وَبِمَخْفِيَّاتٍ لَمْ تَعْرِفْهَا. 7 الآنَ خُلِقَتْ وَلَيْسَ مُنْذُ زَمَانٍ، وَقَبْلَ الْيَوْمِ لَمْ تَسْمَعْ بِهَا، لِئَلاَّ تَقُولَ: هأَنَذَا قَدْ عَرَفْتُهَا. 8 لَمْ تَسْمَعْ وَلَمْ تَعْرِفْ، وَمُنْذُ زَمَانٍ لَمْ تَنْفَتِحْ أُذُنُكَ، فَإِنِّي عَلِمْتُ أَنَّكَ تَغْدُرُ غَدْرًا، وَمِنَ الْبَطْنِ سُمِّيتَ عَاصِيًا."
    },
    {
      "section_title": "1. الله يعاتب شعبه",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأصحاح السابق فضح الله بابل العذراء سيدة الممالك التي انجرفت إلى حياة اللهو مع التشامخ والعنف فانهارت تمامًا، الآن قبل أن يعلن عن خروج شعبه أو تحريره من السبي"
    },
    {
      "section_title": "1. الله يعاتب شعبه",
      "content_type": "شرح",
      "father_name": null,
      "text": "في عتاب أبوي، صريح يكشف عن ضعفاتهم وخطاياهم وأيضًا عن مقاصده من السماح بسبيهم"
    },
    {
      "section_title": "1. الله يعاتب شعبه",
      "content_type": "شرح",
      "father_name": null,
      "text": "حتى لا يعودوا إلى خطاياهم مرة أخرى."
    },
    {
      "section_title": "1. الله يعاتب شعبه",
      "content_type": "شرح",
      "father_name": null,
      "text": "أخطر خطية تواجه المؤمنين أصحاب المعرفة الروحية هو الرياء مع الشكلية في العبادة."
    },
    {
      "section_title": "1. الله يعاتب شعبه",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله لا يريد إذلالهم إنما رفعهم إلى مركز ساٍم وأعطاهم إمكانيات روحية للحياة"
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "دعاهم \"إسرائيل\" [1]، بكونهم شعبه المختار."
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "شعب ملوكي \"خرجوا من بيت يهوذا\" [1]."
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "دُعِيَ عليهم اسم الله: \"الحالفين باسم الرب والذين يذكرون إله إسرائيل\"،"
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "لكنهم يصنعون هذا \"ليس بالصدق ولا بالحق\" [1] مع إدراكهم"
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "أنه هو الله الواحد الحقيقي الذي يتعبدون له لكن في شكلية وبحرفية دون روح."
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "تمتعوا بمدينة القدس [2]"
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "كمدينة الله المقدسة التي تضم هيكله."
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"يُسْنَدون إلى إله إسرائيل\" [2]، يفتخرون بمواعيده"
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "ويعترفون بعهده ويتكئون عليه (مي 3: 11).."
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "تمتعوا بالنبوات الإلهية، إذ كان الله يخبرهم بالآتيات، أي بالأمور المقبلة [3]."
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "أما سرّ تقديم هذه النبوات فهو تثبيتهم في الإيمان به وتصديق كلماته ومواعيده. لقد"
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "عرف أنهم قساة القلوب، عنقهم من حديد وجباههم من نحاس، يصعب عليهم تصديق الكلمات"
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "النبوية لذا قدم لهم نبوات تتحقق في المستقبل القريب حتى يصدقوا النبوات، وأيضًا"
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "للتمييز بين الله والأوثان [5]."
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "كل ما قدمه الله لشعبه من هذه الإمكانيات عاشوا في شكلية العبادة بروح فريسية"
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "مملوءة رياء، كما خلطوا بين عبادة الله والأوثان، وتجاهلوا الكلمات النبوية"
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "واحتقروها ولم يفهموا أسرارها، لذا يوبخهم قائلًا: \"لم تسمع ولم تعرف ومنذ"
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "زمان لم تنفتح أذنك، فإني علمت أنك تغدر غدرًا ومن البطن سميت عاصيًا\" [8]."
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "انشغل إشعياء النبي بالحديث عن البصيرة الروحية والأذن الداخلية المقدسة، فإن"
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "حديثه عن المخلص يبدو لكثيرين في عصره أو للغالبية أمرًا يكاد يكون مستحيلًا."
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "جاء المخلص ومع ذلك يرفضه كثيرون بالرغم من تحقيق النبوات التي وردت في العهد"
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "القديم في شخصه وخلال أعماله الخلاصية، لذا فالعالم لا زال يحتاج إلى البصيرة الحقة"
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "والأذن المقدسة. حتى الذين آمنوا به وقبلوه يحتاجون إلى ذلك للتمتع بأسرار أعمق"
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "وإدراك الأمجد السماوية الداخلية الخفية."
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "نحتاج"
    },
    {
      "section_title": "معه، أهمها",
      "content_type": "شرح",
      "father_name": null,
      "text": "جميعًا أن يرافقنا رب المجد ويتحدث معنا ليُقدس أعماقنا فنقول مع"
    },
    {
      "section_title": "تلميذيّ عمواس",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"ألم يكن قلبنا ملتهبًا فينا إذ كان يكلمنا في الطريق ويوضح لنا"
    },
    {
      "section_title": "تلميذيّ عمواس",
      "content_type": "شرح",
      "father_name": null,
      "text": "الكتب؟!\" (لو 24: 32)."
    },
    {
      "section_title": "تلميذيّ عمواس",
      "content_type": "شرح",
      "father_name": null,
      "text": "النور، الذي أنار عقل يعقوب، فكسف لأولاده عن الأمور المختلفة."
    },
    {
      "section_title": "تلميذيّ عمواس",
      "content_type": "قول آبائي",
      "father_name": "القديس أغسطينوس",
      "text": "القديس أغسطينوس"
    },
    {
      "section_title": "2. قصد الله من السبي",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "9 مِنْ أَجْلِ اسْمِي أُبَطِّئُ غَضَبِي، وَمِنْ أَجْلِ فَخْرِي أُمْسِكُ عَنْكَ حَتَّى لاَ أَقْطَعَكَ. 10 هأَنَذَا قَدْ نَقَّيْتُكَ وَلَيْسَ بِفِضَّةٍ. اخْتَرْتُكَ فِي كُورِ الْمَشَقَّةِ. 11 مِنْ أَجْلِ نَفْسِي، مِنْ أَجْلِ نَفْسِي أَفْعَلُ. لأَنَّهُ كَيْفَ يُدَنَّسُ اسْمِي؟ وَكَرَامَتِي لاَ أُعْطِيهَا لآخَرَ. 12 «اِسْمَعْ لِي يَا يَعْقُوبُ، وَإِسْرَائِيلُ الَّذِي دَعَوْتُهُ: أَنَا هُوَ. أَنَا الأَوَّلُ وَأَنَا الآخِرُ، 13 وَيَدِي أَسَّسَتِ الأَرْضَ، وَيَمِينِي نَشَرَتِ السَّمَاوَاتِ. أَنَا أَدْعُوهُنَّ فَيَقِفْنَ مَعًا. 14 اِجْتَمِعُوا كُلُّكُمْ وَاسْمَعُوا. مَنْ مِنْهُمْ أَخْبَرَ بِهذِهِ؟ قَدْ أَحَبَّهُ الرَّبُّ. يَصْنَعُ مَسَرَّتَهُ بِبَابِلَ، وَيَكُونُ ذِرَاعُهُ عَلَى الْكَلْدَانِيِّينَ. 15 أَنَا أَنَا تَكَلَّمْتُ وَدَعَوْتُهُ. أَتَيْتُ بِهِ فَيَنْجَحُ طَرِيقُهُ. 16 تَقَدَّمُوا إِلَيَّ. اسْمَعُوا هذَا: لَمْ أَتَكَلَّمْ مِنَ الْبَدْءِ فِي الْخَفَاءِ. مُنْذُ وُجُودِهِ أَنَا هُنَاكَ» وَالآنَ السَّيِّدُ الرَّبُّ أَرْسَلَنِي وَرُوحُهُ. 17 هكَذَا يَقُولُ الرَّبُّ فَادِيكَ قُدُّوسُ إِسْرَائِيلَ: «أَنَا الرَّبُّ إِلهُكَ مُعَلِّمُكَ لِتَنْتَفِعَ، وَأُمَشِّيكَ فِي طَرِيق تَسْلُكُ فِيهِ. 18 لَيْتَكَ أَصْغَيْتَ لِوَصَايَايَ، فَكَانَ كَنَهْرٍ سَلاَمُكَ وَبِرُّكَ كَلُجَجِ الْبَحْرِ. 19 وَكَانَ كَالرَّمْلِ نَسْلُكَ، وَذُرِّيَّةُ أَحْشَائِكَ كَأَحْشَائِهِ. لاَ يَنْقَطِعُ وَلاَ يُبَادُ اسْمُهُ مِنْ أَمَامِي."
    },
    {
      "section_title": "2. قصد الله من السبي",
      "content_type": "شرح",
      "father_name": null,
      "text": "يقدم"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"من أجل اسمي أُبطئ غضبي، ومن أجل فخري أمسك عنك حتى لا أقطعك\" [9]..."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "بمعنى آخر كان يلزم أن يهلك هذا الشعب تمامًا ويُقطع، لكن الله في غيرته على اسمه"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "ومجده قدمهم للتأديب لعلهم يرجعون إليه فلا يهلكون. وكأن السبي هو"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"عطية\" بكونه تأديب إلهي يقدم للمحبوبين بالرغم من عدم استحقاقهم لهذا"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الحب الأبوي التأديبي."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "نظرة روحية رائعة نحو التأديب، خلالها يدرك المؤمن أنه ليس أهلًا لهذا التأديب"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "بكونه علامة حب أبوي. يقول الرسول: \"لأن الذي يحبه الرب يؤدبه ويجلد كل ابن"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "يقبله؛ إن كنتم تحتملون التأديب يعاملكم الله كالبنين\" (عب 12: 6-7)."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "كان عدم التأديب علامة خاصة بالنغول (عب 12: 8)، إذن يليق بنا أن نفرح بالتأديب"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "كعلامة على شرعية بنوتنا!"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "قول آبائي",
      "father_name": "القديس يوحنا ذهبي الفم",
      "text": "القديس يوحنا الذهبي الفم"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأب لا يهذب"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "ابنه لو لم يحبه، والمعلم لا يصلح من شأن تلميذه ما لم ير فيه علامات نوال الوعد."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "عندما يرفع الطبيب عنايته عن مريض، يكون هذا علامة يأسه من شفائه."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "قول آبائي",
      "father_name": "القديس جيروم",
      "text": "القديس جيروم"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"افتقد"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "بعصا معصيتهم، وبضربات إثمهم\" (مز 89: 32)."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "إنها"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "رحمة (الله) ليس فقط أن يدعوهم وإنما أيضًا أن يؤدبهم ويجلدهم. لتكن يّد أبيك"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "عليك، فإن كنت ابنًا صالحًا لا تتذمر على التأديب... ليؤدبه ما دام لم ينزع رحمته"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "عنه؛ ليضربه عندما يخطئ ما دام لا يمنعه من أن يرث."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "كنت تدرك مواعيد أبيك حسنًا لا تخف من جلداته بل خف لئلا لا ترثه..."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأبناء الأتقياء لا يقولون: \"إن كنت تأتينا بعصا فلا تأتِ قط. فانه من"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الأفضل أن تتعلم بعصا الآب عن أن تهلك باهتمام اللص بك."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الرب"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الحافظ الصغار (مز 116: 6) يجلد هؤلاء الذين عندما يصيرون ناضجين، يطلب أن يكونوا"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "ورثة (له)..."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "أعانني إذ كنت في ضيق، فان الألم الذي يسببه الطبيب بمشرطه ليس للعقوبة بل للتكريم."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "قول آبائي",
      "father_name": "القديس أغسطينوس",
      "text": "القديس أغسطينوس"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "للتنقية: \"هانذا نَقيَّتك وليس بفضة، اخترتك في كور المشقة\" [10]."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "نحن فضة الرب وذهبه، يهتم بتنقيتنا في كور التعب والألم."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "مغبوط"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "هو الإنسان الذي يؤدب في هذه الحياة مرتين، فإن الرب لا يُعاقب عن شيء مرتين (نا 1: 9) LXX."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "قول آبائي",
      "father_name": "القديس جيروم",
      "text": "القديس جيروم"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله الذي يسمح بالتأديب لتنقيتنا هو يرفعه عنا عندما يحقق هدفه. لقد دعا السموات"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "والأرض، لتجتمع كل الخليقة وترى خلاص الله العجيب. لقد أحب كورش ليُحقق هدفه ويكون"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "ذراعه على الكلدانيين [14]."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "يحققه كورش ليس من عندياته بل من قبل الله مخلص شعبه: \"أنا أنا تكلمت"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "ودعوته، أتيت به فينجح طريقه\" [15]... منذ وجوده أنا هناك،"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "والآن السيد الرب أرسلني وروحه\" [6]."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "أُرسل"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "كورش بواسطة الرب وبروح الله القدوس، كرمز للسيد المسيح الذي جاء بإرادته وفي نفس"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الوقت مرسلًا من الآب والروح القدس... كيف؟"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "وحدة عمل الثالوث القدوس؛ الثالوث القدوس كأقانيم غير منفصلة جوهر إلهي واحد يعمل"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "لخلاص البشرية."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الآب"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "يحب البشرية، وفي حبه أرسل كلمته غير المنفصل عنه، حاسبًا ذبيحة المسيح عطاء من جانب"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الآب، وكما قال السيد المسيح نفسه: \"هكذا أحب الله العالم حتى بذل ابنه"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الوحيد لكي لا يهلك كل من يؤمن به بل تكون له الحياة الأبدية\" (يو 3: 16)."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الآب محب البشر"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "أرسل ابنه ذبيحة حب."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الابن"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "من جانبه قدم نفسه للبذل في طاعة للآب، وأيضًا بكامل إرادته، إذ يقول الرسول:"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "\"الذي أحبني وأسلم نفسه لأجلي\" (غل 2: 20)."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الروح القدس فلم يقف في دور سلبي بل كان له دوره الايجابي في كل العمل الخلاصي؛ به"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "تحقق التجسد الإلهي في أحشاء البتول (لو 1: 35)، وهو الذي أصعد يسوع ليُجرب، وهو"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الذي يشهد للسيد المسيح (يو 15: 26)."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "لممارسة الطاعة لله، فان السبي لم يحدث مصادفة ولا قضاءً وقدرًا إنما هو ثمرة"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "طبيعية للعصيان، بدونه ما سقطوا تحت السبي. لهذا وجب عليهم عند عودتهم أن يمارسوا"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "الطاعة فيتمتعوا ببّر الله وخيراته. \"ليتك أصغيت لوصاياي فكان كنهر سلامك"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "وبرك كلجج البحر. وكان كالرمل نسلك وذرية أحشائك كأحشائه، لا ينقطع ولا يُباد اسمه"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "من أمامي\" [18-19]."
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "أنهم أطاعوا الله ليس فقط لم يسقطوا تحت"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "السبي البابلي، وإنما لأفاض سلام الله"
    },
    {
      "section_title": "الله لشعبه أسباب السماح بسبيهم",
      "content_type": "شرح",
      "father_name": null,
      "text": "كنهر متسع وعميق ودائم الجريان ومُروي للكثيرين."
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "نص كتابي",
      "father_name": null,
      "text": "20 «اُخْرُجُوا مِنْ بَابِلَ، اهْرُبُوا مِنْ أَرْضِ الْكَلْدَانِيِّينَ. بِصَوْتِ التَّرَنُّمِ أَخْبِرُوا. نَادُوا بِهذَا. شَيِّعُوهُ إِلَى أَقْصَى الأَرْضِ. قُولُوا: قَدْ فَدَى الرَّبُّ عَبْدَهُ يَعْقُوبَ. 21 وَلَمْ يَعْطَشُوا فِي الْقِفَارِ الَّتِي سَيَّرَهُمْ فِيهَا. أَجْرَى لَهُمْ مِنَ الصَّخْرِ مَاءً، وَشَقَّ الصَّخْرَ فَفَاضَتِ الْمِيَاهُ. 22 لاَ سَلاَمَ، قَالَ الرَّبُّ لِلأَشْرَارِ»."
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "يقدم"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "الله دعوة للخروج: \"اخرجوا من بابل، اهربوا من أرض الكلدانيين\" [20]."
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "كان الله قد أرسل كورش لخلاصهم، لكنه لا يلزمهم بالخروج بغير إرادتهم، إنما يدعوهم"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "ويحثّهم على ذلك... وبالفعل خرج 40,000 شخصًا على يدي"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "زربابل (نح 7: 66-67)."
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "إنها"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "دعوة مستمرة لخروجنا تحت قيادة مخلصنا من كل موضع معثر، حتى نتحرر بروح الله من"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "نيرها، كما دُعي لوط وعائلته لِتَرْك سدوم وعمورة."
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "الهروب"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "من الشر ليس ضعفًا ولا سلبية وإنما هو عمل مِقدام فيه يعلن الإنسان بروح الله عن"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "نصرته على أعماقه التي تشتاق أو تستطيب للمواضع المعثرة."
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "الدعوة يصحبها فرح وتهليل بعمل الله الخلاصي: \"بصوت الترنم أخبروا نادوا"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "بهذا\" [20]."
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "يتطلع إشعياء النبي إلى التحرر من السبي كخروج ثانٍ يشبه خروج الشعب من عبودية"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "فرعون على يدي موسى حيث أخرج لهم ماءً من الصخرة في البرية كي لا يعطشوا، هكذا في"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "هذا الخروج الجديد يتمتعون بذات العطية: \"ولم يعطشوا في القفار التي"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "سيَّرهم فيها، أجري لهم من الصخر ماءً، وشق الصخر ففاضت المياه\" [21]."
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "لقد تحقق هذا إذ ارتبط خلاص السيد المسيح بعطية الروح القدس في عيد العنصرة كينبوع"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "مياه حيَّة فاضت في كنيسة المسيح."
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "أخيرًا"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "فإن هذا الخلاص اختياري، من لا يقبله يحرم من سلام الله الفائق، إذ قيل: \"لا"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "سلام قال الرب للأشرار\" [22]."
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "لنا: \"أبطل صوت الطرب وصوت الفرح من أفواههم\" (إر 7: 34). نعم فانه"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "أعياد الأشرار هي ويلات."
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "يعتزل الجاحدون الصلاة والشكر يحرمون أنفسهم من ثمر الفرح."
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "قول آبائي",
      "father_name": "القديس أثناسيوس الرسولي",
      "text": "البابا أثناسيوس الرسولي"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "جاءت"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "الترجمة السبعينية \"لا فرح قال الرب للأشرار\". وقد ميز"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "قول آبائي",
      "father_name": "القديس أغسطينوس",
      "text": "القديس أغسطينوس بين فرح الشرير المؤقت"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "والمرتبط بالزمنيات يزول بزوالها، أما الأبرار فيفرحون حتى في قيودهم، فقد فرحت"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "الشهيدة كريسبينا Crispina عندما"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "قُيدت وعندما أُقتيدت للمحاكمة، كما عندما سُجنت وعندما صدر الحكم ضدها... كان"
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "فرحها أمام الملائكة، كقول المرتل: \"أمام الملائكة أُسبح لك\" (مز 138: 1)."
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "In Hebr. 29:33."
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "On Ps. 89."
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "On Ps. 116."
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "On Ps. Hom. 51."
    },
    {
      "section_title": "3. الخلاص السريع المبهج",
      "content_type": "شرح",
      "father_name": null,
      "text": "Pasch. Ep. 2,3."
