      "section_title": "وَلْيَقُلْ دَائِمًا مُحِبُّو خَلاَصِكَ",
      "content_type": "شرح",
      "father_name": null,
      "text": "حتى أغتني بك،"
    },
    {
      "section_title": "وَلْيَقُلْ دَائِمًا مُحِبُّو خَلاَصِكَ",
      "content_type": "شرح",
      "father_name": null,
      "text": "يا من افتقرت لكي بفقرك تغنيني!"
    },
    {
      "section_title": "وَلْيَقُلْ دَائِمًا مُحِبُّو خَلاَصِكَ",
      "content_type": "شرح",
      "father_name": null,
      "text": "لتسرع"
